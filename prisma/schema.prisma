generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct Postgres URL (not the pooler). Required for migrations when `DATABASE_URL` uses Supabase pooler / PgBouncer.
  directUrl = env("DIRECT_URL")
}

enum RoleKey {
  FACILITY_ADMINISTRATOR
  GM
  MANAGER
  SUPERVISOR
  LEAD_TEAM_MEMBER
  STAFF
}

model Role {
  id          String        @id @default(cuid())
  key         RoleKey       @unique
  name        String
  description String?
  isActive    Boolean       @default(true)
  users       User[]
  templates   LogTemplate[]
  routePermissions RoleRoutePermission[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AppRoute {
  id          String                @id @default(cuid())
  key         String                @unique
  pathPrefix  String                @unique
  label       String
  navVisible  Boolean               @default(true)
  navOrder    Int                   @default(100)
  isActive    Boolean               @default(true)
  isCritical  Boolean               @default(false)
  permissions RoleRoutePermission[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model RoleRoutePermission {
  id         String   @id @default(cuid())
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  appRouteId String
  appRoute   AppRoute @relation(fields: [appRouteId], references: [id], onDelete: Cascade)
  allowed    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roleId, appRouteId])
  @@index([roleId])
  @@index([appRouteId])
}

/// Parent business entity for one or more Facilities. Facility remains the tenancy/ops root.
enum OrganizationType {
  HEALTHCARE_SYSTEM
  MANAGEMENT_COMPANY
  LONG_TERM_CARE
  HOSPITAL
  K12_DISTRICT
  UNIVERSITY
  CORPORATE
  HOSPITALITY
  OTHER
}

model Organization {
  id               String            @id @default(cuid())
  name             String
  legalName        String?
  displayName      String?
  organizationType OrganizationType?
  isActive         Boolean           @default(true)
  facilities       Facility[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([name])
  @@index([isActive])
}

/// One deployment typically has one facility; all operational data is scoped here for future multi-site support.
model Facility {
  id                            String                      @id @default(cuid())
  organizationId                String
  organization                  Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  displayName                   String
  /// Legacy operator label. Organization is the canonical parent; kept for compatibility (do not dual-write).
  managementCompanyName         String?
  billingEmail                  String?
  stripeCustomerId              String?
  stripeDefaultPaymentMethodId  String?
  onboardingCurrentStep         String?
  onboardingStartedAt           DateTime?
  onboardingCompletedAt         DateTime?
  /// Optional org-selected accent color (hex) used for subtle UI delineation.
  brandColor                    String?
  /// IANA timezone for facility-local operational time (meals, service dates, due windows).
  timezone                      String                      @default("America/New_York")
  /// Relative path under app `uploads/` (see `lib/facility-uploads.ts`).
  unionHandbookPdfPath          String?
  unionHandbookOriginalFilename String?
  unionHandbookUploadedAt       DateTime?
  unionHandbookEffectiveDate    DateTime?                   @db.Date
  users                         User[]
  userFacilityAccesses          UserFacilityAccess[]
  units                         Unit[]
  employees                     Employee[]
  logTemplates                  LogTemplate[]
  vendors                       Vendor[]
  employeeHrAuditLogs           EmployeeHrAuditLog[]
  employeeTerminationRecords    EmployeeTerminationRecord[]
  menuSettings                  MenuSettings?
  menuItems                     MenuItem[]
  kioskUnitPinLoginEvents       KioskUnitPinLoginEvent[]
  onboardingManagerInvites      OnboardingManagerInvite[]
  operationDefinitions          OperationDefinition[]
  operationInstances            OperationInstance[]
  departments                   Department[]
  jobTitles                     JobTitle[]
  workShifts                    WorkShift[]
  preventiveMaintenanceSchedules PreventiveMaintenanceSchedule[]
  roomAreaStatuses              RoomAreaStatus[]
  attachments                   Attachment[]
  tasks                         Task[]
  inspectionDefinitions         InspectionDefinition[]
  inspectionSubmissions         InspectionSubmission[]
  inspectionOccurrences         InspectionOccurrence[]
  knowledgeArticles             KnowledgeArticle[]
  aiOperationalBriefs           AiOperationalBrief[]
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt

  @@index([organizationId])
}

/// Facility operational department (Dietary, EVS, Plant, etc.).
model Department {
  id                String    @id @default(cuid())
  facilityId        String
  facility          Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  key               String
  name              String
  sortOrder         Int       @default(100)
  isActive          Boolean   @default(true)
  /// When false, department is hidden from employee HR UI tabs (Admin → Departments).
  showInEmployeeApp Boolean   @default(true)
  headEmployeeId    String?
  headEmployee      Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  usersAsPrimary    User[]    @relation("UserPrimaryDepartment")
  employeesAsPrimary Employee[] @relation("EmployeePrimaryDepartment")
  employeeDepartments EmployeeDepartment[]
  unitResponsibilities UnitDepartmentResponsibility[]
  assets            Asset[]
  logTemplates      LogTemplate[]
  workShifts        WorkShift[]
  preventiveMaintenanceSchedules PreventiveMaintenanceSchedule[]
  repairsRequesting Repair[]  @relation("RepairRequestingDepartment")
  repairsResponsible Repair[] @relation("RepairResponsibleDepartment")
  tasks             Task[]
  inspectionDefinitions InspectionDefinition[]
  inspectionOccurrences InspectionOccurrence[]
  knowledgeArticles   KnowledgeArticle[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([facilityId, key])
  @@index([facilityId])
  @@index([facilityId, showInEmployeeApp])
  @@index([headEmployeeId])
}

/// Facility-scoped job title catalog for HR / employee directory.
model JobTitle {
  id         String     @id @default(cuid())
  facilityId String
  facility   Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int        @default(100)
  isActive   Boolean    @default(true)
  employees  Employee[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([facilityId, name])
  @@index([facilityId])
}

/// Many-to-many: employee membership in operational departments (with role in that dept).
model EmployeeDepartment {
  id           String     @id @default(cuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roleType     RoleKey    @default(STAFF)
  createdAt    DateTime   @default(now())

  @@unique([employeeId, departmentId])
  @@index([employeeId])
  @@index([departmentId])
}

model OnboardingManagerInvite {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  email       String
  createdAt   DateTime @default(now())
  acceptedAt  DateTime?

  @@unique([facilityId, email])
  @@index([facilityId, createdAt])
}

/// Recurring operation template scoped to a facility department (e.g. dietary breakfast service).
model OperationDefinition {
  id                  String              @id @default(cuid())
  facilityId          String
  facility            Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// Department scope (`Department.id` when the departments model is present).
  departmentId        String
  /// Stable slug unique per department (e.g. `breakfast`, `evs-day-round-1`).
  key                 String
  /// Display label (e.g. "Breakfast").
  label               String
  /// Dietary meal period when applicable; null for non-meal operations (EVS rounds, plant PM).
  mealType            MealType?
  /// Optional named shift template id (`WorkShift.id` when shift model is present).
  workShiftId         String?
  /// Local start time hint (`HH:mm`) for sync/scheduling; not authoritative until wired.
  scheduledStartLocal String?
  scheduledEndLocal   String?
  sortOrder           Int                 @default(100)
  isActive            Boolean             @default(true)
  instances           OperationInstance[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([facilityId, departmentId, key])
  @@index([facilityId])
  @@index([departmentId])
  @@index([workShiftId])
}

/// A single dated occurrence of an operation (e.g. "Breakfast 2026-07-08").
model OperationInstance {
  id                  String                  @id @default(cuid())
  facilityId          String
  facility            Facility                @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId        String
  definitionId        String
  definition          OperationDefinition     @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  /// Service date for this occurrence (facility-local calendar day).
  serviceDate         DateTime                @db.Date
  /// Denormalized for query filters without joining the definition.
  mealType            MealType?
  /// Snapshot label copied from definition at instance creation.
  label               String
  status              OperationInstanceStatus @default(SCHEDULED)
  workShiftId         String?
  scheduledStartLocal String?
  scheduledEndLocal   String?
  startedAt           DateTime?
  completedAt         DateTime?
  serveryMealServiceEvents ServeryMealServiceEvent[]
  tasks               Task[]
  inspectionSubmissions InspectionSubmission[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([definitionId, serviceDate])
  @@index([facilityId, serviceDate])
  @@index([departmentId, serviceDate])
  @@index([facilityId, departmentId, serviceDate])
  @@index([status])
  @@index([workShiftId])
}

model MenuSettings {
  id               String           @id @default(cuid())
  facilityId       String           @unique
  facility         Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  cycleLengthWeeks Int              @default(3)
  weekStartsOn     MenuWeekStartDay @default(SUNDAY)
  cycleAnchorDate  DateTime         @db.Date
  periodConfigJson Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model MenuItem {
  id           String   @id @default(cuid())
  facilityId   String
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  weekNumber   Int
  dayIndex     Int
  mealPeriodKey String
  category     String
  itemName     String
  portionValue String?
  portionUnit  String?
  entryType    MenuItemEntryType @default(FIXED)
  displayOrder Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([facilityId, weekNumber, dayIndex, mealPeriodKey])
  @@index([facilityId, weekNumber, dayIndex, mealPeriodKey, category])
}

model User {
  id                        String                      @id @default(cuid())
  email                     String                      @unique
  displayName               String
  passwordHash              String
  /// All app users belong to one facility in this deployment; session JWT carries facilityId for query scope.
  facilityId                String
  facility                  Facility                    @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  roleId                    String
  role                      Role                        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive                  Boolean                     @default(true)
  lastLoginAt               DateTime?
  /// Optional primary operational department for session/nav scoping.
  primaryDepartmentId       String?
  primaryDepartment         Department?                 @relation("UserPrimaryDepartment", fields: [primaryDepartmentId], references: [id], onDelete: SetNull)
  submissions               LogSubmission[]
  createdSchedules          ScheduleEntry[]             @relation("ScheduleCreatedBy")
  changedOverrides          AssignmentOverride[]        @relation("OverrideChangedBy")
  reportedRepairs           Repair[]                    @relation("RepairReportedBy")
  repairUpdates             RepairUpdate[]
  disciplinePointsCreated   DisciplinePointEntry[]      @relation("DisciplinePointCreatedBy")
  employeeHrAuditLogs       EmployeeHrAuditLog[]
  terminationRecordsCreated EmployeeTerminationRecord[] @relation("TerminationCreatedBy")
  serveryMealReadyEvents    ServeryMealServiceEvent[]   @relation("ServeryReadyRecordedBy")
  serveryMealStartedEvents  ServeryMealServiceEvent[]   @relation("ServeryStartedRecordedBy")
  attachmentsCreated        Attachment[]                @relation("AttachmentCreatedByUser")
  knowledgeArticlesCreated  KnowledgeArticle[]          @relation("KnowledgeArticleCreatedBy")
  knowledgeArticlesUpdated  KnowledgeArticle[]          @relation("KnowledgeArticleUpdatedBy")
  facilityAccesses          UserFacilityAccess[]        @relation("UserFacilityAccessUser")
  facilityAccessesGranted   UserFacilityAccess[]        @relation("UserFacilityAccessGrantedBy")
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@index([facilityId])
  @@index([primaryDepartmentId])
}

/// Explicit multi-facility access grant. Shared Organization alone never authorizes a facility.
/// Role remains on User for Wave 11 M2 (per-facility role deferred).
model UserFacilityAccess {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("UserFacilityAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  facilityId      String
  facility        Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  isActive        Boolean   @default(true)
  grantedByUserId String?
  grantedByUser   User?     @relation("UserFacilityAccessGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, facilityId])
  @@index([userId, isActive])
  @@index([facilityId, isActive])
  @@index([grantedByUserId])
}

enum UnitType {
  SERVERY
  KITCHEN
  RETAIL
  OFFICE
  STORAGE
  OTHER
  RESIDENT_AREA
  COMMON_AREA
  MECHANICAL
  RESTROOM_CLUSTER
  EVS_ZONE
  GROUND
}

enum UnitDepartmentKind {
  PRIMARY
  BACKUP
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

/// Lifecycle state for a date-bound operation occurrence (Wave 5 Operations Engine).
enum OperationInstanceStatus {
  SCHEDULED
  PREPARATION
  EXECUTION
  COMPLETED
  CANCELLED
}

enum MenuWeekStartDay {
  SUNDAY
  MONDAY
}

enum MenuItemEntryType {
  FIXED
  CHOICE_PLACEHOLDER
}

enum LogRecurrence {
  DAILY
  PER_MEAL
  WEEKLY
  CUSTOM
}

enum LogFieldType {
  YES_NO
  NUMBER
  TEMPERATURE
  DROPDOWN
  SHORT_TEXT
  LONG_TEXT
  PASS_FAIL
}

enum LogSubmissionStatus {
  COMPLETED
  FAILED
  MISSED
}

enum EmployeeStatus {
  ACTIVE
  OFF
  TERMINATED
}

/// Voluntary vs involuntary separation (recorded on separation log rows).
enum SeparationKind {
  RESIGNED
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  PER_DIEM
}

/// HR / union contract classification (not the same as app RoleKey).
enum JobClassification {
  COOK
  FOOD_SERVICE_WORKER
  DIET_CLERK
  DIETITIAN
  OTHER
}

/// Stations the employee is trained for (kitchen ops).
enum WorkStation {
  COOK
  SERVER
  DISHWASHER
  RETAIL
  DIET
  OFFICE
  PORTER
  UTILITY
}

enum ChrcStatus {
  NOT_STARTED
  PENDING
  CLEARED
  NOT_APPLICABLE
}

enum DisciplinePointCategory {
  ATTENDANCE
  PERFORMANCE
}

enum ShiftType {
  BREAKFAST
  LUNCH
  DINNER
  FULL_DAY
}

enum AssetStatus {
  ACTIVE
  OUT_OF_SERVICE
  RETIRED
}

/// Operational criticality for Plant readiness. Defaults to ROUTINE for backward compatibility.
enum AssetCriticality {
  CRITICAL
  IMPORTANT
  ROUTINE
}

enum RepairPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RepairStatus {
  OPEN
  IN_PROGRESS
  WAITING_PARTS
  CLOSED
}

enum WorkOrderKind {
  CORRECTIVE
  PREVENTIVE
}

enum RepairTrade {
  EQUIPMENT
  PLUMBING
  ELECTRICAL
  GENERAL
}

/// Broader operational issue classification on Repair (ADL-008). Default EQUIPMENT preserves legacy rows.
enum IssueType {
  EQUIPMENT
  SUPPLY_SHORT
  ENVIRONMENT
  SAFETY
  SERVICE_DISRUPTION
  OTHER
}

enum PreventiveMaintenanceCadence {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RoomAreaOperationalStatus {
  CLEAN
  DIRTY
  OCCUPIED
  DISCHARGE
  ISOLATION
  TERMINAL_CLEAN_PENDING
}

enum TaskType {
  LOG
  REPAIR
  INSPECTION
  COVERAGE
  AD_HOC
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskSourceType {
  LOG_SUBMISSION
  REPAIR
  INSPECTION_SUBMISSION
  INSPECTION_FINDING
  INSPECTION_OCCURRENCE
}

enum InspectionResponseType {
  PASS_FAIL
  YES_NO
  TEXT
  NUMBER
  TEMPERATURE
}

enum InspectionResult {
  PASSED
  PASSED_WITH_FINDINGS
  FAILED
}

/// Structured recurrence for InspectionDefinition (Wave 7c). ON_DEMAND is never auto-generated.
enum InspectionCadenceType {
  DAILY
  WEEKLY
  MONTHLY
  ON_DEMAND
}

enum InspectionOccurrenceStatus {
  OPEN
  COMPLETED
  CANCELLED
  SKIPPED
}

enum AttachmentParentKind {
  LOG_SUBMISSION
  REPAIR
}

model Unit {
  id                       String                    @id @default(cuid())
  facilityId               String
  facility                 Facility                  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  name                     String
  unitType                 UnitType
  parentUnitId             String?
  parentUnit               Unit?                     @relation("UnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull)
  childUnits               Unit[]                    @relation("UnitHierarchy")
  isActive                 Boolean                   @default(true)
  displayOrder             Int                       @default(100)
  description              String?
  primaryForEmployees      Employee[]                @relation("EmployeePrimaryUnit")
  employeeUnitAccess       EmployeeUnitAccess[]
  mealTimes                UnitMealTime[]
  departmentResponsibilities UnitDepartmentResponsibility[]
  logAssignments           LogAssignment[]
  logSubmissions           LogSubmission[]
  defaultAssignments       DefaultAssignment[]
  scheduleEntries          ScheduleEntry[]
  overrideOldUnit          AssignmentOverride[]      @relation("OverrideOldUnit")
  overrideNewUnit          AssignmentOverride[]      @relation("OverrideNewUnit")
  assets                   Asset[]
  repairs                  Repair[]
  roomAreaStatuses         RoomAreaStatus[]
  serveryMealServiceEvents ServeryMealServiceEvent[]
  kioskUnitPinLoginEvents  KioskUnitPinLoginEvent[]
  tasks                    Task[]
  inspectionDefinitions    InspectionDefinition[]
  inspectionSubmissions    InspectionSubmission[]
  inspectionOccurrences    InspectionOccurrence[]
  knowledgeArticleUnits    KnowledgeArticleUnit[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([facilityId, name])
  @@index([parentUnitId])
  @@index([isActive, displayOrder])
  @@index([facilityId])
}

/// Which department(s) are responsible for a unit (primary/backup).
model UnitDepartmentResponsibility {
  id                 String             @id @default(cuid())
  unitId             String
  unit               Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  kind               UnitDepartmentKind @default(PRIMARY)
  riskLevel          String?
  cleaningFrequency  String?
  inspectionFrequency String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([unitId, departmentId])
  @@index([unitId])
  @@index([departmentId])
}

model ServeryMealServiceEvent {
  id                   String             @id @default(cuid())
  unitId               String
  unit                 Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  serviceDate          DateTime           @db.Date
  mealType             MealType
  mealServiceReadyAt   DateTime?
  mealServiceStartedAt DateTime?
  readyRecordedById    String?
  readyRecordedBy      User?              @relation("ServeryReadyRecordedBy", fields: [readyRecordedById], references: [id], onDelete: SetNull)
  startedRecordedById  String?
  startedRecordedBy    User?              @relation("ServeryStartedRecordedBy", fields: [startedRecordedById], references: [id], onDelete: SetNull)
  /// Optional link to the dated operation occurrence when the operations engine is enabled.
  operationInstanceId  String?
  operationInstance    OperationInstance? @relation(fields: [operationInstanceId], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([unitId, serviceDate, mealType])
  @@index([serviceDate])
  @@index([operationInstanceId])
}

model UnitMealTime {
  id            String   @id @default(cuid())
  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  mealType      MealType
  scheduledTime String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([unitId, mealType])
  @@index([unitId, isActive])
}

model Employee {
  id                         String                      @id @default(cuid())
  facilityId                 String
  facility                   Facility                    @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  firstName                  String
  lastName                   String
  phone                      String?
  email                      String?
  /// HMAC digest for 6-digit PIN lookup; unique per facility when set (see `lib/pin.ts`).
  pinDigest                  String?
  /// Default unit focus for PIN sessions (must be allowed, or any unit when access list is empty).
  primaryUnitId              String?
  primaryUnit                Unit?                       @relation("EmployeePrimaryUnit", fields: [primaryUnitId], references: [id], onDelete: SetNull)
  /// Optional primary operational department for PIN session / HR scoping.
  primaryDepartmentId        String?
  primaryDepartment          Department?                 @relation("EmployeePrimaryDepartment", fields: [primaryDepartmentId], references: [id], onDelete: SetNull)
  jobTitleId                 String?
  jobTitle                   JobTitle?                   @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  headedDepartments          Department[]                @relation("DepartmentHead")
  employeeDepartments        EmployeeDepartment[]
  unitAccesses               EmployeeUnitAccess[]
  roleType                   RoleKey
  status                     EmployeeStatus              @default(ACTIVE)
  employmentType             EmploymentType              @default(FULL_TIME)
  defaultAssignments         DefaultAssignment[]
  scheduleEntries            ScheduleEntry[]
  assignmentOverrides        AssignmentOverride[]
  logSubmissions             LogSubmission[]             @relation("SubmissionByEmployee")
  /// HR (see memory-bank/employee-hr-source-of-truth.md)
  unionMember                Boolean                     @default(false)
  hireDate                   DateTime?                   @db.Date
  birthMonth                 Int?
  birthDay                   Int?
  jobClassification          JobClassification?
  chrcStatus                 ChrcStatus?
  chrcClearedAt              DateTime?
  chrcNotes                  String?
  onLeave                    Boolean                     @default(false)
  shirtSize                  String?
  hrNotes                    String?
  workStations               EmployeeWorkStation[]
  disciplinePointEntries     DisciplinePointEntry[]
  /// Last day / effective termination date when `status` is TERMINATED (HR).
  terminationDate            DateTime?                   @db.Date
  /// When the facility completed removing the person from the CHRC process (checklist).
  chrcOffboardingCompletedAt DateTime?
  chrcOffboardingNotes       String?
  hrAuditLogs                EmployeeHrAuditLog[]
  terminationRecords         EmployeeTerminationRecord[]
  kioskUnitPinLoginEvents    KioskUnitPinLoginEvent[]
  assignedRepairs            Repair[]                    @relation("RepairAssignedEmployee")
  roomAreaStatusUpdates      RoomAreaStatus[]
  assignedTasks              Task[]                      @relation("TaskAssignedEmployee")
  attachmentsCreated         Attachment[]                @relation("AttachmentCreatedByEmployee")
  inspectionSubmissions      InspectionSubmission[]      @relation("InspectionSubmittedByEmployee")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@unique([facilityId, pinDigest])
  @@index([status, roleType])
  @@index([facilityId])
  @@index([primaryUnitId])
  @@index([primaryDepartmentId])
  @@index([jobTitleId])
  @@index([facilityId, unionMember])
  @@index([birthMonth, birthDay])
}

model EmployeeWorkStation {
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  station    WorkStation
  createdAt  DateTime    @default(now())

  @@id([employeeId, station])
  @@index([employeeId])
}

model DisciplinePointEntry {
  id          String                  @id @default(cuid())
  employeeId  String
  employee    Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category    DisciplinePointCategory
  points      Int
  occurredAt  DateTime                @db.Date
  note        String?
  createdById String?
  createdBy   User?                   @relation("DisciplinePointCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([employeeId, occurredAt])
  @@index([employeeId, category])
}

/// Field-level HR change log (profile saves, PIN lifecycle). Values are string snapshots.
model EmployeeHrAuditLog {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fieldKey   String
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([facilityId, createdAt])
  @@index([employeeId, createdAt])
}

/// Immutable snapshot when an employee transitions to TERMINATED (re-termination creates another row).
model EmployeeTerminationRecord {
  id                String         @id @default(cuid())
  facilityId        String
  facility          Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  terminatedAt      DateTime       @db.Date
  /// Last day the person worked (may differ from separation / payroll end date).
  lastShiftWorkedAt DateTime?      @db.Date
  separationKind    SeparationKind @default(TERMINATED)
  /// Whether leadership would rehire; null on legacy imports / profile-only terminations.
  wouldRehire       Boolean?
  snapshotJson      String         @db.Text
  createdByUserId   String?
  createdBy         User?          @relation("TerminationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())

  @@index([facilityId, terminatedAt])
  @@index([employeeId])
}

/// When empty for an employee, they may use any active unit at the facility (sidebar + active unit).
/// When non-empty, PIN sessions are limited to these units.
model EmployeeUnitAccess {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([employeeId, unitId])
  @@index([employeeId])
  @@index([unitId])
}

/// PIN sign-in on a unit-locked tablet when the employee is not in `EmployeeUnitAccess` for that unit (or similar mismatch).
model KioskUnitPinLoginEvent {
  id                 String   @id @default(cuid())
  facilityId         String
  facility           Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  unitId             String
  unit               Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// True when the employee has a non-empty unit access list that does not include `unitId`.
  unassignedToUnit   Boolean
  /// Optional client IP (from proxy headers) for support review.
  clientIp           String?
  createdAt          DateTime @default(now())

  @@index([facilityId, createdAt])
  @@index([employeeId, createdAt])
  @@index([unitId, createdAt])
}

model DefaultAssignment {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  unitId     String
  unit       Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  roleType   RoleKey
  isActive   Boolean   @default(true)
  activeFrom DateTime  @default(now())
  activeTo   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([unitId, isActive])
  @@index([employeeId, isActive])
}

model ScheduleEntry {
  id           String               @id @default(cuid())
  employeeId   String
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date         DateTime
  shift        ShiftType
  roleType     RoleKey
  unitId       String
  unit         Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  workShiftId  String?
  workShift    WorkShift?           @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  plannedStart String?
  plannedEnd   String?
  createdById  String?
  createdBy    User?                @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  overrides    AssignmentOverride[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([date, unitId])
  @@index([employeeId, date])
  @@index([workShiftId])
}

model AssignmentOverride {
  id              String         @id @default(cuid())
  scheduleEntryId String?
  scheduleEntry   ScheduleEntry? @relation(fields: [scheduleEntryId], references: [id], onDelete: SetNull)
  date            DateTime
  mealType        MealType?
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  oldUnitId       String?
  oldUnit         Unit?          @relation("OverrideOldUnit", fields: [oldUnitId], references: [id], onDelete: SetNull)
  newUnitId       String
  newUnit         Unit           @relation("OverrideNewUnit", fields: [newUnitId], references: [id], onDelete: Restrict)
  reason          String
  changedById     String?
  changedBy       User?          @relation("OverrideChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt       DateTime       @default(now())

  @@index([date, newUnitId])
  @@index([employeeId, date])
}

model Vendor {
  id          String   @id @default(cuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  name        String
  phone       String?
  email       String?
  contactName String?
  notes       String?
  assets      Asset[]
  repairs     Repair[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([facilityId, name])
  @@index([facilityId])
}

model Asset {
  id            String           @id @default(cuid())
  assetCode     String           @unique
  name          String
  equipmentType String
  unitId        String
  unit          Unit             @relation(fields: [unitId], references: [id], onDelete: Restrict)
  departmentId  String?
  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  model         String?
  serialNumber  String?
  vendorId      String?
  vendor        Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  status        AssetStatus      @default(ACTIVE)
  criticality   AssetCriticality @default(ROUTINE)
  notes         String?
  repairs       Repair[]
  preventiveMaintenanceSchedules PreventiveMaintenanceSchedule[]
  knowledgeArticleAssets    KnowledgeArticleAsset[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([unitId, status])
  @@index([unitId, criticality])
  @@index([vendorId])
  @@index([departmentId])
}

model Repair {
  id                      String         @id @default(cuid())
  repairCode              String         @unique
  assetId                 String?
  asset                   Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  unitId                  String
  unit                    Unit           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  title                   String
  description             String
  priority                RepairPriority @default(MEDIUM)
  status                  RepairStatus   @default(OPEN)
  workOrderKind           WorkOrderKind  @default(CORRECTIVE)
  repairTrade             RepairTrade    @default(GENERAL)
  /// Product “Issue” classification; Repair remains the persistence model (ADL-008).
  issueType               IssueType      @default(EQUIPMENT)
  requestingDepartmentId  String?
  requestingDepartment    Department?    @relation("RepairRequestingDepartment", fields: [requestingDepartmentId], references: [id], onDelete: SetNull)
  responsibleDepartmentId String?
  responsibleDepartment   Department?    @relation("RepairResponsibleDepartment", fields: [responsibleDepartmentId], references: [id], onDelete: SetNull)
  assignedEmployeeId      String?
  assignedEmployee        Employee?      @relation("RepairAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  preventiveScheduleId    String?
  preventiveSchedule      PreventiveMaintenanceSchedule? @relation(fields: [preventiveScheduleId], references: [id], onDelete: SetNull)
  dueAt                   DateTime?
  estimatedLaborMinutes   Int?
  partsNote               String?
  reportedById            String?
  reportedBy              User?          @relation("RepairReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  vendorId                String?
  vendor                  Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  updates                 RepairUpdate[]
  attachments             Attachment[]
  createdAt               DateTime       @default(now())
  completedAt             DateTime?
  updatedAt               DateTime       @updatedAt

  @@index([unitId, status])
  @@index([priority, status])
  @@index([issueType, status])
  @@index([requestingDepartmentId])
  @@index([responsibleDepartmentId])
  @@index([assignedEmployeeId])
  @@index([preventiveScheduleId])
  @@index([dueAt])
}

model RepairUpdate {
  id                String        @id @default(cuid())
  repairId          String
  repair            Repair        @relation(fields: [repairId], references: [id], onDelete: Cascade)
  updateText        String
  updatedById       String?
  updatedBy         User?         @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  statusAfterUpdate RepairStatus?
  updatedAt         DateTime      @default(now())

  @@index([repairId, updatedAt])
}

model LogTemplate {
  id              String             @id @default(cuid())
  facilityId      String
  facility        Facility           @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  name            String
  category        String
  description     String?
  instructions    String?
  recurrence      LogRecurrence      @default(DAILY)
  isActive        Boolean            @default(true)
  departmentId    String?
  department      Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdByRoleId String?
  createdByRole   Role?              @relation(fields: [createdByRoleId], references: [id], onDelete: SetNull)
  fields          LogTemplateField[]
  assignments     LogAssignment[]
  submissions     LogSubmission[]
  knowledgeArticleLinks KnowledgeArticleLogTemplate[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([facilityId, name])
  @@index([category, isActive])
  @@index([facilityId])
  @@index([departmentId])
}

model LogTemplateField {
  id           String               @id @default(cuid())
  templateId   String
  template     LogTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label        String
  fieldType    LogFieldType
  isRequired   Boolean              @default(true)
  fieldOrder   Int
  unitLabel    String?
  fieldOptions String[]             @default([])
  values       LogSubmissionValue[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([templateId, fieldOrder])
  @@index([templateId])
}

model LogAssignment {
  id             String          @id @default(cuid())
  unitId         String
  unit           Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  templateId     String
  template       LogTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recurrence     LogRecurrence
  mealType       MealType?
  timesPerDay    Int             @default(1)
  requiredRole   RoleKey?
  isActive       Boolean         @default(true)
  effectiveStart DateTime        @default(now())
  effectiveEnd   DateTime?
  submissions    LogSubmission[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([unitId, isActive])
  @@index([templateId, isActive])
}

model LogSubmission {
  id                    String               @id @default(cuid())
  assignmentId          String
  assignment            LogAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  unitId                String
  unit                  Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  templateId            String
  template              LogTemplate          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  serviceDate           DateTime
  mealType              MealType?
  submittedById         String?
  submittedBy           User?                @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  submittedByEmployeeId String?
  submittedByEmployee   Employee?            @relation("SubmissionByEmployee", fields: [submittedByEmployeeId], references: [id], onDelete: SetNull)
  status                LogSubmissionStatus  @default(COMPLETED)
  notes                 String?
  correctiveAction      String?
  values                LogSubmissionValue[]
  attachments           Attachment[]
  submittedAt           DateTime             @default(now())

  @@index([unitId, serviceDate])
  @@index([templateId, serviceDate])
  @@index([submittedById])
  @@index([submittedByEmployeeId])
}

model LogSubmissionValue {
  id            String           @id @default(cuid())
  submissionId  String
  submission    LogSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId       String
  field         LogTemplateField @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  valueText     String?
  valueNumber   Float?
  valueBoolean  Boolean?
  valueDateTime DateTime?
  createdAt     DateTime         @default(now())

  @@index([submissionId])
  @@index([fieldId])
}

model WorkShift {
  id           String          @id @default(cuid())
  facilityId   String
  facility     Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name         String
  startLocal   String
  endLocal     String
  sortOrder    Int             @default(100)
  isActive     Boolean         @default(true)
  scheduleEntries ScheduleEntry[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([facilityId])
  @@index([departmentId])
}

model PreventiveMaintenanceSchedule {
  id            String                        @id @default(cuid())
  facilityId    String
  facility      Facility                      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset                         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  departmentId  String?
  department    Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name          String
  cadence       PreventiveMaintenanceCadence
  intervalCount Int                           @default(1)
  nextDueAt     DateTime
  isActive      Boolean                       @default(true)
  repairs       Repair[]
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  @@index([facilityId])
  @@index([assetId])
  @@index([departmentId])
  @@index([nextDueAt])
}

model RoomAreaStatus {
  id                  String                    @id @default(cuid())
  facilityId          String
  facility            Facility                  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  unitId              String
  unit                Unit                      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  statusDate          DateTime                  @db.Date
  status              RoomAreaOperationalStatus
  notes               String?
  updatedByEmployeeId String?
  updatedByEmployee   Employee?                 @relation(fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([unitId, statusDate])
  @@index([facilityId])
  @@index([unitId, statusDate])
  @@index([updatedByEmployeeId])
}

model Attachment {
  id                   String               @id @default(cuid())
  facilityId           String
  facility             Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  parentKind           AttachmentParentKind
  logSubmissionId      String?
  logSubmission        LogSubmission?       @relation(fields: [logSubmissionId], references: [id], onDelete: Cascade)
  repairId             String?
  repair               Repair?              @relation(fields: [repairId], references: [id], onDelete: Cascade)
  fileRelativePath     String
  originalFilename     String
  mimeType             String
  createdByUserId      String?
  createdByUser        User?                @relation("AttachmentCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByEmployeeId  String?
  createdByEmployee    Employee?            @relation("AttachmentCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  createdAt            DateTime             @default(now())

  @@index([facilityId])
  @@index([logSubmissionId])
  @@index([repairId])
  @@index([createdByUserId])
  @@index([createdByEmployeeId])
}

/// Additive Work Engine projection. LogSubmission / Repair remain source of truth.
model Task {
  id                  String          @id @default(cuid())
  facilityId          String
  facility            Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId        String?
  department          Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  unitId              String?
  unit                Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  operationInstanceId String?
  operationInstance   OperationInstance? @relation(fields: [operationInstanceId], references: [id], onDelete: SetNull)
  type                TaskType
  title               String
  description         String?
  status              TaskStatus      @default(OPEN)
  priority            TaskPriority    @default(MEDIUM)
  dueAt               DateTime?
  completedAt         DateTime?
  assignedEmployeeId  String?
  assignedEmployee    Employee?       @relation("TaskAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  sourceType          TaskSourceType
  sourceId            String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  inspectionSubmissions InspectionSubmission[]
  inspectionOccurrences InspectionOccurrence[]

  @@unique([facilityId, sourceType, sourceId])
  @@index([facilityId, status])
  @@index([facilityId, type])
  @@index([unitId])
  @@index([departmentId])
  @@index([assignedEmployeeId])
  @@index([operationInstanceId])
  @@index([dueAt])
}

/// Native Work Engine inspection checklist definition (distinct from LogTemplate).
model InspectionDefinition {
  id          String                     @id @default(cuid())
  facilityId  String
  facility    Facility                   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId String?
  department  Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  unitId      String?
  unit        Unit?                      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  name        String
  description String?
  /// Optional free-text notes; structured scheduling uses cadenceType / dueTimeLocal / daysOfWeek / dayOfMonth.
  frequency   String?
  cadenceType InspectionCadenceType      @default(ON_DEMAND)
  /// Facility-local due wall time "HH:MM". Null defaults to 09:00 for generated occurrences.
  dueTimeLocal String?
  /// Weekday numbers for WEEKLY cadence: 0=Sunday … 6=Saturday (facility-local).
  daysOfWeek  Int[]                      @default([])
  /// 1–31 for MONTHLY cadence (facility-local). Clamped to last day of short months.
  dayOfMonth  Int?
  activeFrom  DateTime?                  @db.Date
  activeUntil DateTime?                  @db.Date
  /// Last facility-local service date the generator has materialized through.
  lastGeneratedThrough DateTime?         @db.Date
  isActive    Boolean                    @default(true)
  items       InspectionDefinitionItem[]
  submissions InspectionSubmission[]
  occurrences InspectionOccurrence[]
  knowledgeArticleLinks KnowledgeArticleInspectionDefinition[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([facilityId, name])
  @@index([facilityId, isActive])
  @@index([facilityId, cadenceType, isActive])
  @@index([departmentId])
  @@index([unitId])
}

/// One scheduled inspection occurrence per definition + facility-local service date.
model InspectionOccurrence {
  id           String                      @id @default(cuid())
  definitionId String
  definition   InspectionDefinition        @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  facilityId   String
  facility     Facility                    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  unitId       String?
  unit         Unit?                       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  /// Facility-local calendar day as UTC-midnight @db.Date.
  serviceDate  DateTime                    @db.Date
  dueAt        DateTime
  status       InspectionOccurrenceStatus  @default(OPEN)
  taskId       String?
  task         Task?                       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  submission   InspectionSubmission?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([definitionId, serviceDate])
  @@index([facilityId, status, dueAt])
  @@index([facilityId, serviceDate])
  @@index([unitId, status])
  @@index([departmentId])
  @@index([taskId])
}

model InspectionDefinitionItem {
  id                    String                  @id @default(cuid())
  definitionId          String
  definition            InspectionDefinition    @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  label                 String
  description           String?
  sortOrder             Int
  isRequired            Boolean                 @default(true)
  responseType          InspectionResponseType
  failureCreatesFollowUp Boolean                @default(false)
  submissionItems       InspectionSubmissionItem[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([definitionId, sortOrder])
  @@index([definitionId])
}

model InspectionSubmission {
  id                     String                    @id @default(cuid())
  facilityId             String
  facility               Facility                  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  definitionId           String
  definition             InspectionDefinition      @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  unitId                 String?
  unit                   Unit?                     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  operationInstanceId    String?
  operationInstance      OperationInstance?        @relation(fields: [operationInstanceId], references: [id], onDelete: SetNull)
  /// When set, this submission completes the linked scheduled occurrence (no duplicate execution Task).
  occurrenceId           String?                   @unique
  occurrence             InspectionOccurrence?     @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  submittedByEmployeeId  String?
  submittedByEmployee    Employee?                 @relation("InspectionSubmittedByEmployee", fields: [submittedByEmployeeId], references: [id], onDelete: SetNull)
  submittedAt            DateTime                  @default(now())
  result                 InspectionResult
  notes                  String?
  /// Optional link to projected Task after sync (Task remains keyed by sourceType/sourceId).
  taskId                 String?
  task                   Task?                     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// Caller-supplied key to make retries idempotent within a facility.
  idempotencyKey         String?
  items                  InspectionSubmissionItem[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@unique([facilityId, idempotencyKey])
  @@index([facilityId, submittedAt])
  @@index([definitionId, submittedAt])
  @@index([unitId])
  @@index([operationInstanceId])
  @@index([submittedByEmployeeId])
  @@index([taskId])
  @@index([result])
  @@index([occurrenceId])
}

model InspectionSubmissionItem {
  id               String                   @id @default(cuid())
  submissionId     String
  submission       InspectionSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  definitionItemId String
  definitionItem   InspectionDefinitionItem @relation(fields: [definitionItemId], references: [id], onDelete: Restrict)
  /// For PASS_FAIL / YES_NO: true = pass/yes, false = fail/no.
  passed           Boolean?
  valueText        String?
  valueNumber      Float?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([submissionId, definitionItemId])
  @@index([submissionId])
  @@index([definitionItemId])
}

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KnowledgeArticleCategory {
  SOP
  EQUIPMENT
  LOCATION
  SAFETY
  COMPLIANCE
  TROUBLESHOOTING
  TRAINING
  REFERENCE
  OTHER
}

enum KnowledgeSourceType {
  MANUAL
  HANDBOOK
  VENDOR
  POLICY
  INCIDENT_LESSON
  OTHER
}

/// Operational knowledge article — facility source of truth for SOPs and reference content.
model KnowledgeArticle {
  id              String                   @id @default(cuid())
  facilityId      String
  facility        Facility                 @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId    String?
  department      Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title           String
  summary         String?
  body            String
  status          KnowledgeArticleStatus   @default(DRAFT)
  category        KnowledgeArticleCategory
  sourceType      KnowledgeSourceType      @default(MANUAL)
  createdByUserId String?
  createdBy       User?                    @relation("KnowledgeArticleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedBy       User?                    @relation("KnowledgeArticleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  archivedAt      DateTime?
  unitLinks       KnowledgeArticleUnit[]
  assetLinks      KnowledgeArticleAsset[]
  logTemplateLinks KnowledgeArticleLogTemplate[]
  inspectionDefinitionLinks KnowledgeArticleInspectionDefinition[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([facilityId, status])
  @@index([facilityId, category])
  @@index([facilityId, departmentId])
  @@index([facilityId, status, category])
}

model KnowledgeArticleUnit {
  id        String           @id @default(cuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([articleId, unitId])
  @@index([unitId])
}

model KnowledgeArticleAsset {
  id        String           @id @default(cuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([articleId, assetId])
  @@index([assetId])
}

model KnowledgeArticleLogTemplate {
  id            String           @id @default(cuid())
  articleId     String
  article       KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  logTemplateId String
  logTemplate   LogTemplate      @relation(fields: [logTemplateId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())

  @@unique([articleId, logTemplateId])
  @@index([logTemplateId])
}

model KnowledgeArticleInspectionDefinition {
  id                     String               @id @default(cuid())
  articleId              String
  article                KnowledgeArticle     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  inspectionDefinitionId String
  inspectionDefinition   InspectionDefinition @relation(fields: [inspectionDefinitionId], references: [id], onDelete: Cascade)
  createdAt              DateTime             @default(now())

  @@unique([articleId, inspectionDefinitionId])
  @@index([inspectionDefinitionId])
}

enum AiBriefStatus {
  READY
  FALLBACK
  FAILED
}

enum AiBriefType {
  MORNING_BRIEF
  SHIFT_TRANSITION
  RECOVERY_ASSISTANT
}

/// Cached Operational AI brief (Wave 10). Stores sanitized result (+ optional snapshot) — not raw prompts.
model AiOperationalBrief {
  id                   String        @id @default(cuid())
  facilityId           String
  facility             Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// Operational department key or "ALL" for facility-wide leadership view.
  departmentKey        String
  /// Facility-local service date as UTC-midnight @db.Date.
  serviceDate          DateTime      @db.Date
  briefType            AiBriefType   @default(MORNING_BRIEF)
  operationInstanceId  String?
  snapshotHash         String
  /// Sanitized operational snapshot used for baseline diffs (privacy-minimized).
  snapshotJson         Json?
  baselineSnapshotHash String?
  windowStart          DateTime?
  windowEnd            DateTime?
  resultJson           Json
  provider             String
  model                String
  status               AiBriefStatus @default(READY)
  promptVersion        String
  latencyMs            Int?
  errorCode            String?
  generatedAt          DateTime      @default(now())
  expiresAt            DateTime
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([facilityId, departmentKey, serviceDate, briefType, snapshotHash], map: "AiBrief_fac_dept_svc_type_hash_key")
  @@index([facilityId, departmentKey, serviceDate, briefType], map: "AiBrief_fac_dept_svc_type_idx")
  @@index([facilityId, briefType, generatedAt], map: "AiBrief_fac_type_generated_idx")
  @@index([expiresAt])
}

/// One-time password reset token for facility User accounts. Store only the hash of the secret.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt, expiresAt])
}

/// One-time email verification token for public signup. Store only the hash of the secret.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt, expiresAt])
}

/// One-time account invite for admin-created EMAIL_PASSWORD users. Store only the hash of the secret.
model AccountInviteToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt, expiresAt])
}

/// Per-user, per-facility Business Workspace layout preferences (Wave 12 M3).
/// Not device cookies — facility switch must load the destination facility prefs only.
model WorkspacePreference {
  id                        String   @id @default(cuid())
  userId                    String
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId                String
  facility                  Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// Optional sections the user has hidden (role-required sections cannot be hidden).
  hiddenSectionIds          String[] @default([])
  /// Sections currently collapsed in the Workspace UI.
  collapsedSectionIds       String[] @default([])
  /// Preferred visible-section order for customizable sections (core sections stay fixed first).
  sectionOrder              String[] @default([])
  /// Preferred landing / first focus section when opening Workspace.
  preferredLandingSectionId String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([userId, facilityId])
  @@index([userId])
  @@index([facilityId])
}

/// Explicit multi-facility access grant. Shared Organization alone never authorizes a facility.
/// Role remains on User for Wave 11 M2 (per-facility role deferred).
model UserFacilityAccess {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("UserFacilityAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  facilityId      String
  facility        Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  isActive        Boolean   @default(true)
  grantedByUserId String?
  grantedByUser   User?     @relation("UserFacilityAccessGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, facilityId])
  @@index([userId, isActive])
  @@index([facilityId, isActive])
  @@index([grantedByUserId])
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct Postgres URL (not the pooler). Required for migrations when `DATABASE_URL` uses Supabase pooler / PgBouncer.
  directUrl = env("DIRECT_URL")
}

enum RoleKey {
  FACILITY_ADMINISTRATOR
  GM
  MANAGER
  SUPERVISOR
  LEAD_TEAM_MEMBER
  STAFF
}

/// Organization-level membership authority (Phase 2B). Not a Facility RoleKey.
enum OrganizationMembershipRole {
  ORG_ADMIN
  ORG_MEMBER
}

/// First-admin Organization claim workflow status (Phase 2B2).
/// EXPIRED is derived for APPROVED + past expiresAt + not accepted/revoked.
enum OrganizationClaimStatus {
  REQUESTED
  APPROVED
  REJECTED
  REVOKED
  ACCEPTED
}

/// Organization self-administration invitations (Phase 2B3).
/// EXPIRED is derived for PENDING + past expiresAt + not accepted/revoked.
enum OrganizationMemberInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// External partner operational role (Phase 2C1). Not a Facility RoleKey.
enum OrganizationPartnerRole {
  PARTNER_VIEWER
  PARTNER_OPERATOR
  PARTNER_MANAGER
}

/// Authority under which a partner assignment, staffing policy, or user restriction was written.
/// Organization ids are immutable snapshots, not cascading foreign keys.
enum PartnerAssignmentAuthorityKind {
  facility_admin
  partner_org_admin
}

/// Platform role reference data: identity, display name, and the User relation.
///
/// A role's *capabilities* are not stored here. What each role may reach is defined in
/// `src/lib/route-registry/platform-routes.ts` and is not editable at runtime. Rows in this table
/// exist so users can be assigned a role and so the role can be named in the UI.
model Role {
  id               String                @id @default(cuid())
  key              RoleKey               @unique
  name             String
  description      String?
  isActive         Boolean               @default(true)
  users            User[]
  templates        LogTemplate[]
  routePermissions RoleRoutePermission[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

/// NON-AUTHORITATIVE compatibility data. Does not control access.
///
/// Route authorization, navigation, route labels, and the Access Matrix are all resolved from the
/// platform route registry in `src/lib/route-registry/platform-routes.ts`. Nothing reads this table
/// at runtime. Missing rows, extra rows, stale labels, and an empty table all leave authorization
/// unchanged.
///
/// Retained for historical migration continuity and transitional inspection. The only writers are
/// migrations and `prisma/seed.mjs`, which populates it from `prisma/legacy-route-mirror.json` —
/// a file generated from the registry, so the mirror cannot describe a policy the product does not
/// enforce. Removal is deferred to a later phase.
model AppRoute {
  id          String                @id @default(cuid())
  key         String                @unique
  pathPrefix  String                @unique
  label       String
  navVisible  Boolean               @default(true)
  navOrder    Int                   @default(100)
  isActive    Boolean               @default(true)
  isCritical  Boolean               @default(false)
  permissions RoleRoutePermission[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

/// NON-AUTHORITATIVE compatibility data. Does not grant or deny access.
///
/// See `AppRoute`. Editing these rows — including granting STAFF access to /admin or revoking it
/// from FACILITY_ADMINISTRATOR — has no effect on what any user can reach.
model RoleRoutePermission {
  id         String   @id @default(cuid())
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  appRouteId String
  appRoute   AppRoute @relation(fields: [appRouteId], references: [id], onDelete: Cascade)
  allowed    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([roleId, appRouteId])
  @@index([roleId])
  @@index([appRouteId])
}

/// Parent business entity for one or more Facilities. Facility remains the tenancy/ops root.
enum OrganizationType {
  HEALTHCARE_SYSTEM
  MANAGEMENT_COMPANY
  LONG_TERM_CARE
  HOSPITAL
  K12_DISTRICT
  UNIVERSITY
  CORPORATE
  HOSPITALITY
  OTHER
}

model Organization {
  id               String            @id @default(cuid())
  name             String
  legalName        String?
  displayName      String?
  organizationType OrganizationType?
  isActive         Boolean           @default(true)
  facilities       Facility[]
  /// Departments this Organization operates (may differ from Facility parent Organization).
  departmentOperatorRelationships DepartmentOperatorRelationship[]
  /// Facilities where this Organization is an explicit external partner (Phase 2A).
  facilityPartnerOrganizations FacilityPartnerOrganization[]
  /// Users with Organization membership records (Phase 2B). Does not grant Facility access.
  userOrganizationMemberships UserOrganizationMembership[]
  /// First-admin claim workflows (Phase 2B2).
  organizationClaimInvitations OrganizationClaimInvitation[]
  /// Ordinary member invitations after first admin exists (Phase 2B3).
  organizationMemberInvitations OrganizationMemberInvitation[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([name])
  @@index([isActive])
}

/// One deployment typically has one facility; all operational data is scoped here for future multi-site support.
model Facility {
  id                             String                          @id @default(cuid())
  organizationId                 String
  organization                   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  displayName                    String
  /// Legacy operator label. Organization is the canonical parent; kept for compatibility (do not dual-write).
  managementCompanyName          String?
  billingEmail                   String?
  stripeCustomerId               String?
  stripeDefaultPaymentMethodId   String?
  onboardingCurrentStep          String?
  onboardingStartedAt            DateTime?
  onboardingCompletedAt          DateTime?
  /// Optional org-selected accent color (hex) used for subtle UI delineation.
  brandColor                     String?
  /// IANA timezone for facility-local operational time (meals, service dates, due windows).
  timezone                       String                          @default("America/New_York")
  /// Hierarchy vocabulary profile key: ltc (default when null) | hospital | hotel | campus | corporate | custom.
  vocabularyProfile              String?
  /// Custom optional Building label; only used when vocabularyProfile = "custom".
  vocabularyLevel0Label          String?
  /// Custom hierarchy level labels; only used when vocabularyProfile = "custom".
  vocabularyLevel1Label          String?
  vocabularyLevel2Label          String?
  vocabularyLevel3Label          String?
  /// Relative path under app `uploads/` (see `lib/facility-uploads.ts`).
  unionHandbookPdfPath           String?
  unionHandbookOriginalFilename  String?
  unionHandbookUploadedAt        DateTime?
  unionHandbookEffectiveDate     DateTime?                       @db.Date
  users                          User[]
  consoleTickets                 ConsoleTicket[]
  supportContacts                SupportContact[]
  supportTickets                 SupportTicket[]
  userFacilityAccesses           UserFacilityAccess[]
  units                          Unit[]
  unitSpaces                     UnitSpace[]
  facilityRoomTypes              FacilityRoomType[]
  employees                      Employee[]
  logTemplates                   LogTemplate[]
  vendors                        Vendor[]
  facilityOrganizations          FacilityOrganization[]
  employeeHrAuditLogs            EmployeeHrAuditLog[]
  employeeTerminationRecords     EmployeeTerminationRecord[]
  menuSettings                   MenuSettings?
  menuItems                      MenuItem[]
  kioskUnitPinLoginEvents        KioskUnitPinLoginEvent[]
  onboardingManagerInvites       OnboardingManagerInvite[]
  operationDefinitions           OperationDefinition[]
  operationInstances             OperationInstance[]
  departments                    Department[]
  jobTitles                      JobTitle[]
  workShifts                     WorkShift[]
  preventiveMaintenanceSchedules PreventiveMaintenanceSchedule[]
  roomAreaStatuses               RoomAreaStatus[]
  operationalAssignments         OperationalAssignment[]
  assignmentPlans                OperationalAssignmentPlan[]
  assignmentTemplates            OperationalAssignmentTemplate[]
  attachments                    Attachment[]
  tasks                          Task[]
  inspectionDefinitions          InspectionDefinition[]
  inspectionSubmissions          InspectionSubmission[]
  inspectionOccurrences          InspectionOccurrence[]
  knowledgeArticles              KnowledgeArticle[]
  aiOperationalBriefs            AiOperationalBrief[]
  workspacePreferences           WorkspacePreference[]
  departmentOperationalProfiles  DepartmentOperationalProfile[]
  operationalCycles              DepartmentOperationalCycle[]
  cycleDayExpectations           OperationalCycleDayExpectation[]
  keyTimeDayExpectations         OperationalCycleKeyTimeDayExpectation[]
  operationalTemplates           OperationalTemplate[]
  operationalEvidenceRecords     OperationalEvidenceRecord[]
  logAttachments                 LogAttachment[]
  catalogInstalls                FacilityCatalogInstall[]
  assetIssues                    AssetIssue[]
  departmentWorkPlans            DepartmentWorkPlan[]
  departmentWorkOccurrences      DepartmentWorkOccurrence[]
  departmentOperationalZones     DepartmentOperationalZone[]
  departmentTeams                DepartmentTeam[]
  departmentTeamCycles           DepartmentTeamCycle[]
  facilityTypeLogDefaults        DepartmentFacilityTypeLogDefault[]
  departmentJobRoles             DepartmentJobRole[]
  departmentRequestRoutes        DepartmentRequestRoute[]
  operationalRequests            OperationalRequest[]
  maintenanceCategories          MaintenanceCategory[]
  preventiveMaintenancePlans     PreventiveMaintenancePlan[]
  billing                        FacilityBilling?
  departmentEntitlements         FacilityDepartmentEntitlement[]
  /// Explicit external partner Organizations (Phase 2A). Does not grant user access.
  facilityPartnerOrganizations   FacilityPartnerOrganization[]
  organizationClaimInvitationsRequested OrganizationClaimInvitation[] @relation("OrganizationClaimRequestedFromFacility")
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt

  @@index([organizationId])
}

/// Facility operational department (Dietary, EVS, Plant, etc.).
model Department {
  id                             String                          @id @default(cuid())
  facilityId                     String
  facility                       Facility                        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  key                            String
  name                           String
  sortOrder                      Int                             @default(100)
  isActive                       Boolean                         @default(true)
  /// When false, department is hidden from employee HR UI tabs (Admin → Departments).
  showInEmployeeApp              Boolean                         @default(true)
  headEmployeeId                 String?
  headEmployee                   Employee?                       @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  usersAsPrimary                 User[]                          @relation("UserPrimaryDepartment")
  employeesAsPrimary             Employee[]                      @relation("EmployeePrimaryDepartment")
  employeeDepartments            EmployeeDepartment[]
  unitResponsibilities           UnitDepartmentResponsibility[]
  spaceResponsibilities          UnitSpaceResponsibility[]
  assets                         Asset[]
  logTemplates                   LogTemplate[]
  workShifts                     WorkShift[]
  preventiveMaintenanceSchedules PreventiveMaintenanceSchedule[]
  repairsRequesting              Repair[]                        @relation("RepairRequestingDepartment")
  repairsResponsible             Repair[]                        @relation("RepairResponsibleDepartment")
  tasks                          Task[]
  inspectionDefinitions          InspectionDefinition[]
  inspectionOccurrences          InspectionOccurrence[]
  knowledgeArticles              KnowledgeArticle[]
  operationalAssignments         OperationalAssignment[]
  assignmentPlans                OperationalAssignmentPlan[]
  assignmentTemplates            OperationalAssignmentTemplate[]
  operationalProfiles            DepartmentOperationalProfile[]
  operationalCycles              DepartmentOperationalCycle[]
  cycleDayExpectations           OperationalCycleDayExpectation[]
  keyTimeDayExpectations         OperationalCycleKeyTimeDayExpectation[]
  operationalTemplates           OperationalTemplate[]
  operationalEvidenceRecords     OperationalEvidenceRecord[]
  logAttachments                 LogAttachment[]                 @relation("LogAttachmentOwningDepartment")
  logAttachmentsAsTarget         LogAttachment[]                 @relation("LogAttachmentTargetDepartment")
  assetIssues                    AssetIssue[]
  departmentWorkPlans            DepartmentWorkPlan[]
  departmentWorkOccurrences      DepartmentWorkOccurrence[]
  departmentOperationalZones     DepartmentOperationalZone[]
  scheduleEntries                ScheduleEntry[]
  teams                          DepartmentTeam[]
  teamCycles                     DepartmentTeamCycle[]
  facilityTypeLogDefaults        DepartmentFacilityTypeLogDefault[]
  jobRoles                       DepartmentJobRole[]
  employeeJobRoleAssignments     EmployeeDepartmentJobRole[]
  requestRoutesAsRequesting      DepartmentRequestRoute[]        @relation("RequestRouteRequesting")
  requestRoutesAsResponsible     DepartmentRequestRoute[]        @relation("RequestRouteResponsible")
  operationalRequestsRequesting  OperationalRequest[]            @relation("OperationalRequestRequesting")
  operationalRequestsResponsible OperationalRequest[]            @relation("OperationalRequestResponsible")
  operationalRequestsAffected    OperationalRequest[]            @relation("OperationalRequestAffected")
  departmentEntitlements         FacilityDepartmentEntitlement[]
  preventiveMaintenancePlans     PreventiveMaintenancePlan[]
  /// Date-effective operating Organization for this Department (governance metadata only).
  operatorRelationships          DepartmentOperatorRelationship[]
  /// Partner Department authorization scope periods (Phase 2A). Not user access.
  partnerDepartmentScopes        FacilityPartnerDepartmentScope[]
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt

  @@unique([facilityId, key])
  @@index([facilityId])
  @@index([facilityId, showInEmployeeApp])
  @@index([headEmployeeId])
}

/// Which Organization has primary operating responsibility for a Department during a period.
/// Governance metadata only — does not grant facility authorization or move operational tenancy.
/// Inclusive [effectiveFrom, effectiveTo]; null effectiveTo means open-ended (current or scheduled).
model DepartmentOperatorRelationship {
  id                  String       @id @default(cuid())
  departmentId        String
  department          Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Inclusive facility-local calendar start (@db.Date / UTC midnight).
  effectiveFrom       DateTime     @db.Date
  /// Inclusive facility-local calendar end. Null = open-ended.
  effectiveTo         DateTime?    @db.Date
  notes               String?
  /// Optional external account / customer code used with the operating Organization.
  externalAccountCode String?
  /// Optional contract or agreement reference.
  contractReference   String?
  createdByUserId     String?
  createdByUser       User?        @relation("DepartmentOperatorCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([departmentId, effectiveFrom])
  @@index([departmentId, effectiveTo])
  @@index([organizationId])
  @@index([createdByUserId])
}

/// Durable Facility ↔ external Organization partnership identity (Phase 2A).
/// Does not grant user access. Parent Organization of the Facility cannot be a partner.
/// Authorization timeline lives on FacilityPartnerAccessPeriod (timestamps, not @db.Date).
model FacilityPartnerOrganization {
  id               String   @id @default(cuid())
  facilityId       String
  facility         Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  notes            String?
  createdByUserId  String?
  createdByUser    User?    @relation("FacilityPartnerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedByUserId String?
  approvedByUser   User?    @relation("FacilityPartnerApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  endedByUserId    String?
  endedByUser      User?    @relation("FacilityPartnerEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)
  endedAt          DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  accessPeriods    FacilityPartnerAccessPeriod[]
  departmentScopes FacilityPartnerDepartmentScope[]
  /// Facility-owned maximum partner role over time. Absence of a current period disables personal entry.
  roleCeilingPeriods FacilityPartnerRoleCeilingPeriod[]
  /// Personal partner assignments. Does not grant UserFacilityAccess or a Facility session.
  partnerUserAccesses PartnerUserFacilityAccess[]
  /// Facility delegation allowing the partner Organization to manage personal assignments later.
  staffingPolicyPeriods FacilityPartnerStaffingPolicyPeriod[]
  /// Facility vetoes of one User under this partnership. Stronger than assignment state.
  userRestrictionPeriods FacilityPartnerUserRestrictionPeriod[]

  @@unique([facilityId, organizationId])
  @@index([facilityId])
  @@index([organizationId])
  @@index([endedAt])
}

/// Timestamp period when a Facility ↔ Organization partnership is security-active.
/// Half-open: startsAt <= instant < endsAt (null endsAt = open). Periods must not overlap.
model FacilityPartnerAccessPeriod {
  id                          String                     @id @default(cuid())
  facilityPartnerOrganizationId String
  facilityPartnerOrganization FacilityPartnerOrganization @relation(fields: [facilityPartnerOrganizationId], references: [id], onDelete: Cascade)
  startsAt                    DateTime
  endsAt                      DateTime?
  createdByUserId             String?
  createdByUser               User?                      @relation("FacilityPartnerAccessPeriodCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  endedByUserId               String?
  endedByUser                 User?                      @relation("FacilityPartnerAccessPeriodEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@index([facilityPartnerOrganizationId, startsAt], map: "FacilityPartnerAccessPeriod_partner_startsAt_idx")
  @@index([facilityPartnerOrganizationId, endsAt], map: "FacilityPartnerAccessPeriod_partner_endsAt_idx")
}

/// Timestamp period when a Department is in a partnership's authorized scope.
/// Half-open: startsAt <= instant < endsAt. Overlapping periods for same partnership+department rejected.
/// Not unique on (partnership, department) — remove/re-add creates new periods.
model FacilityPartnerDepartmentScope {
  id                          String                     @id @default(cuid())
  facilityPartnerOrganizationId String
  facilityPartnerOrganization FacilityPartnerOrganization @relation(fields: [facilityPartnerOrganizationId], references: [id], onDelete: Cascade)
  departmentId                String
  department                  Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  startsAt                    DateTime
  endsAt                      DateTime?
  createdByUserId             String?
  createdByUser               User?                      @relation("FacilityPartnerDepartmentScopeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  endedByUserId               String?
  endedByUser                 User?                      @relation("FacilityPartnerDepartmentScopeEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@index([facilityPartnerOrganizationId, startsAt], map: "FacilityPartnerDeptScope_partner_startsAt_idx")
  @@index([facilityPartnerOrganizationId, departmentId, startsAt], map: "FacilityPartnerDeptScope_partner_dept_startsAt_idx")
  @@index([departmentId], map: "FacilityPartnerDeptScope_departmentId_idx")
}

/// Facility-defined maximum personal partner role for one partnership.
/// Half-open: startsAt <= instant < endsAt. No current period means personal partner entry is disabled.
/// Changing the ceiling closes the current period and opens another. It does not rewrite assignment history.
model FacilityPartnerRoleCeilingPeriod {
  id                            String                      @id @default(cuid())
  facilityPartnerOrganizationId String
  facilityPartnerOrganization   FacilityPartnerOrganization @relation(fields: [facilityPartnerOrganizationId], references: [id], onDelete: Cascade)
  maxPartnerRole                OrganizationPartnerRole
  startsAt                      DateTime
  endsAt                        DateTime?
  createdByUserId               String?
  createdByUser                 User?                       @relation("FacilityPartnerRoleCeilingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  endedByUserId                 String?
  endedByUser                   User?                       @relation("FacilityPartnerRoleCeilingEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt

  @@index([facilityPartnerOrganizationId, startsAt], map: "FacilityPartnerRoleCeiling_partner_startsAt_idx")
  @@index([facilityPartnerOrganizationId, endsAt], map: "FacilityPartnerRoleCeiling_partner_endsAt_idx")
  @@index([createdByUserId])
  @@index([endedByUserId])
}

/// Durable User ↔ Facility partnership assignment (Phase 2C1).
/// Current authority lives on PartnerUserRolePeriod. Does not grant Facility access by itself.
model PartnerUserFacilityAccess {
  id                            String                      @id @default(cuid())
  userId                        String
  user                          User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  facilityPartnerOrganizationId String
  facilityPartnerOrganization   FacilityPartnerOrganization @relation(fields: [facilityPartnerOrganizationId], references: [id], onDelete: Cascade)
  createdByUserId               String?
  createdByUser                 User?                       @relation("PartnerUserFacilityAccessCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  rolePeriods                   PartnerUserRolePeriod[]

  @@unique([userId, facilityPartnerOrganizationId])
  @@index([facilityPartnerOrganizationId])
  @@index([userId])
  @@index([createdByUserId])
}

/// Timestamp period of personal partner role under one assignment.
/// Half-open: startsAt <= instant < endsAt. An open period means currently assigned.
model PartnerUserRolePeriod {
  id                         String                   @id @default(cuid())
  partnerUserFacilityAccessId String
  partnerUserFacilityAccess  PartnerUserFacilityAccess @relation(fields: [partnerUserFacilityAccessId], references: [id], onDelete: Cascade)
  partnerRole                OrganizationPartnerRole
  startsAt                   DateTime
  endsAt                     DateTime?
  createdByUserId            String?
  createdByUser              User?                    @relation("PartnerUserRolePeriodCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  endedByUserId              String?
  endedByUser                User?                    @relation("PartnerUserRolePeriodEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)
  /// Required. Existing rows are backfilled as facility_admin because that was the only writer.
  createdByAuthorityKind     PartnerAssignmentAuthorityKind
  /// Snapshot of the acting Organization. Null for facility_admin. Not a foreign key.
  createdByOrganizationId    String?
  /// Null only while the period is open. Closed periods record who ended them.
  endedByAuthorityKind       PartnerAssignmentAuthorityKind?
  /// Snapshot of the acting Organization when the period ended. Null for facility_admin.
  endedByOrganizationId      String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  @@index([partnerUserFacilityAccessId, startsAt], map: "PartnerUserRolePeriod_access_startsAt_idx")
  @@index([partnerUserFacilityAccessId, endsAt], map: "PartnerUserRolePeriod_access_endsAt_idx")
  @@index([createdByUserId])
  @@index([endedByUserId])
}

/// Historical Facility authorization for a partner Organization to manage its own assignments.
/// A current period means delegation is enabled. No current period means Facility-managed staffing.
/// Half-open: startsAt <= instant < endsAt. Disabling this does not end assignments.
model FacilityPartnerStaffingPolicyPeriod {
  id                            String                         @id @default(cuid())
  facilityPartnerOrganizationId String
  facilityPartnerOrganization   FacilityPartnerOrganization    @relation(fields: [facilityPartnerOrganizationId], references: [id], onDelete: Cascade)
  startsAt                      DateTime
  endsAt                        DateTime?
  createdByUserId               String?
  createdByUser                 User?                          @relation("FacilityPartnerStaffingPolicyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  endedByUserId                 String?
  endedByUser                   User?                          @relation("FacilityPartnerStaffingPolicyEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)
  createdByAuthorityKind        PartnerAssignmentAuthorityKind
  createdByOrganizationId       String?
  endedByAuthorityKind          PartnerAssignmentAuthorityKind?
  endedByOrganizationId         String?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  @@index([facilityPartnerOrganizationId, startsAt], map: "FacilityPartnerStaffingPolicyPeriod_partner_startsAt_idx")
  @@index([facilityPartnerOrganizationId, endsAt], map: "FacilityPartnerStaffingPolicyPeriod_partner_endsAt_idx")
  @@index([createdByUserId])
  @@index([endedByUserId])
}

/// Historical Facility veto of one User under one partnership.
/// Does not require PartnerUserFacilityAccess. A current period denies Path B even if a role period is open.
/// Half-open: startsAt <= instant < endsAt. The note is Facility-private.
model FacilityPartnerUserRestrictionPeriod {
  id                            String                         @id @default(cuid())
  userId                        String
  user                          User                           @relation("FacilityPartnerUserRestrictionSubject", fields: [userId], references: [id], onDelete: Restrict)
  facilityPartnerOrganizationId String
  facilityPartnerOrganization   FacilityPartnerOrganization    @relation(fields: [facilityPartnerOrganizationId], references: [id], onDelete: Cascade)
  startsAt                      DateTime
  endsAt                        DateTime?
  note                          String?
  createdByUserId               String?
  createdByUser                 User?                          @relation("FacilityPartnerUserRestrictionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  endedByUserId                 String?
  endedByUser                   User?                          @relation("FacilityPartnerUserRestrictionEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)
  createdByAuthorityKind        PartnerAssignmentAuthorityKind
  createdByOrganizationId       String?
  endedByAuthorityKind          PartnerAssignmentAuthorityKind?
  endedByOrganizationId         String?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  @@index([facilityPartnerOrganizationId, userId, startsAt], map: "FacilityPartnerUserRestrictionPeriod_partner_user_startsAt_idx")
  @@index([facilityPartnerOrganizationId, userId, endsAt], map: "FacilityPartnerUserRestrictionPeriod_partner_user_endsAt_idx")
  @@index([userId])
  @@index([createdByUserId])
  @@index([endedByUserId])
}

/// Durable User ↔ Organization membership identity (Phase 2B).
/// Does not grant Facility access. Current authority lives on UserOrganizationRolePeriod.
model UserOrganizationMembership {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUserId String?
  createdByUser   User?    @relation("UserOrganizationMembershipCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  rolePeriods     UserOrganizationRolePeriod[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([createdByUserId])
}

/// Timestamp period of Organization-level role authority for a membership.
/// Half-open: startsAt <= instant < endsAt. Current period = current membership.
model UserOrganizationRolePeriod {
  id             String                     @id @default(cuid())
  membershipId   String
  membership     UserOrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role           OrganizationMembershipRole
  startsAt       DateTime
  endsAt         DateTime?
  createdByUserId String?
  createdByUser  User?                      @relation("UserOrganizationRolePeriodCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  endedByUserId  String?
  endedByUser    User?                      @relation("UserOrganizationRolePeriodEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([membershipId, startsAt], map: "UserOrgRolePeriod_membership_startsAt_idx")
  @@index([membershipId, endsAt], map: "UserOrgRolePeriod_membership_endsAt_idx")
  @@index([createdByUserId])
  @@index([endedByUserId])
}

/// Secure first-admin claim workflow for an Organization (Phase 2B2).
/// REQUESTED has no bearer token. APPROVED stores only tokenHash until acceptance.
/// Acceptance creates ORG_ADMIN membership authority — claim token then dies.
model OrganizationClaimInvitation {
  id                         String                  @id @default(cuid())
  organizationId             String
  organization               Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetEmailNormalized      String
  /// Optional contact display name for Harbor review (not authority).
  contactName                String?
  notes                      String?
  /// Null until Harbor approves. SHA-256 of raw token; never store plaintext.
  tokenHash                  String?                 @unique
  expiresAt                  DateTime?
  status                     OrganizationClaimStatus @default(REQUESTED)
  requestedByUserId          String?
  requestedByUser            User?                   @relation("OrganizationClaimRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedFromFacilityId    String?
  requestedFromFacility      Facility?               @relation("OrganizationClaimRequestedFromFacility", fields: [requestedFromFacilityId], references: [id], onDelete: SetNull)
  approvedByPlatformStaffId  String?
  approvedByPlatformStaff    PlatformStaff?          @relation("OrganizationClaimApprovedBy", fields: [approvedByPlatformStaffId], references: [id], onDelete: SetNull)
  approvedAt                 DateTime?
  rejectedByPlatformStaffId  String?
  rejectedByPlatformStaff    PlatformStaff?          @relation("OrganizationClaimRejectedBy", fields: [rejectedByPlatformStaffId], references: [id], onDelete: SetNull)
  rejectedAt                 DateTime?
  revokedByPlatformStaffId   String?
  revokedByPlatformStaff     PlatformStaff?          @relation("OrganizationClaimRevokedBy", fields: [revokedByPlatformStaffId], references: [id], onDelete: SetNull)
  revokedAt                  DateTime?
  acceptedByUserId           String?
  acceptedByUser             User?                   @relation("OrganizationClaimAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  acceptedAt                 DateTime?
  /// Last invitation email attempt result for Harbor visibility (not authority).
  lastInvitationDeliveredAt  DateTime?
  lastInvitationDeliveryStatus String?
  lastInvitationDeliveryError  String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@index([organizationId, status])
  @@index([targetEmailNormalized])
  @@index([requestedFromFacilityId])
  @@index([requestedByUserId])
  @@index([status, expiresAt])
}

/// Secure invitation for an existing ORG_ADMIN to add ORG_MEMBER or ORG_ADMIN.
/// Distinct from OrganizationClaimInvitation (Harbor first-admin bootstrap).
/// Does not grant Facility access.
model OrganizationMemberInvitation {
  id                           String                             @id @default(cuid())
  organizationId               String
  organization                 Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  targetEmailNormalized        String
  intendedRole                 OrganizationMembershipRole
  /// SHA-256 of raw token. Rotated on resend. Never store plaintext.
  tokenHash                    String?                            @unique
  expiresAt                    DateTime?
  status                       OrganizationMemberInvitationStatus @default(PENDING)
  invitedByUserId              String
  invitedByUser                User                               @relation("OrganizationMemberInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedByUserId             String?
  acceptedByUser               User?                              @relation("OrganizationMemberInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  acceptedAt                   DateTime?
  revokedByUserId              String?
  revokedByUser                User?                              @relation("OrganizationMemberInvitationRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revokedAt                    DateTime?
  lastInvitationDeliveredAt    DateTime?
  lastInvitationDeliveryStatus String?
  lastInvitationDeliveryError  String?
  createdAt                    DateTime                           @default(now())
  updatedAt                    DateTime                           @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, targetEmailNormalized, status])
  @@index([targetEmailNormalized])
  @@index([invitedByUserId])
  @@index([status, expiresAt])
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum BillingSetupPath {
  SELF_SERVE
  ASSISTED
}

/// UNMANAGED = grandfathered / not sold yet. Enforcement ignores this status.
enum FacilityBillingStatus {
  UNMANAGED
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum DepartmentEntitlementStatus {
  ACTIVE
  REVOKED
}

/// One commercial record per facility. Does not gate product until BILLING_ENTITLEMENTS_ENABLED.
model FacilityBilling {
  id                      String                         @id @default(cuid())
  facilityId              String                         @unique
  facility                Facility                       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  status                  FacilityBillingStatus          @default(UNMANAGED)
  interval                BillingInterval                @default(ANNUAL)
  setupPath               BillingSetupPath               @default(SELF_SERVE)
  stripeSubscriptionId    String?
  licensedDepartmentCount Int?
  entitlements            FacilityDepartmentEntitlement[]
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  @@index([status])
}

/// Licensed operational department for a facility. Independent of showInEmployeeApp.
model FacilityDepartmentEntitlement {
  id                       String                       @id @default(cuid())
  facilityBillingId        String
  facilityBilling          FacilityBilling              @relation(fields: [facilityBillingId], references: [id], onDelete: Cascade)
  facilityId               String
  facility                 Facility                     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentKey            String
  departmentId             String?
  department               Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status                   DepartmentEntitlementStatus  @default(ACTIVE)
  activatedAt              DateTime                     @default(now())
  revokedAt                DateTime?
  stripeSubscriptionItemId String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@unique([facilityBillingId, departmentKey])
  @@index([facilityId, status])
  @@index([departmentId])
}

/// Facility-scoped job title catalog for HR / employee directory.
model JobTitle {
  id         String     @id @default(cuid())
  facilityId String
  facility   Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int        @default(100)
  isActive   Boolean    @default(true)
  employees  Employee[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([facilityId, name])
  @@index([facilityId])
}

/// Additional Department membership (not the primary Department).
/// Canonical membership is Employee.primaryDepartmentId ∪ EmployeeDepartment.
/// `roleType` is dormant — Employee.roleType remains canonical authority.
model EmployeeDepartment {
  id           String     @id @default(cuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Dormant. Do not treat as per-Department authority.
  roleType     RoleKey    @default(STAFF)
  createdAt    DateTime   @default(now())

  @@unique([employeeId, departmentId])
  @@index([employeeId])
  @@index([departmentId])
}

model OnboardingManagerInvite {
  id         String    @id @default(cuid())
  facilityId String
  facility   Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  email      String
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@unique([facilityId, email])
  @@index([facilityId, createdAt])
}

/// Recurring operation template scoped to a facility department (e.g. dietary breakfast service).
model OperationDefinition {
  id                  String                          @id @default(cuid())
  facilityId          String
  facility            Facility                        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// Department scope (`Department.id` when the departments model is present).
  departmentId        String
  /// Stable slug unique per department (e.g. `breakfast`, `evs-day-round-1`).
  key                 String
  /// Display label (e.g. "Breakfast").
  label               String
  /// Dietary meal period when applicable; null for non-meal operations (EVS rounds, plant PM).
  mealType            MealType?
  /// Optional named shift template id (`WorkShift.id` when shift model is present).
  workShiftId         String?
  /// Local start time hint (`HH:mm`) for sync/scheduling; not authoritative until wired.
  scheduledStartLocal String?
  scheduledEndLocal   String?
  sortOrder           Int                             @default(100)
  isActive            Boolean                         @default(true)
  instances           OperationInstance[]
  assignmentTemplates OperationalAssignmentTemplate[]
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@unique([facilityId, departmentId, key])
  @@index([facilityId])
  @@index([departmentId])
  @@index([workShiftId])
}

/// A single dated occurrence of an operation (e.g. "Breakfast 2026-07-08").
model OperationInstance {
  id                       String                    @id @default(cuid())
  facilityId               String
  facility                 Facility                  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId             String
  definitionId             String
  definition               OperationDefinition       @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  /// Service date for this occurrence (facility-local calendar day).
  serviceDate              DateTime                  @db.Date
  /// Denormalized for query filters without joining the definition.
  mealType                 MealType?
  /// Snapshot label copied from definition at instance creation.
  label                    String
  status                   OperationInstanceStatus   @default(SCHEDULED)
  workShiftId              String?
  scheduledStartLocal      String?
  scheduledEndLocal        String?
  startedAt                DateTime?
  completedAt              DateTime?
  serveryMealServiceEvents ServeryMealServiceEvent[]
  tasks                    Task[]
  inspectionSubmissions    InspectionSubmission[]
  operationalAssignments   OperationalAssignment[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([definitionId, serviceDate])
  @@index([facilityId, serviceDate])
  @@index([departmentId, serviceDate])
  @@index([facilityId, departmentId, serviceDate])
  @@index([status])
  @@index([workShiftId])
}

model MenuSettings {

/// Canonical Issue store (persistence name AssetIssue). Not a Request. Not a Work Order.
/// Asset is optional — location-only Issues snapshot unitId (+ optional spaceId).
model AssetIssue {
  id                       String                 @id @default(cuid())
  issueCode                String                 @unique
  facilityId               String
  facility                 Facility               @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  departmentId             String
  department               Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assetId                  String?
  asset                    Asset?                 @relation(fields: [assetId], references: [id], onDelete: Restrict)
  unitId                   String
  unit                     Unit                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  spaceId                  String?
  space                    UnitSpace?             @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  summary                  String
  description              String
  status                   AssetIssueStatus       @default(REPORTED)
  priority                 RepairPriority         @default(MEDIUM)
  operationalImpact        AssetOperationalImpact @default(NO_IMMEDIATE_IMPACT)
  equipmentRemainsUsable   Boolean                @default(true)
  workaroundInstruction    String?
  observedAt               DateTime
  reportedAt               DateTime               @default(now())
  synchronizedAt           DateTime?
  recordedOnline           Boolean                @default(true)
  clientCommandId          String?
  deviceBoundUnitId        String?
  reportedByUserId         String?
  reportedByUser           User?                  @relation("AssetIssueReportedByUser", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  reportedByEmployeeId     String?
  reportedByEmployee       Employee?              @relation("AssetIssueReportedByEmployee", fields: [reportedByEmployeeId], references: [id], onDelete: SetNull)
  reportedByLabel          String?
  triageNote               String?
  resolvedAt               DateTime?
  closedAt                 DateTime?
  resolutionReason         String?
  /// Compatibility pointer to the first linked Work Order. Not cardinality authority.
  workOrderId              String?                @unique
  workOrder                Repair?                @relation("AssetIssueWorkOrder", fields: [workOrderId], references: [id], onDelete: SetNull)
  /// Authoritative Issue → many Work Orders (Repair.issueId).
  workOrders               Repair[]               @relation("RepairCanonicalIssue")
  /// Reverse of OperationalRequest.relatedAssetIssueId (many Requests → one Issue).
  relatedFromOperationalRequests OperationalRequest[] @relation("OperationalRequestRelatedIssue")
  /// Canonical Record that first established this condition. Provenance only.
  originEvidenceRecordId   String?
  originEvidenceRecord     OperationalEvidenceRecord? @relation("AssetIssueOriginEvidence", fields: [originEvidenceRecordId], references: [id], onDelete: SetNull)
  updates                  AssetIssueUpdate[]
  evidenceLinks            AssetIssueEvidenceLink[]
  statusHistoryLinks       AssetStatusHistory[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@unique([facilityId, departmentId, clientCommandId])
  @@index([facilityId, departmentId, status])
  @@index([facilityId, assetId, status])
  @@index([facilityId, unitId, status])
  @@index([priority, status])
  @@index([observedAt])
  @@index([originEvidenceRecordId])
}

model AssetIssueUpdate {
  id                String           @id @default(cuid())
  issueId           String
  issue             AssetIssue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  updateText        String
  statusAfterUpdate AssetIssueStatus?
  updatedByUserId   String?
  updatedByUser     User?            @relation("AssetIssueUpdateByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByEmployeeId String?
  updatedByEmployee Employee?        @relation("AssetIssueUpdateByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)
  updatedAt         DateTime         @default(now())

  @@index([issueId, updatedAt])
}

/// Supporting Evidence for an Asset Issue (many-to-many; neither owns the other).
model AssetIssueEvidenceLink {
  id               String                    @id @default(cuid())
  issueId          String
  issue            AssetIssue                @relation(fields: [issueId], references: [id], onDelete: Cascade)
  evidenceRecordId String
  evidenceRecord   OperationalEvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  linkedByUserId   String?
  linkedByUser     User?                     @relation("AssetIssueEvidenceLinkedBy", fields: [linkedByUserId], references: [id], onDelete: SetNull)
  linkedAt         DateTime                  @default(now())
  note             String?

  @@unique([issueId, evidenceRecordId])
  @@index([evidenceRecordId])
}

/// Facility-scoped allowed Request destinations (requesting dept → responsible dept).
/// No rules engine — reporter picks from configured routes (or sole default).
model DepartmentRequestRoute {
  id                     String     @id @default(cuid())
  facilityId             String
  facility               Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  requestingDepartmentId String
  requestingDepartment   Department @relation("RequestRouteRequesting", fields: [requestingDepartmentId], references: [id], onDelete: Cascade)
  responsibleDepartmentId String
  responsibleDepartment  Department @relation("RequestRouteResponsible", fields: [responsibleDepartmentId], references: [id], onDelete: Cascade)
  isActive               Boolean    @default(true)
  sortOrder              Int        @default(100)
  note                   String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@unique([facilityId, requestingDepartmentId, responsibleDepartmentId])
  @@index([facilityId, requestingDepartmentId])
  @@index([facilityId, requestingDepartmentId, isActive])
}

/// Cross-department Operational Request (Asset optional). Owns intake / triage / requester-visible status.
/// Does not own repair work — Work Order link is explicit via workOrderId.
model OperationalRequest {
  id                           String                   @id @default(cuid())
  requestCode                  String                   @unique
  facilityId                   String
  facility                     Facility                 @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  requestingDepartmentId       String
  requestingDepartment         Department               @relation("OperationalRequestRequesting", fields: [requestingDepartmentId], references: [id], onDelete: Restrict)
  responsibleDepartmentId      String
  responsibleDepartment        Department               @relation("OperationalRequestResponsible", fields: [responsibleDepartmentId], references: [id], onDelete: Restrict)
  affectedDepartmentId         String?
  affectedDepartment           Department?              @relation("OperationalRequestAffected", fields: [affectedDepartmentId], references: [id], onDelete: SetNull)
  unitId                       String
  unit                         Unit                     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  spaceId                      String?
  space                        UnitSpace?               @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  assetId                      String?
  asset                        Asset?                   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  summary                      String
  description                  String
  status                       OperationalRequestStatus @default(REPORTED)
  priority                     RepairPriority           @default(MEDIUM)
  operationalImpact            AssetOperationalImpact   @default(NO_IMMEDIATE_IMPACT)
  /// Null when no Asset is attached.
  equipmentRemainsUsable       Boolean?
  observedAt                   DateTime
  reportedAt                   DateTime                 @default(now())
  /// Limited factual status for requesters (never private triage / vendor internals).
  requesterVisibleStatusSummary String?
  /// Requester-visible workaround when intended.
  workaroundInstruction        String?
  reportedByUserId             String?
  reportedByUser               User?                    @relation("OperationalRequestReportedByUser", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  reportedByEmployeeId         String?
  reportedByEmployee           Employee?                @relation("OperationalRequestReportedByEmployee", fields: [reportedByEmployeeId], references: [id], onDelete: SetNull)
  reportedByLabel              String?
  /// Internal triage note — never requester-visible.
  triageNote                   String?
  resolutionReason             String?
  resolvedAt                   DateTime?
  closedAt                     DateTime?
  relatedAssetIssueId          String?
  relatedAssetIssue            AssetIssue?              @relation("OperationalRequestRelatedIssue", fields: [relatedAssetIssueId], references: [id], onDelete: SetNull)
  workOrderId                  String?                  @unique
  workOrder                    Repair?                  @relation("OperationalRequestWorkOrder", fields: [workOrderId], references: [id], onDelete: SetNull)
  clientCommandId              String?
  recordedOnline               Boolean                  @default(true)
  synchronizedAt               DateTime?
  deviceBoundUnitId            String?
  updates                      OperationalRequestUpdate[]
  evidenceLinks                OperationalRequestEvidenceLink[]
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  @@unique([facilityId, requestingDepartmentId, clientCommandId])
  @@index([facilityId, responsibleDepartmentId, status])
  @@index([facilityId, requestingDepartmentId, status])
  @@index([facilityId, unitId, status])
  @@index([priority, status])
  @@index([assetId])
  @@index([workOrderId])
  @@index([relatedAssetIssueId])
  @@index([observedAt])
}

model OperationalRequestUpdate {
  id                  String                   @id @default(cuid())
  requestId           String
  request             OperationalRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  updateText          String
  statusAfterUpdate   OperationalRequestStatus?
  updatedByUserId     String?
  updatedByUser       User?                    @relation("OperationalRequestUpdateByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByEmployeeId String?
  updatedByEmployee   Employee?                @relation("OperationalRequestUpdateByEmployee", fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)
  /// When true, this history line may appear in requester-visible status.
  requesterVisible    Boolean                  @default(false)
  updatedAt           DateTime                 @default(now())

  @@index([requestId, updatedAt])
}

/// Supporting Evidence for an Operational Request (many-to-many; neither owns the other).
model OperationalRequestEvidenceLink {
  id               String                    @id @default(cuid())
  requestId        String
  request          OperationalRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  evidenceRecordId String
  evidenceRecord   OperationalEvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  linkedByUserId   String?
  linkedByUser     User?                     @relation("OperationalRequestEvidenceLinkedBy", fields: [linkedByUserId], references: [id], onDelete: SetNull)
  linkedAt         DateTime                  @default(now())
  note             String?

  @@unique([requestId, evidenceRecordId])
  @@index([evidenceRecordId])
}

/// Facility-scoped Plant maintenance classification. Not Asset class. Not RepairTrade.
model MaintenanceCategory {
  id         String    @id @default(cuid())
  facilityId String
  facility   Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  key        String
  label      String
  sortOrder  Int       @default(100)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  workOrders Repair[]
  pmPlanVersions PreventiveMaintenancePlanVersion[]

  @@unique([facilityId, key])
  @@index([facilityId, archivedAt])
}

model Repair {
  id                      String                         @id @default(cuid())
  repairCode              String                         @unique
  assetId                 String?
  asset                   Asset?                         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  unitId                  String
  unit                    Unit                           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  spaceId                 String?
  space                   UnitSpace?                     @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  title                   String
  description             String
  priority                RepairPriority                 @default(MEDIUM)
  status                  RepairStatus                   @default(OPEN)
  workOrderKind           WorkOrderKind                  @default(CORRECTIVE)
  repairTrade             RepairTrade                    @default(GENERAL)
  /// Product “Issue” classification on legacy Repair façade (ADL-008).
  issueType               IssueType                      @default(EQUIPMENT)
  requestingDepartmentId  String?
  requestingDepartment    Department?                    @relation("RepairRequestingDepartment", fields: [requestingDepartmentId], references: [id], onDelete: SetNull)
  responsibleDepartmentId String?
  responsibleDepartment   Department?                    @relation("RepairResponsibleDepartment", fields: [responsibleDepartmentId], references: [id], onDelete: SetNull)
  assignedEmployeeId      String?
  assignedEmployee        Employee?                      @relation("RepairAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  preventiveScheduleId    String?
  preventiveSchedule      PreventiveMaintenanceSchedule? @relation(fields: [preventiveScheduleId], references: [id], onDelete: SetNull)
  /// Canonical PM occurrence. Not globally unique: canceled Work Orders may be replaced.
  /// Partial unique index Repair_pmOccurrenceId_active_key: at most one active WO per occurrence.
  pmOccurrenceId          String?
  pmOccurrence            PreventiveMaintenanceOccurrence? @relation("PmOccurrenceWorkOrders", fields: [pmOccurrenceId], references: [id], onDelete: SetNull)
  completedPmOccurrence   PreventiveMaintenanceOccurrence? @relation("PmOccurrenceCompletedWorkOrder")
  dueAt                   DateTime?
  /// Target completion date for Phase 10A Work Order tracking.
  targetDate              DateTime?
  requestedAt             DateTime                       @default(now())
  startedAt               DateTime?
  estimatedLaborMinutes   Int?
  partsNote               String?
  workPerformed           String?
  /// Compatibility completion note. Canonical closeout summary is workPerformed.
  resolution              String?
  /// Recorded vendor/material expense. Not labor dollars. Not a Facility currency model.
  externalCost            Decimal?                       @db.Decimal(12, 2)
  externalCostNote        String?
  assetConditionReview    RepairAssetConditionReview?
  assetConditionReviewedAt DateTime?
  assetConditionReviewedByUserId String?
  assetConditionReviewedByUser User? @relation("RepairAssetConditionReviewedBy", fields: [assetConditionReviewedByUserId], references: [id], onDelete: SetNull)
  followUpRequired        Boolean                        @default(false)
  followUpNote            String?
  /// Explicit return-to-service confirmation on the Work Order (does not mutate Asset alone).
  returnToServiceReady    Boolean                        @default(false)
  reportedById            String?
  reportedBy              User?                          @relation("RepairReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  vendorId                String?
  vendor                  Vendor?                        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// Authoritative Issue link (one Work Order → zero or one Issue; one Issue → many Work Orders).
  issueId                 String?
  issue                   AssetIssue?                    @relation("RepairCanonicalIssue", fields: [issueId], references: [id], onDelete: SetNull)
  /// Compatibility reverse of AssetIssue.workOrderId (first linked Work Order only).
  sourceAssetIssue        AssetIssue?                    @relation("AssetIssueWorkOrder")
  /// Optional Phase 12A source Operational Request (Request owns the FK).
  sourceOperationalRequest OperationalRequest?           @relation("OperationalRequestWorkOrder")
  /// Canonical hold reason when status is ON_HOLD. Null when not on hold.
  holdReason              WorkOrderHoldReason?
  /// Exact Procedure version pin. Never the Knowledge article head.
  procedureVersionId      String?
  procedureVersion        KnowledgeArticleVersion?       @relation(fields: [procedureVersionId], references: [id], onDelete: Restrict)
  /// Facility Plant Operations maintenance category. Optional for historical rows.
  maintenanceCategoryId   String?
  maintenanceCategory     MaintenanceCategory?           @relation(fields: [maintenanceCategoryId], references: [id], onDelete: Restrict)
  updates                 RepairUpdate[]
  attachments             Attachment[]
  assetStatusHistoryLinks AssetStatusHistory[]
  evidenceLinks           RepairEvidenceLink[]
  laborEntries            RepairLaborEntry[]
  partsUsed               RepairPartUsed[]
  recordRequirements      RepairRecordRequirement[]
  createdAt               DateTime                       @default(now())
  completedAt             DateTime?
  updatedAt               DateTime                       @updatedAt

  @@index([unitId, status])
  @@index([priority, status])
  @@index([issueType, status])
  @@index([requestingDepartmentId])
  @@index([responsibleDepartmentId])
  @@index([assignedEmployeeId])
  @@index([preventiveScheduleId])
  @@index([pmOccurrenceId])
  @@index([dueAt])
  @@index([targetDate])
  @@index([issueId])
  @@index([spaceId])
  @@index([procedureVersionId])
  @@index([maintenanceCategoryId])
  @@index([assetConditionReviewedByUserId])
}

/// Incidental canonical Record linked to a Work Order. Not a required-closeout gate.
model RepairEvidenceLink {
  id               String                    @id @default(cuid())
  repairId         String
  repair           Repair                    @relation(fields: [repairId], references: [id], onDelete: Cascade)
  evidenceRecordId String
  evidenceRecord   OperationalEvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Cascade)
  linkedByUserId   String?
  linkedByUser     User?                     @relation("RepairEvidenceLinkedBy", fields: [linkedByUserId], references: [id], onDelete: SetNull)
  linkedAt         DateTime                  @default(now())
  note             String?

  @@unique([repairId, evidenceRecordId])
  @@index([evidenceRecordId])
}

/// Work Order Labor Entry. minutes >= 0; missing entries are not the same as zero labor.
model RepairLaborEntry {
  id                String   @id @default(cuid())
  repairId          String
  repair            Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  /// Employee who performed the labor. Independent of later Work Order assignee.
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  minutes           Int
  note              String?
  recordedAt        DateTime @default(now())
  recordedByUserId  String?
  recordedByUser    User?    @relation("RepairLaborRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([repairId])
  @@index([employeeId])
  @@index([recordedByUserId])
}

/// Work Order Part Used. No catalog or inventory FK. lineCost is optional line total, not unit cost.
model RepairPartUsed {
  id              String   @id @default(cuid())
  repairId        String
  repair          Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  description     String
  partNumber      String?
  quantity        Decimal  @db.Decimal(12, 3)
  lineCost        Decimal? @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  createdByUserId String?
  createdByUser   User?    @relation("RepairPartUsedCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([repairId])
  @@index([createdByUserId])
}

/// Work Order Required Evidence. Pins a published OperationalTemplate version.
model RepairRecordRequirement {
  id                   String                         @id @default(cuid())
  repairId             String
  repair               Repair                         @relation(fields: [repairId], references: [id], onDelete: Cascade)
  templateId           String
  template             OperationalTemplate            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateStableKey    String
  templateVersion      Int
  templateName         String
  sortOrder            Int                            @default(0)
  status               RepairRecordRequirementStatus  @default(PENDING)
  satisfiedByRecordId  String?
  satisfiedByRecord    OperationalEvidenceRecord?     @relation(fields: [satisfiedByRecordId], references: [id], onDelete: Restrict)
  waivedAt             DateTime?
  waivedByUserId       String?
  waivedByUser         User?                          @relation("RepairRecordRequirementWaivedBy", fields: [waivedByUserId], references: [id], onDelete: SetNull)
  waiveReason          String?
  createdAt            DateTime                       @default(now())
  createdByUserId      String?
  createdByUser        User?                          @relation("RepairRecordRequirementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([repairId, templateId])
  @@index([repairId, status])
  @@index([templateId])
  @@index([satisfiedByRecordId])
  @@index([waivedByUserId])
  @@index([createdByUserId])
}

model RepairUpdate {
  id                String        @id @default(cuid())
  repairId          String
  repair            Repair        @relation(fields: [repairId], references: [id], onDelete: Cascade)
  updateText        String
  updatedById       String?
  updatedBy         User?         @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  statusAfterUpdate RepairStatus?
  /// When true, this update may appear in requester-visible status summaries (Phase 12A).
  requesterVisible  Boolean       @default(false)
  updatedAt         DateTime      @default(now())

  @@index([repairId, updatedAt])
}

model LogTemplate {
  id                    String                        @id @default(cuid())
  facilityId            String
  facility              Facility                      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  name                  String
  category              String
  description           String?
  instructions          String?
  recurrence            LogRecurrence                 @default(DAILY)
  isActive              Boolean                       @default(true)
  departmentId          String?
  department            Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdByRoleId       String?
  createdByRole         Role?                         @relation(fields: [createdByRoleId], references: [id], onDelete: SetNull)
  fields                LogTemplateField[]
  assignments           LogAssignment[]
  submissions           LogSubmission[]
  knowledgeArticleLinks KnowledgeArticleLogTemplate[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@unique([facilityId, name])
  @@index([category, isActive])
  @@index([facilityId])
  @@index([departmentId])
}

model LogTemplateField {
  id           String               @id @default(cuid())
  templateId   String
  template     LogTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label        String
  fieldType    LogFieldType
  isRequired   Boolean              @default(true)
  fieldOrder   Int
  unitLabel    String?
  fieldOptions String[]             @default([])
  values       LogSubmissionValue[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([templateId, fieldOrder])
  @@index([templateId])
}

model LogAssignment {
  id             String          @id @default(cuid())
  unitId         String
  unit           Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  templateId     String
  template       LogTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recurrence     LogRecurrence
  mealType       MealType?
  timesPerDay    Int             @default(1)
  requiredRole   RoleKey?
  isActive       Boolean         @default(true)
  effectiveStart DateTime        @default(now())
  effectiveEnd   DateTime?
  submissions    LogSubmission[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([unitId, isActive])
  @@index([templateId, isActive])
}

model LogSubmission {
  id                    String               @id @default(cuid())
  assignmentId          String
  assignment            LogAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  unitId                String
  unit                  Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  templateId            String
  template              LogTemplate          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  serviceDate           DateTime
  mealType              MealType?
  submittedById         String?
  submittedBy           User?                @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  submittedByEmployeeId String?
  submittedByEmployee   Employee?            @relation("SubmissionByEmployee", fields: [submittedByEmployeeId], references: [id], onDelete: SetNull)
  status                LogSubmissionStatus  @default(COMPLETED)
  notes                 String?
  correctiveAction      String?
  values                LogSubmissionValue[]
  attachments           Attachment[]
  submittedAt           DateTime             @default(now())

  @@index([unitId, serviceDate])
  @@index([templateId, serviceDate])
  @@index([submittedById])
  @@index([submittedByEmployeeId])
}

model LogSubmissionValue {
  id            String           @id @default(cuid())
  submissionId  String
  submission    LogSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fieldId       String
  field         LogTemplateField @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  valueText     String?
  valueNumber   Float?
  valueBoolean  Boolean?
  valueDateTime DateTime?
  createdAt     DateTime         @default(now())

  @@index([submissionId])
  @@index([fieldId])
}

model WorkShift {
  id                  String                          @id @default(cuid())
  facilityId          String
  facility            Facility                        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId        String?
  department          Department?                     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name                String
  startLocal          String
  endLocal            String
  sortOrder           Int                             @default(100)
  isActive            Boolean                         @default(true)
  scheduleEntries     ScheduleEntry[]
  assignmentTemplates OperationalAssignmentTemplate[]
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@index([facilityId])
  @@index([departmentId])
}

/// LEGACY / SUPERSEDED. Rolling nextDueAt is not canonical PM.
/// Canonical identity is PreventiveMaintenancePlan. Do not generate from this table.
model PreventiveMaintenanceSchedule {
  id            String                       @id @default(cuid())
  facilityId    String
  facility      Facility                     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset                        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  departmentId  String?
  department    Department?                  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name          String
  cadence       PreventiveMaintenanceCadence
  intervalCount Int                          @default(1)
  nextDueAt     DateTime
  isActive      Boolean                      @default(true)
  repairs       Repair[]
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@index([facilityId])
  @@index([assetId])
  @@index([departmentId])
  @@index([nextDueAt])
}

/// Canonical PM Plan identity. One Asset. No schedule fields on this row.
/// Asset RETIRED does not mutate Plan status. Plan RETIRED is an explicit configuration action.
model PreventiveMaintenancePlan {
  id              String                          @id @default(cuid())
  facilityId      String
  facility        Facility                        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department                      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  assetId         String
  asset           Asset                           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  status          PreventiveMaintenancePlanStatus @default(DRAFT)
  retiredAt       DateTime?
  retiredByUserId String?
  retiredByUser   User?                           @relation("PmPlanRetiredBy", fields: [retiredByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdByUser   User?                           @relation("PmPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  versions        PreventiveMaintenancePlanVersion[]
  occurrences     PreventiveMaintenanceOccurrence[]
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  @@index([facilityId, status])
  @@index([departmentId, status])
  @@index([assetId, status])
  @@index([retiredByUserId])
  @@index([createdByUserId])
}

/// Immutable published PM configuration. DRAFT is editable in place. Edits of published rows create a successor.
model PreventiveMaintenancePlanVersion {
  id                         String                                  @id @default(cuid())
  planId                     String
  plan                       PreventiveMaintenancePlan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  version                    Int
  status                     PreventiveMaintenancePlanVersionStatus  @default(DRAFT)
  createdFromVersionId       String?
  createdFromVersion         PreventiveMaintenancePlanVersion?       @relation("PmPlanVersionSuccessor", fields: [createdFromVersionId], references: [id], onDelete: SetNull)
  successors                 PreventiveMaintenancePlanVersion[]      @relation("PmPlanVersionSuccessor")
  name                       String
  instructions               String?
  maintenanceCategoryId      String?
  maintenanceCategory        MaintenanceCategory?                    @relation(fields: [maintenanceCategoryId], references: [id], onDelete: Restrict)
  intervalMonths             Int                                     @default(1)
  /// Facility-local civil date. Alignment for intervalMonths, not a rolling next-due.
  anchorDate                 DateTime                                @db.Date
  /// Facility-local civil date. Null on DRAFT until first publish.
  effectiveDate              DateTime?                               @db.Date
  generationLeadDays         Int                                     @default(7)
  priority                   RepairPriority                          @default(MEDIUM)
  procedureVersionId         String?
  procedureVersion           KnowledgeArticleVersion?                @relation(fields: [procedureVersionId], references: [id], onDelete: Restrict)
  defaultAssignedEmployeeId  String?
  defaultAssignedEmployee    Employee?                               @relation("PmPlanVersionDefaultAssignee", fields: [defaultAssignedEmployeeId], references: [id], onDelete: SetNull)
  publishedAt                DateTime?
  publishedByUserId          String?
  publishedByUser            User?                                   @relation("PmPlanVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  recordRequirements         PreventiveMaintenancePlanRecordRequirement[]
  occurrences                PreventiveMaintenanceOccurrence[]
  createdAt                  DateTime                                @default(now())
  updatedAt                  DateTime                                @updatedAt

  @@unique([planId, version])
  @@index([planId, status])
  @@index([maintenanceCategoryId])
  @@index([procedureVersionId])
  @@index([defaultAssignedEmployeeId])
  @@index([publishedByUserId])
  @@index([createdFromVersionId])
}

/// Pins an exact published OperationalTemplate version onto a PM Plan Version.
model PreventiveMaintenancePlanRecordRequirement {
  id                String                          @id @default(cuid())
  planVersionId     String
  planVersion       PreventiveMaintenancePlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  templateId        String
  template          OperationalTemplate             @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateStableKey String
  templateVersion   Int
  templateName      String
  sortOrder         Int                             @default(0)
  createdAt         DateTime                        @default(now())

  @@unique([planVersionId, templateId])
  @@index([templateId])
}

/// Durable PM obligation. Unique (planId, scheduledDate) is the idempotency boundary.
/// planVersionId is frozen at materialization and never changes.
/// Projected future dates are not rows.
/// Active Work Order uniqueness is Repair_pmOccurrenceId_active_key (SQL partial unique).
model PreventiveMaintenanceOccurrence {
  id                    String                                  @id @default(cuid())
  planId                String
  plan                  PreventiveMaintenancePlan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  planVersionId         String
  planVersion           PreventiveMaintenancePlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  scheduledDate         DateTime                                @db.Date
  status                PreventiveMaintenanceOccurrenceStatus   @default(OPEN)
  skippedAt             DateTime?
  skippedByUserId       String?
  skippedByUser         User?                                   @relation("PmOccurrenceSkippedBy", fields: [skippedByUserId], references: [id], onDelete: SetNull)
  skipReason            String?
  completedAt           DateTime?
  completedWorkOrderId  String?                                 @unique
  completedWorkOrder    Repair?                                 @relation("PmOccurrenceCompletedWorkOrder", fields: [completedWorkOrderId], references: [id], onDelete: SetNull)
  workOrders            Repair[]                                @relation("PmOccurrenceWorkOrders")
  createdAt             DateTime                                @default(now())
  updatedAt             DateTime                                @updatedAt

  @@unique([planId, scheduledDate])
  @@index([planVersionId])
  @@index([status, scheduledDate])
  @@index([skippedByUserId])
}

model RoomAreaStatus {
  id                  String                    @id @default(cuid())
  facilityId          String
  facility            Facility                  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  unitId              String
  unit                Unit                      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  statusDate          DateTime                  @db.Date
  status              RoomAreaOperationalStatus
  notes               String?
  updatedByEmployeeId String?
  updatedByEmployee   Employee?                 @relation(fields: [updatedByEmployeeId], references: [id], onDelete: SetNull)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([unitId, statusDate])
  @@index([facilityId])
  @@index([unitId, statusDate])
  @@index([updatedByEmployeeId])
}

model Attachment {
  id                  String               @id @default(cuid())
  facilityId          String
  facility            Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  parentKind          AttachmentParentKind
  logSubmissionId     String?
  logSubmission       LogSubmission?       @relation(fields: [logSubmissionId], references: [id], onDelete: Cascade)
  repairId            String?
  repair              Repair?              @relation(fields: [repairId], references: [id], onDelete: Cascade)
  assetId             String?
  asset               Asset?               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileRelativePath    String
  originalFilename    String
  mimeType            String
  createdByUserId     String?
  createdByUser       User?                @relation("AttachmentCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByEmployeeId String?
  createdByEmployee   Employee?            @relation("AttachmentCreatedByEmployee", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now())

  @@index([facilityId])
  @@index([logSubmissionId])
  @@index([repairId])
  @@index([assetId])
  @@index([createdByUserId])
  @@index([createdByEmployeeId])
}

/// Additive Work Engine projection. LogSubmission / Repair remain source of truth.
model Task {
  id                    String                 @id @default(cuid())
  facilityId            String
  facility              Facility               @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId          String?
  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  unitId                String?
  unit                  Unit?                  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  operationInstanceId   String?
  operationInstance     OperationInstance?     @relation(fields: [operationInstanceId], references: [id], onDelete: SetNull)
  type                  TaskType
  title                 String
  description           String?
  status                TaskStatus             @default(OPEN)
  priority              TaskPriority           @default(MEDIUM)
  dueAt                 DateTime?
  completedAt           DateTime?
  assignedEmployeeId    String?
  assignedEmployee      Employee?              @relation("TaskAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  sourceType            TaskSourceType
  sourceId              String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  inspectionSubmissions InspectionSubmission[]
  inspectionOccurrences InspectionOccurrence[]

  @@unique([facilityId, sourceType, sourceId])
  @@index([facilityId, status])
  @@index([facilityId, type])
  @@index([unitId])
  @@index([departmentId])
  @@index([assignedEmployeeId])
  @@index([operationInstanceId])
  @@index([dueAt])
}

/// Native Work Engine inspection checklist definition (distinct from LogTemplate).
model InspectionDefinition {
  id                    String                                 @id @default(cuid())
  facilityId            String
  facility              Facility                               @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId          String?
  department            Department?                            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  unitId                String?
  unit                  Unit?                                  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  name                  String
  description           String?
  /// Optional free-text notes; structured scheduling uses cadenceType / dueTimeLocal / daysOfWeek / dayOfMonth.
  frequency             String?
  cadenceType           InspectionCadenceType                  @default(ON_DEMAND)
  /// Facility-local due wall time "HH:MM". Null defaults to 09:00 for generated occurrences.
  dueTimeLocal          String?
  /// Weekday numbers for WEEKLY cadence: 0=Sunday … 6=Saturday (facility-local).
  daysOfWeek            Int[]                                  @default([])
  /// 1–31 for MONTHLY cadence (facility-local). Clamped to last day of short months.
  dayOfMonth            Int?
  activeFrom            DateTime?                              @db.Date
  activeUntil           DateTime?                              @db.Date
  /// Last facility-local service date the generator has materialized through.
  lastGeneratedThrough  DateTime?                              @db.Date
  isActive              Boolean                                @default(true)
  items                 InspectionDefinitionItem[]
  submissions           InspectionSubmission[]
  occurrences           InspectionOccurrence[]
  knowledgeArticleLinks KnowledgeArticleInspectionDefinition[]
  createdAt             DateTime                               @default(now())
  updatedAt             DateTime                               @updatedAt

  @@unique([facilityId, name])
  @@index([facilityId, isActive])
  @@index([facilityId, cadenceType, isActive])
  @@index([departmentId])
  @@index([unitId])
}

/// One scheduled inspection occurrence per definition + facility-local service date.
model InspectionOccurrence {
  id           String                     @id @default(cuid())
  definitionId String
  definition   InspectionDefinition       @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  facilityId   String
  facility     Facility                   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  unitId       String?
  unit         Unit?                      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  /// Facility-local calendar day as UTC-midnight @db.Date.
  serviceDate  DateTime                   @db.Date
  dueAt        DateTime
  status       InspectionOccurrenceStatus @default(OPEN)
  taskId       String?
  task         Task?                      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  submission   InspectionSubmission?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([definitionId, serviceDate])
  @@index([facilityId, status, dueAt])
  @@index([facilityId, serviceDate])
  @@index([unitId, status])
  @@index([departmentId])
  @@index([taskId])
}

model InspectionDefinitionItem {
  id                     String                     @id @default(cuid())
  definitionId           String
  definition             InspectionDefinition       @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  label                  String
  description            String?
  sortOrder              Int
  isRequired             Boolean                    @default(true)
  responseType           InspectionResponseType
  failureCreatesFollowUp Boolean                    @default(false)
  submissionItems        InspectionSubmissionItem[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([definitionId, sortOrder])
  @@index([definitionId])
}

model InspectionSubmission {
  id                    String                     @id @default(cuid())
  facilityId            String
  facility              Facility                   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  definitionId          String
  definition            InspectionDefinition       @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  unitId                String?
  unit                  Unit?                      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  operationInstanceId   String?
  operationInstance     OperationInstance?         @relation(fields: [operationInstanceId], references: [id], onDelete: SetNull)
  /// When set, this submission completes the linked scheduled occurrence (no duplicate execution Task).
  occurrenceId          String?                    @unique
  occurrence            InspectionOccurrence?      @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  submittedByEmployeeId String?
  submittedByEmployee   Employee?                  @relation("InspectionSubmittedByEmployee", fields: [submittedByEmployeeId], references: [id], onDelete: SetNull)
  submittedAt           DateTime                   @default(now())
  result                InspectionResult
  notes                 String?
  /// Optional link to projected Task after sync (Task remains keyed by sourceType/sourceId).
  taskId                String?
  task                  Task?                      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// Caller-supplied key to make retries idempotent within a facility.
  idempotencyKey        String?
  items                 InspectionSubmissionItem[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@unique([facilityId, idempotencyKey])
  @@index([facilityId, submittedAt])
  @@index([definitionId, submittedAt])
  @@index([unitId])
  @@index([operationInstanceId])
  @@index([submittedByEmployeeId])
  @@index([taskId])
  @@index([result])
  @@index([occurrenceId])
}

model InspectionSubmissionItem {
  id               String                   @id @default(cuid())
  submissionId     String
  submission       InspectionSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  definitionItemId String
  definitionItem   InspectionDefinitionItem @relation(fields: [definitionItemId], references: [id], onDelete: Restrict)
  /// For PASS_FAIL / YES_NO: true = pass/yes, false = fail/no.
  passed           Boolean?
  valueText        String?
  valueNumber      Float?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([submissionId, definitionItemId])
  @@index([submissionId])
  @@index([definitionItemId])
}

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Version lifecycle for immutable published Knowledge content. Distinct from article head status.
enum KnowledgeArticleVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum KnowledgeArticleCategory {
  SOP
  EQUIPMENT
  LOCATION
  SAFETY
  COMPLIANCE
  TROUBLESHOOTING
  TRAINING
  REFERENCE
  OTHER
}

enum KnowledgeSourceType {
  MANUAL
  HANDBOOK
  VENDOR
  POLICY
  INCIDENT_LESSON
  OTHER
}

/// Operational knowledge article — facility source of truth for SOPs and reference content.
model KnowledgeArticle {
  id                        String                                 @id @default(cuid())
  facilityId                String
  facility                  Facility                               @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId              String?
  department                Department?                            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  title                     String
  summary                   String?
  body                      String
  status                    KnowledgeArticleStatus                 @default(DRAFT)
  category                  KnowledgeArticleCategory
  sourceType                KnowledgeSourceType                    @default(MANUAL)
  createdByUserId           String?
  createdBy                 User?                                  @relation("KnowledgeArticleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId           String?
  updatedBy                 User?                                  @relation("KnowledgeArticleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  publishedAt               DateTime?
  archivedAt                DateTime?
  unitLinks                 KnowledgeArticleUnit[]
  assetLinks                KnowledgeArticleAsset[]
  logTemplateLinks          KnowledgeArticleLogTemplate[]
  inspectionDefinitionLinks KnowledgeArticleInspectionDefinition[]
  workItemLinks             DepartmentWorkItem[]
  versions                  KnowledgeArticleVersion[]
  createdAt                 DateTime                               @default(now())
  updatedAt                 DateTime                               @updatedAt

  @@index([facilityId, status])
  @@index([facilityId, category])
  @@index([facilityId, departmentId])
  @@index([facilityId, status, category])
}

/// Immutable published Knowledge content identity. Article.id stays the stable resource.
/// Not every article is a Procedure — category (SOP / REFERENCE / TRAINING / …) remains on the article.
model KnowledgeArticleVersion {
  id                   String                         @id @default(cuid())
  articleId            String
  article              KnowledgeArticle               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version              Int
  status               KnowledgeArticleVersionStatus  @default(DRAFT)
  title                String
  summary              String?
  body                 String
  createdByUserId      String?
  createdBy            User?                          @relation("KnowledgeArticleVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedAt          DateTime?
  archivedAt           DateTime?
  createdFromVersionId String?
  createdFromVersion   KnowledgeArticleVersion?       @relation("KnowledgeArticleVersionSuccessor", fields: [createdFromVersionId], references: [id], onDelete: SetNull)
  successors           KnowledgeArticleVersion[]      @relation("KnowledgeArticleVersionSuccessor")
  pinnedWorkOrders     Repair[]
  pmPlanVersions       PreventiveMaintenancePlanVersion[]
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  @@unique([articleId, version])
  @@index([articleId, status])
  @@index([createdFromVersionId])
}

model KnowledgeArticleUnit {
  id        String           @id @default(cuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([articleId, unitId])
  @@index([unitId])
}

model KnowledgeArticleAsset {
  id        String           @id @default(cuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([articleId, assetId])
  @@index([assetId])
}

model KnowledgeArticleLogTemplate {
  id            String           @id @default(cuid())
  articleId     String
  article       KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  logTemplateId String
  logTemplate   LogTemplate      @relation(fields: [logTemplateId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())

  @@unique([articleId, logTemplateId])
  @@index([logTemplateId])
}

model KnowledgeArticleInspectionDefinition {
  id                     String               @id @default(cuid())
  articleId              String
  article                KnowledgeArticle     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  inspectionDefinitionId String
  inspectionDefinition   InspectionDefinition @relation(fields: [inspectionDefinitionId], references: [id], onDelete: Cascade)
  createdAt              DateTime             @default(now())

  @@unique([articleId, inspectionDefinitionId])
  @@index([inspectionDefinitionId])
}

enum AiBriefStatus {
  READY
  FALLBACK
  FAILED
}

enum AiBriefType {
  MORNING_BRIEF
  SHIFT_TRANSITION
  RECOVERY_ASSISTANT
}

/// Cached Operational AI brief (Wave 10). Stores sanitized result (+ optional snapshot) — not raw prompts.
model AiOperationalBrief {
  id                   String        @id @default(cuid())
  facilityId           String
  facility             Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// Operational department key or "ALL" for facility-wide leadership view.
  departmentKey        String
  /// Facility-local service date as UTC-midnight @db.Date.
  serviceDate          DateTime      @db.Date
  briefType            AiBriefType   @default(MORNING_BRIEF)
  operationInstanceId  String?
  snapshotHash         String
  /// Sanitized operational snapshot used for baseline diffs (privacy-minimized).
  snapshotJson         Json?
  baselineSnapshotHash String?
  windowStart          DateTime?
  windowEnd            DateTime?
  resultJson           Json
  provider             String
  model                String
  status               AiBriefStatus @default(READY)
  promptVersion        String
  latencyMs            Int?
  errorCode            String?
  generatedAt          DateTime      @default(now())
  expiresAt            DateTime
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([facilityId, departmentKey, serviceDate, briefType, snapshotHash], map: "AiBrief_fac_dept_svc_type_hash_key")
  @@index([facilityId, departmentKey, serviceDate, briefType], map: "AiBrief_fac_dept_svc_type_idx")
  @@index([facilityId, briefType, generatedAt], map: "AiBrief_fac_type_generated_idx")
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Wave 14 — Scheduling & Assignment Engine
// ---------------------------------------------------------------------------

enum OperationalAssignmentStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OperationalAssignmentSource {
  MANUAL
  TEMPLATE
  COVERAGE
  REASSIGNMENT
  SCHEDULED_EMPLOYEE
  UNSCHEDULED_COVERAGE
  SUPERVISOR_OVERRIDE
  CALL_OFF_REPLACEMENT
  MANUAL_ADDITION
}

enum OperationalAssignmentPlanStatus {
  DRAFT
  CONFIRMED
  REOPENED
  CLOSED
}

/// Daily Assignment plan for a Facility + Department + operational date.
/// Separates draft preparation from the confirmed frontline Assignment plan.
model OperationalAssignmentPlan {
  id                           String                          @id @default(cuid())
  facilityId                   String
  facility                     Facility                        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId                 String
  department                   Department                      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  serviceDate                  DateTime                        @db.Date
  status                       OperationalAssignmentPlanStatus @default(DRAFT)
  confirmedByUserId            String?
  confirmedByUser              User?                           @relation("AssignmentPlanConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedAt                  DateTime?
  reopenedByUserId             String?
  reopenedByUser               User?                           @relation("AssignmentPlanReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: SetNull)
  reopenedAt                   DateTime?
  reopenReason                 String?
  closedByUserId               String?
  closedByUser                 User?                           @relation("AssignmentPlanClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  closedAt                     DateTime?
  coverageAcknowledgedAt       DateTime?
  coverageAcknowledgedByUserId String?
  coverageAcknowledgedByUser   User?                           @relation("AssignmentPlanCoverageAckBy", fields: [coverageAcknowledgedByUserId], references: [id], onDelete: SetNull)
  lastChangedByUserId          String?
  lastChangedByUser            User?                           @relation("AssignmentPlanLastChangedBy", fields: [lastChangedByUserId], references: [id], onDelete: SetNull)
  lastChangedAt                DateTime?
  assignments                  OperationalAssignment[]
  events                       OperationalAssignmentEvent[]
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt

  @@unique([facilityId, departmentId, serviceDate])
  @@index([facilityId, serviceDate])
  @@index([departmentId, serviceDate])
}

/// Lifecycle for a Department operational Zone (named location grouping).
/// Zone is never a physical location, Assignment, Work Plan, or authorization boundary.
enum DepartmentOperationalZoneStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// Named Facility + Department grouping of canonical UnitSpaces for Assignment convenience
/// and Supervisor filtering. Membership changes never rewrite existing Assignments.
model DepartmentOperationalZone {
  id                  String                               @id @default(cuid())
  facilityId          String
  facility            Facility                             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId        String
  department          Department                           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  status              DepartmentOperationalZoneStatus      @default(DRAFT)
  retiredAt           DateTime?
  createdByUserId     String?
  createdByUser       User?                                @relation("DepartmentZoneCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastChangedByUserId String?
  lastChangedByUser   User?                                @relation("DepartmentZoneLastChangedBy", fields: [lastChangedByUserId], references: [id], onDelete: SetNull)
  lastChangedAt       DateTime?
  locations           DepartmentOperationalZoneLocation[]
  assignmentsAsSource OperationalAssignment[]              @relation("AssignmentSourceZone")
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt

  @@unique([facilityId, departmentId, name])
  @@index([facilityId, departmentId, status])
  @@index([departmentId, status])
}

/// Zone membership: existing UnitSpace only (canonical Room / Space).
model DepartmentOperationalZoneLocation {
  id          String                    @id @default(cuid())
  zoneId      String
  zone        DepartmentOperationalZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  unitSpaceId String
  unitSpace   UnitSpace                 @relation(fields: [unitSpaceId], references: [id], onDelete: Cascade)
  /// Denormalized parent Unit for filtering (must match unitSpace.unitId when present).
  unitId      String?
  sortOrder   Int                       @default(100)
  createdAt   DateTime                  @default(now())

  @@unique([zoneId, unitSpaceId])
  @@index([unitSpaceId])
  @@index([unitId])
  @@index([zoneId, sortOrder])
}

/// Snapshotted Room / Space responsibility for one OperationalAssignment.
/// Empty set + unitId = unit-wide (Dietary / EVS whole Unit). Non-empty = explicit Spaces.
/// Zone membership edits never mutate these rows.
model OperationalAssignmentLocation {
  id            String                @id @default(cuid())
  assignmentId  String
  assignment    OperationalAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  unitSpaceId   String
  unitSpace     UnitSpace             @relation(fields: [unitSpaceId], references: [id], onDelete: Restrict)
  /// Denormalized parent Unit for filtering / coverage.
  unitId        String?
  /// Friendly label captured at Assignment write time (Room number + name).
  labelSnapshot String?
  sortOrder     Int                   @default(100)
  createdAt     DateTime              @default(now())

  @@unique([assignmentId, unitSpaceId])
  @@index([unitSpaceId])
  @@index([unitId])
  @@index([assignmentId, sortOrder])
}

/// Operational responsibility during a defined time or operation.
/// Separated from ScheduleEntry (attendance/hours) and AssignmentOverride (call-offs/moves).
model OperationalAssignment {
  id                  String                             @id @default(cuid())
  facilityId          String
  facility            Facility                           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId        String
  department          Department                         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  planId              String?
  plan                OperationalAssignmentPlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  employeeId          String
  employee            Employee                           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  unitId              String?
  unit                Unit?                              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  /// Optional Zone used as create-time convenience. Not live membership authority.
  sourceZoneId        String?
  sourceZone          DepartmentOperationalZone?         @relation("AssignmentSourceZone", fields: [sourceZoneId], references: [id], onDelete: SetNull)
  operationInstanceId String?
  operationInstance   OperationInstance?                 @relation(fields: [operationInstanceId], references: [id], onDelete: SetNull)
  templateItemId      String?
  templateItem        OperationalAssignmentTemplateItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  serviceDate         DateTime                           @db.Date
  roleKey             String
  roleLabel           String
  startsAt            DateTime?
  endsAt              DateTime?
  status              OperationalAssignmentStatus        @default(PLANNED)
  source              OperationalAssignmentSource        @default(MANUAL)
  notes               String?
  changeReason        String?
  /// Client-supplied idempotency key (unique per facility when present).
  clientCommandId     String?
  createdByUserId     String?
  createdByUser       User?                              @relation("AssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastChangedByUserId String?
  lastChangedByUser   User?                              @relation("AssignmentLastChangedBy", fields: [lastChangedByUserId], references: [id], onDelete: SetNull)
  lastChangedAt       DateTime?
  events              OperationalAssignmentEvent[]
  locations           OperationalAssignmentLocation[]
  createdAt           DateTime                           @default(now())
  updatedAt           DateTime                           @updatedAt

  @@unique([facilityId, clientCommandId])
  @@index([facilityId, serviceDate])
  @@index([departmentId, serviceDate])
  @@index([employeeId, serviceDate])
  @@index([unitId, serviceDate])
  @@index([sourceZoneId])
  @@index([operationInstanceId])
  @@index([templateItemId])
  @@index([planId])
}

/// Append-only audit log for assignment lifecycle changes.
model OperationalAssignmentEvent {
  id              String                     @id @default(cuid())
  /// Nullable for plan-level events (confirm / reopen / close / coverage ack).
  assignmentId    String?
  assignment      OperationalAssignment?     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  planId          String?
  plan            OperationalAssignmentPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  facilityId      String
  departmentId    String?
  employeeId      String?
  unitId          String?
  serviceDate     DateTime?                  @db.Date
  eventType       String
  actorUserId     String?
  actorUser       User?                      @relation("AssignmentEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorRole       String?
  authMethod      String?
  fromStatus      String?
  toStatus        String?
  summary         String
  reason          String?
  priorValuesJson String?
  newValuesJson   String?
  createdAt       DateTime                   @default(now())

  @@index([assignmentId, createdAt])
  @@index([planId, createdAt])
  @@index([facilityId, createdAt])
  @@index([departmentId, createdAt])
}

/// Build lifecycle for a reusable coverage expectation (assignment template).
/// Working edits use DRAFT. Runtime uses PUBLISHED rows effective on the service date.
enum OperationalAssignmentTemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// Reusable operating pattern describing required operational positions.
/// Phase 5B: this is the coverage expectation model (WHAT/HOW MANY/WHERE/WHEN).
/// Versions are immutable once PUBLISHED. Do not persist derived coverage state.
model OperationalAssignmentTemplate {
  id                    String                              @id @default(cuid())
  facilityId            String
  facility              Facility                            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId          String
  department            Department                          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Enduring identity across draft/published versions of the same expectation set.
  stableKey             String
  version               Int                                 @default(1)
  status                OperationalAssignmentTemplateStatus @default(DRAFT)
  name                  String
  description           String?
  isActive              Boolean                             @default(true)
  /// Inclusive start of effectiveness for coverage requirements. Null = already effective historically.
  effectiveFrom         DateTime?                           @db.Date
  /// Inclusive end of effectiveness. Null = not retired. Retired templates do not apply prospectively.
  effectiveTo           DateTime?                           @db.Date
  publishedAt           DateTime?
  operationDefinitionId String?
  operationDefinition   OperationDefinition?                @relation(fields: [operationDefinitionId], references: [id], onDelete: SetNull)
  workShiftId           String?
  workShift             WorkShift?                          @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  items                 OperationalAssignmentTemplateItem[]
  createdByUserId       String?
  createdByUser         User?                               @relation("TemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt

  @@unique([facilityId, departmentId, stableKey, version], map: "OATemplate_stable_version_key")
  @@index([facilityId, departmentId])
  @@index([facilityId, isActive])
  @@index([facilityId, departmentId, stableKey, status], map: "OATemplate_stable_status_idx")
  @@index([facilityId, departmentId, effectiveFrom, effectiveTo])
}

model OperationalAssignmentTemplateItem {
  id                                   String                        @id @default(cuid())
  templateId                           String
  template                             OperationalAssignmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  roleKey                              String
  roleLabel                            String
  unitId                               String?
  unit                                 Unit?                         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  /// DepartmentRoomArchetype.key targets. Empty = no OT inheritance (legacy unit/direct only).
  applicableOperationalTypeKeys        String[]                      @default([])
  /// DepartmentOperationalCycle.stableKey targets. Empty = no cycle constraint (legacy).
  applicableOperationalCycleStableKeys String[]                      @default([])
  startsAtLocal                        String?
  endsAtLocal                          String?
  requiredCount                        Int                           @default(1)
  sortOrder                            Int                           @default(100)
  notes                                String?
  assignments                          OperationalAssignment[]
  createdAt                            DateTime                      @default(now())
  updatedAt                            DateTime                      @updatedAt

  @@index([templateId, sortOrder])
}

/// Which credential surface a rate-limit bucket protects.
enum AuthRateLimitBucketType {
  /// One normalized email/password account.
  PASSWORD_ACCOUNT
  /// One submitted PIN value within one facility.
  PIN_CANDIDATE
  /// All PIN attempts within one facility; backstop against candidate rotation.
  PIN_FACILITY
}

/// Durable, cross-process authentication throttling. Shared by password and Quick PIN login so a
/// limit cannot be bypassed by reaching a different application instance, rotating a forwarded-IP
/// header, or clearing cookies. Rows hold only keyed hashes, never a credential (see
/// `lib/auth-rate-limit/keys.ts`), and are pruned by `cleanupAuthRateLimitBuckets`.
model AuthRateLimitBucket {
  id              String                  @id @default(cuid())
  /// HMAC of the throttled identity under `AUTH_SECRET`; never a raw email, PIN, or IP address.
  bucketKey       String                  @unique
  bucketType      AuthRateLimitBucketType
  /// Start of the current counting window; a failure after the window elapses restarts the count.
  windowStartedAt DateTime
  attemptCount    Int                     @default(0)
  /// Set once the threshold is reached; authentication is refused until this passes.
  lockedUntil     DateTime?
  lastAttemptAt   DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([bucketType, lockedUntil])
  @@index([lastAttemptAt])
}

enum OfflineConflictResolution {
  PENDING
  MARKED_DUPLICATE
  APPLIED_AS_CORRECTION
  REJECTED_WITH_REASON
}

/// Safe audit record when an offline Runtime bundle is issued to a tablet.
model OfflineBundleIssuance {
  id                     String            @id @default(cuid())
  facilityId             String
  unitId                 String
  actorUserId            String?
  actorUser              User?             @relation("OfflineBundleIssuanceActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmployeeId        String?
  actorEmployee          Employee?         @relation("OfflineBundleIssuanceActorEmployee", fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  actorRole              RoleKey
  authMethod             SessionAuthMethod
  deviceFacilityId       String
  deviceBoundUnitId      String?
  sessionVersion         Int
  bundleVersion          String
  serverRevision         String
  issuedAt               DateTime          @default(now())
  offlineAuthorizedUntil DateTime

  @@index([facilityId, unitId, issuedAt])
}

/// Transport audit for synchronized offline commands. Milestone history remains authoritative.
model OfflineSyncReceipt {
  id                String    @id @default(cuid())
  facilityId        String
  unitId            String
  clientCommandId   String
  commandType       String
  resultCategory    String
  reasonCode        String?
  actorUserId       String?
  actorUser         User?     @relation("OfflineSyncReceiptActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmployeeId   String?
  actorEmployee     Employee? @relation("OfflineSyncReceiptActorEmployee", fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  sessionVersion    Int
  deviceBoundUnitId String?
  locallyRecordedAt DateTime?
  serverAcceptedAt  DateTime?
  milestoneEntryId  String?
  evidenceRecordId  String?
  assetIssueId      String?
  createdAt         DateTime  @default(now())

  @@unique([facilityId, unitId, clientCommandId])
  @@index([facilityId, unitId, createdAt])
}

/// Persisted Milestone conflict requiring supervisor review.
model OfflineConflict {
  id                   String                    @id @default(cuid())
  facilityId           String
  unitId               String
  clientCommandId      String
  conflictCategory     String
  commandPayload       Json
  authoritativeState   Json
  reasonCode           String?
  resolution           OfflineConflictResolution @default(PENDING)
  resolvedByUserId     String?
  resolvedByUser       User?                     @relation("OfflineConflictResolvedByUser", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedByEmployeeId String?
  resolvedByEmployee   Employee?                 @relation("OfflineConflictResolvedByEmployee", fields: [resolvedByEmployeeId], references: [id], onDelete: SetNull)
  resolutionReason     String?
  resolvedAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([facilityId, unitId, clientCommandId])
  @@index([facilityId, unitId, resolution])
}

// ---------------------------------------------------------------------------
// Phase 9A — Department-owned Operational Cycles (Dietary day phases)
// Separate from OperationDefinition / Operations Engine. Engine stays disabled.
// ---------------------------------------------------------------------------

/// Named phase of a Department operating day (e.g. Breakfast Preparation).
enum OperationalCycleType {
  PREPARATION
  SERVICE
  TRANSITION
  CLOSEOUT
  CUSTOM
}

/// Build lifecycle for an Operational Cycle definition.
enum OperationalCycleStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

/// How a cycle selects applicable locations.
enum OperationalCycleLocationMode {
  ALL_DEPARTMENT_UNITS
  /// Legacy Unit.unitType targeting — not used by new Department Builder UI.
  UNIT_TYPES
  /// Explicit Unit and/or UnitSpace targets (user-facing: Specific locations).
  EXPLICIT_UNITS
  /// Physical Facility Room Type preset key (e.g. kitchen). Compatibility only.
  /// Not the department Operational Type.
  ROOM_TYPE
  /// Canonical department Operational Type keys (DepartmentRoomArchetype.key).
  OPERATIONAL_TYPES
}

/// Department-owned Operational Cycle definition.
/// Configured service-start times live on DepartmentOperationalCycleMilestoneTime (versioned).
/// UnitMealTime remains a legacy Runtime compatibility table.
/// Occurrences for a given operational date are derived, not persisted.
/// Build node kinds: PERIOD (cycle/phase window) and KEY_TIME (checkpoint with time groups).
model DepartmentOperationalCycle {
  id                   String                               @id @default(cuid())
  facilityId           String
  facility             Facility                             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId         String
  department           Department                           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Stable identity across versions of the same logical cycle within a department.
  stableKey            String
  /// Logical parent cycle identity within the department. Null = top-level.
  /// Versioned with this row — Draft successors copy it; published rows are not mutated in place.
  parentStableKey      String?
  /// PERIOD = operating window (root = Operational Cycle, nested = Phase). KEY_TIME = checkpoint.
  nodeKind             OperationalCycleNodeKind             @default(PERIOD)
  /// Key Point only. Existing rows stay REQUIRED so current completion behavior remains readable.
  occurrenceTracking   OperationalCycleOccurrenceTracking   @default(REQUIRED)
  /// Key Point only. Existing rows stay LOCATION (room groups).
  keyPointGrain        OperationalCycleKeyPointGrain        @default(LOCATION)
  version              Int                                  @default(1)
  label                String
  description          String?
  cycleType            OperationalCycleType
  displaySequence      Int                                  @default(100)
  /// Facility-local wall-clock start (`HH:mm`). Required for PERIOD; null for KEY_TIME.
  startLocal           String?
  /// Facility-local wall-clock end (`HH:mm`). Required for PERIOD; null for KEY_TIME.
  endLocal             String?
  /// Structural overnight support; Phase 9A Dietary defaults remain same-day.
  overnight            Boolean                              @default(false)
  /// Facility-local weekdays: 0=Sunday … 6=Saturday.
  applicableDaysOfWeek Int[]
  effectiveFrom        DateTime                             @db.Date
  effectiveTo          DateTime?                            @db.Date
  mealType             MealType?
  locationMode         OperationalCycleLocationMode         @default(ALL_DEPARTMENT_UNITS)
  /// When true (nested PERIOD only), effective rooms come from the immediate parent.
  locationInheritFromParent Boolean                         @default(false)
  applicableUnitTypes  UnitType[]
  /// Facility Room Type preset key when locationMode = ROOM_TYPE (e.g. "servery").
  /// Legacy Build/Run compatibility — physical type, not Operational Type.
  roomTypeKey          String?
  /// Department Operational Type keys when locationMode = OPERATIONAL_TYPES.
  /// Keys match DepartmentRoomArchetype.key and stay stable across profile versions.
  applicableOperationalTypeKeys String[] @default([])
  /// Expected confirmations for SERVICE cycles (READY / SERVICE_STARTED). Absence ≠ failure.
  /// Legacy Run compatibility — not the primary new Build UX.
  expectedMilestones   ServeryMilestone[]
  status               OperationalCycleStatus               @default(DRAFT)
  createdByUserId      String?
  publishedByUserId    String?
  lastChangedByUserId  String?
  publishedAt          DateTime?
  retiredAt            DateTime?
  locations            DepartmentOperationalCycleLocation[]
  milestoneTimes       DepartmentOperationalCycleMilestoneTime[]
  keyTimeGroups        DepartmentOperationalCycleKeyTimeGroup[]
  dayExpectations      OperationalCycleDayExpectation[]
  keyTimeDayExpectations OperationalCycleKeyTimeDayExpectation[]
  timingAdjustments    OperationalCycleTimingAdjustment[]
  keyPointActuals      OperationalCycleKeyPointActual[]
  events               DepartmentOperationalCycleEvent[]
  createdAt            DateTime                             @default(now())
  updatedAt            DateTime                             @updatedAt

  @@unique([departmentId, stableKey, version])
  @@index([facilityId, departmentId, status])
  @@index([facilityId, departmentId, effectiveFrom])
  @@index([departmentId, displaySequence])
  @@index([departmentId, status, displaySequence])
  @@index([departmentId, roomTypeKey])
  @@index([departmentId, parentStableKey])
  @@index([departmentId, nodeKind])
}

/// Explicit Unit or Room applicability when locationMode = EXPLICIT_UNITS.
/// Exactly one of unitId / spaceId is set (enforced in SQL).
model DepartmentOperationalCycleLocation {
  id        String                     @id @default(cuid())
  cycleId   String
  cycle     DepartmentOperationalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  unitId    String?
  unit      Unit?                      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  spaceId   String?
  space     UnitSpace?                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime                   @default(now())

  @@unique([cycleId, unitId])
  @@unique([cycleId, spaceId])
  @@index([unitId])
  @@index([spaceId])
}

/// Versioned Key Time due-time group (Build). One Key Time node may have multiple groups.
model DepartmentOperationalCycleKeyTimeGroup {
  id              String                     @id @default(cuid())
  cycleId         String
  cycle           DepartmentOperationalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  /// Facility-local wall-clock due time (`HH:mm`).
  dueLocal        String
  displaySequence Int                        @default(100)
  rooms           DepartmentOperationalCycleKeyTimeGroupRoom[]
  dayExpectations OperationalCycleKeyTimeDayExpectation[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([cycleId, dueLocal])
  @@index([cycleId, displaySequence])
}

/// Room membership for one Key Time due-time group.
/// Denormalized cycleId enforces one room → one group per Key Time version.
model DepartmentOperationalCycleKeyTimeGroupRoom {
  id             String                                  @id @default(cuid())
  keyTimeGroupId String
  keyTimeGroup   DepartmentOperationalCycleKeyTimeGroup  @relation(fields: [keyTimeGroupId], references: [id], onDelete: Cascade)
  /// Parent KEY_TIME cycle version — unique with spaceId so a room cannot sit in two groups.
  cycleId        String
  spaceId        String
  space          UnitSpace                               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt      DateTime                                @default(now())

  @@unique([keyTimeGroupId, spaceId])
  @@unique([cycleId, spaceId])
  @@index([spaceId])
  @@index([cycleId])
}

/// Versioned configured milestone time at Neighborhood/Unit grain.
/// Tied to a cycle row (version). Recurs on every day the parent cycle applies.
/// Legacy Run compatibility — new Build Key Times do not dual-write here.
model DepartmentOperationalCycleMilestoneTime {
  id              String                     @id @default(cuid())
  cycleId         String
  cycle           DepartmentOperationalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  unitId          String
  unit            Unit                       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  milestone       ServeryMilestone
  configuredTime  String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@unique([cycleId, unitId, milestone])
  @@index([unitId])
}

/// Runtime meal-service timing for one operational date + cycle version + Neighborhood.
/// Configured time is a snapshot of the governing Build version. Adjusted time is today's
/// Run overlay. Actual occurrence remains on ServeryMealServiceEvent / ServeryMilestoneEntry.
model OperationalCycleDayExpectation {
  id                     String                     @id @default(cuid())
  facilityId             String
  facility               Facility                   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId           String
  department             Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Facility-local operational date (same grain as ServeryMealServiceEvent.serviceDate).
  serviceDate            DateTime                   @db.Date
  cycleId                String
  cycle                  DepartmentOperationalCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  cycleStableKey         String
  cycleVersion           Int
  cycleLabel             String
  mealType               MealType
  unitId                 String
  unit                   Unit                       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  milestone              ServeryMilestone
  /// Snapshot of Build configuredTime. Null = in scope, time not configured.
  configuredTime         String?
  /// Today's revised expected time. Null = use configuredTime.
  adjustedTime           String?
  adjustmentReason       String?
  adjustedAt             DateTime?
  adjustedByUserId       String?
  adjustedByUser         User?                      @relation("CycleDayExpectationAdjustedByUser", fields: [adjustedByUserId], references: [id], onDelete: SetNull)
  adjustedByEmployeeId   String?
  adjustedByEmployee     Employee?                  @relation("CycleDayExpectationAdjustedByEmployee", fields: [adjustedByEmployeeId], references: [id], onDelete: SetNull)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([serviceDate, cycleId, unitId, milestone])
  @@index([facilityId, departmentId, serviceDate])
  @@index([unitId, serviceDate])
  @@index([cycleId])
  @@index([adjustedByUserId])
  @@index([adjustedByEmployeeId])
}

/// Runtime Key Time expectation for one operational date + published KEY_TIME version + Room.
/// Configured due time is a snapshot of the governing Key Time group. Adjusted/actual are
/// today's Run overlays. Build Key Time groups are never mutated from Run.
model OperationalCycleKeyTimeDayExpectation {
  id                   String                     @id @default(cuid())
  facilityId           String
  facility             Facility                   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId         String
  department           Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Facility-local operational date (same grain as meal day expectations).
  serviceDate          DateTime                   @db.Date
  cycleId              String
  cycle                DepartmentOperationalCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  cycleStableKey       String
  cycleVersion         Int
  cycleLabel           String
  /// Frozen parent PERIOD label for Run display (e.g. Breakfast). Null when top-level Key Time.
  parentCycleLabel     String?
  /// Frozen display path (e.g. Breakfast → Breakfast Due).
  displayPath          String
  keyTimeGroupId       String
  keyTimeGroup         DepartmentOperationalCycleKeyTimeGroup @relation(fields: [keyTimeGroupId], references: [id], onDelete: Restrict)
  spaceId              String
  space                UnitSpace                  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// Snapshot of Build group dueLocal (HH:mm).
  configuredDueLocal   String
  /// Today's revised expected due time. Null = use configuredDueLocal.
  adjustedDueLocal     String?
  adjustmentReason     String?
  adjustedAt           DateTime?
  adjustedByUserId     String?
  adjustedByUser       User?                      @relation("KeyTimeDayExpectationAdjustedByUser", fields: [adjustedByUserId], references: [id], onDelete: SetNull)
  adjustedByEmployeeId String?
  adjustedByEmployee   Employee?                  @relation("KeyTimeDayExpectationAdjustedByEmployee", fields: [adjustedByEmployeeId], references: [id], onDelete: SetNull)
  /// When the Key Time was marked complete (facility-local HH:mm snapshot).
  actualDueLocal       String?
  completedAt          DateTime?
  completedByUserId    String?
  completedByUser      User?                      @relation("KeyTimeDayExpectationCompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)
  completedByEmployeeId String?
  completedByEmployee  Employee?                  @relation("KeyTimeDayExpectationCompletedByEmployee", fields: [completedByEmployeeId], references: [id], onDelete: SetNull)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([serviceDate, cycleId, spaceId])
  @@index([facilityId, departmentId, serviceDate])
  @@index([spaceId, serviceDate])
  @@index([cycleId])
  @@index([keyTimeGroupId])
  @@index([adjustedByUserId])
  @@index([adjustedByEmployeeId])
  @@index([completedByUserId])
  @@index([completedByEmployeeId])
}

/// Date-specific timing revision. Does not modify the published Cycle version.
/// One row per adjustment. Children are not offset implicitly.
model OperationalCycleTimingAdjustment {
  id                 String                     @id @default(cuid())
  facilityId         String
  departmentId       String
  serviceDate        DateTime                   @db.Date
  cycleId            String
  cycle              DepartmentOperationalCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  cycleStableKey     String
  cycleVersion       Int
  adjustedStartLocal String?
  adjustedEndLocal   String?
  adjustedDueLocal   String?
  reason             String
  actorUserId        String?
  actorEmployeeId    String?
  recordedAt         DateTime                   @default(now())

  @@index([facilityId, departmentId, serviceDate])
  @@index([cycleStableKey, serviceDate])
  @@index([cycleId])
}

/// Append-only Key Point actuals. A correction inserts a new row; the original fact stays.
model OperationalCycleKeyPointActual {
  id               String                     @id @default(cuid())
  facilityId       String
  departmentId     String
  serviceDate      DateTime                   @db.Date
  cycleId          String
  cycle            DepartmentOperationalCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  cycleStableKey   String
  cycleVersion     Int
  /// Null for department-grain Key Points.
  spaceId          String?
  actualLocal      String
  recordedAt       DateTime                   @default(now())
  actorUserId      String?
  actorEmployeeId  String?
  /// Null on the original fact. Required when this row corrects an earlier actual.
  correctionReason String?
  correctsActualId String?

  @@index([facilityId, departmentId, serviceDate, cycleStableKey])
  @@index([cycleId, serviceDate])
  @@index([correctsActualId])
}

/// Append-only audit for Operational Cycle configuration changes.
model DepartmentOperationalCycleEvent {
  id           String                     @id @default(cuid())
  cycleId      String
  cycle        DepartmentOperationalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  facilityId   String
  departmentId String
  eventType    String
  actorUserId  String?
  actorLabel   String?
  detailJson   Json?
  createdAt    DateTime                   @default(now())

  @@index([cycleId, createdAt])
  @@index([facilityId, departmentId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 9C — Unified Operational Templates + Evidence Records (Dietary)
// Separate from legacy LogTemplate / InspectionDefinition. Operations Engine stays off.
// Requirement occurrences are derived for an operational date (not persisted).
// ---------------------------------------------------------------------------

/// Presentation / purpose type — one storage model for LOG, CHECKLIST, INSPECTION.
enum OperationalTemplatePurposeType {
  LOG
  CHECKLIST
  INSPECTION
}

enum OperationalTemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum OperationalEvidenceFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  TEMPERATURE
  YES_NO
  PASS_NEEDS_ATTENTION
  SINGLE_SELECT
  MULTI_SELECT
  DATE
  TIME
  ATTESTATION
  OPTIONAL_COMMENT
}

enum OperationalTemplateApplicabilityKind {
  SPECIFIC_ASSET
  ASSET_TYPE
  SPECIFIC_SPACE
  SPACE_TYPE
  DEPARTMENT_UNIT
}

enum OperationalTemplateScheduleKind {
  OPERATIONAL_CYCLE
  FIXED_DAILY_WINDOW
  ONCE_PER_OPERATIONAL_DATE
  AD_HOC
}

enum OperationalEvidenceRecordStatus {
  COMPLETED
  COMPLETED_WITH_CORRECTIVE_ACTION
  NEEDS_REVIEW
}

/// Unified Operational Template — authoritative evidence definition for Phase 9C.
/// Versioned via stableKey + version. Published versions are immutable; edits create successors.
model OperationalTemplate {
  id                  String                             @id @default(cuid())
  facilityId          String
  facility            Facility                           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId        String
  department          Department                         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Stable identity across versions within a department.
  stableKey           String
  version             Int                                @default(1)
  name                String
  description         String?
  instructions        String?
  purposeType         OperationalTemplatePurposeType
  status              OperationalTemplateStatus          @default(DRAFT)
  /// Optional preset key for synthetic Dietary reference drafts (never auto-published).
  presetKey           String?
  allowAdHoc          Boolean                            @default(false)
  createdByUserId     String?
  publishedByUserId   String?
  lastChangedByUserId String?
  publishedAt         DateTime?
  retiredAt           DateTime?
  fields              OperationalTemplateField[]
  applicabilities     OperationalTemplateApplicability[]
  schedules           OperationalTemplateSchedule[]
  events              OperationalTemplateEvent[]
  evidenceRecords     OperationalEvidenceRecord[]
  repairRecordRequirements RepairRecordRequirement[]
  pmPlanRecordRequirements PreventiveMaintenancePlanRecordRequirement[]
  createdAt           DateTime                           @default(now())
  updatedAt           DateTime                           @updatedAt

  @@unique([departmentId, stableKey, version])
  @@index([facilityId, departmentId, status])
  @@index([facilityId, departmentId, purposeType])
  @@index([departmentId, status, name])
}

model OperationalTemplateField {
  id                       String                       @id @default(cuid())
  templateId               String
  template                 OperationalTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Stable within a template lineage for mapping values across versions when needed.
  fieldKey                 String
  label                    String
  fieldType                OperationalEvidenceFieldType
  isRequired               Boolean                      @default(true)
  displaySequence          Int
  helpText                 String?
  unitLabel                String?
  minNumber                Float?
  maxNumber                Float?
  allowedSelections        String[]                     @default([])
  /// When true, out-of-standard results make corrective action visible.
  correctiveActionTrigger  Boolean                      @default(false)
  /// When true and triggered, corrective action text is required to submit.
  correctiveActionRequired Boolean                      @default(false)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@unique([templateId, fieldKey])
  @@unique([templateId, displaySequence])
  @@index([templateId])
}

model OperationalTemplateApplicability {
  id         String                               @id @default(cuid())
  templateId String
  template   OperationalTemplate                  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  kind       OperationalTemplateApplicabilityKind
  assetId    String?
  asset      Asset?                               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  /// Free-text equipment type match against Asset.equipmentType when kind=ASSET_TYPE.
  assetType  String?
  spaceId    String?
  space      UnitSpace?                           @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  spaceType  SpaceType?
  unitId     String?
  createdAt  DateTime                             @default(now())

  @@index([templateId])
  @@index([assetId])
  @@index([spaceId])
  @@index([unitId])
}

model OperationalTemplateSchedule {
  id               String                          @id @default(cuid())
  templateId       String
  template         OperationalTemplate             @relation(fields: [templateId], references: [id], onDelete: Cascade)
  kind             OperationalTemplateScheduleKind
  /// References DepartmentOperationalCycle.stableKey (not a copied window).
  cycleStableKey   String?
  /// Facility-local wall-clock window start (`HH:mm`) when kind=FIXED_DAILY_WINDOW.
  windowStartLocal String?
  /// Facility-local wall-clock window end (`HH:mm`) when kind=FIXED_DAILY_WINDOW.
  windowEndLocal   String?
  createdAt        DateTime                        @default(now())

  @@index([templateId])
  @@index([cycleStableKey])
}

model OperationalTemplateEvent {
  id           String              @id @default(cuid())
  templateId   String
  template     OperationalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  facilityId   String
  departmentId String
  eventType    String
  actorUserId  String?
  actorLabel   String?
  detailJson   Json?
  createdAt    DateTime            @default(now())

  @@index([templateId, createdAt])
  @@index([facilityId, departmentId, createdAt])
}

/// Persisted Evidence Record. Requirements are derived; records are durable.
/// templateSnapshotJson preserves published definition so later edits never rewrite history.
/// Canonical Attachment-backed Logs may omit templateId and set logAttachmentId + catalogDefinitionId.
model OperationalEvidenceRecord {
  id                           String                          @id @default(cuid())
  facilityId                   String
  facility                     Facility                        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  departmentId                 String
  department                   Department                      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  /// Published Phase 9C template version at capture time. Null for Catalog Attachment submissions.
  templateId                   String?
  template                     OperationalTemplate?            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// Canonical Catalog Attachment (nullable for legacy Phase 9C evidence).
  logAttachmentId              String?
  logAttachment                LogAttachment?                  @relation(fields: [logAttachmentId], references: [id], onDelete: SetNull)
  /// Denormalized Attachment lineage for historical reconstruction.
  attachmentStableKey          String?
  /// Published Catalog version row used at capture (Attachment-backed).
  catalogDefinitionId          String?
  catalogDefinition            CatalogLogDefinition?           @relation(fields: [catalogDefinitionId], references: [id], onDelete: SetNull)
  templateStableKey            String
  templateVersion              Int
  templateName                 String
  purposeType                  OperationalTemplatePurposeType
  /// Deterministic requirement identity for the operational date + scope + window.
  requirementKey               String
  /// Attachment-backed requirement key (nullable for legacy Phase 9C / ad hoc).
  logRequirementKey            String?
  operationalDate              DateTime                        @db.Date
  scheduleKind                 OperationalTemplateScheduleKind
  cycleStableKey               String?
  cycleLabel                   String?
  windowStartLocal             String?
  windowEndLocal               String?
  unitId                       String?
  unit                         Unit?                           @relation(fields: [unitId], references: [id], onDelete: Restrict)
  spaceId                      String?
  space                        UnitSpace?                      @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  /// Label the person saw for the place. Null when this Record predates name snapshots.
  placeLabelSnapshot           String?
  assetId                      String?
  asset                        Asset?                          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  status                       OperationalEvidenceRecordStatus @default(COMPLETED)
  outOfStandard                Boolean                         @default(false)
  correctiveActionText         String?
  correctiveActionAt           DateTime?
  correctiveActionByUserId     String?
  correctiveActionByEmployeeId String?
  occurredAt                   DateTime
  recordedAt                   DateTime                        @default(now())
  synchronizedAt               DateTime?
  recordedOnline               Boolean                         @default(true)
  clientCommandId              String?
  deviceBoundUnitId            String?
  recordedByUserId             String?
  recordedByUser               User?                           @relation("EvidenceRecordedByUser", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  recordedByEmployeeId         String?
  recordedByEmployee           Employee?                       @relation("EvidenceRecordedByEmployee", fields: [recordedByEmployeeId], references: [id], onDelete: SetNull)
  recordedByLabel              String?
  /// Acting authority at submit time. Null means this row predates provenance or was an internal action.
  /// Partner values are historical facts. They are not foreign keys, so a later partnership end does not erase them.
  actingAccessKind                    String?
  actingPartnerOrganizationId         String?
  actingFacilityPartnerOrganizationId String?
  actingEffectivePartnerRole          OrganizationPartnerRole?
  /// Later measurement. The originating Record stays unchanged.
  followsRecordId              String?
  followsRecord                OperationalEvidenceRecord?  @relation("EvidenceFollowUp", fields: [followsRecordId], references: [id], onDelete: SetNull)
  followUps                    OperationalEvidenceRecord[] @relation("EvidenceFollowUp")
  /// Immutable snapshot of template/Catalog fields/standards/instructions at submit time.
  /// Attachment-backed records use snapshotSchemaVersion >= 2 (LogSubmissionSnapshot).
  templateSnapshotJson         Json
  values                       OperationalEvidenceFieldValue[]
  corrections                  OperationalEvidenceCorrection[]
  assetIssueLinks              AssetIssueEvidenceLink[]
  originatedIssues             AssetIssue[]                    @relation("AssetIssueOriginEvidence")
  operationalRequestLinks      OperationalRequestEvidenceLink[]
  repairLinks                  RepairEvidenceLink[]
  satisfiedRepairRequirements  RepairRecordRequirement[]
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt

  @@unique([facilityId, departmentId, clientCommandId])
  @@index([facilityId, departmentId, operationalDate])
  @@index([facilityId, departmentId, templateStableKey, operationalDate])
  @@index([facilityId, unitId, operationalDate])
  @@index([facilityId, assetId, operationalDate])
  @@index([requirementKey, operationalDate])
  @@index([logAttachmentId, operationalDate])
  @@index([logRequirementKey, operationalDate])
  @@index([catalogDefinitionId])
  @@index([attachmentStableKey])
  @@index([followsRecordId])
  @@index([recordedByEmployeeId])
  @@index([status])
}

model OperationalEvidenceFieldValue {
  id              String                       @id @default(cuid())
  recordId        String
  record          OperationalEvidenceRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  fieldKey        String
  label           String
  fieldType       OperationalEvidenceFieldType
  valueText       String?
  valueNumber     Float?
  valueBoolean    Boolean?
  valueDateTime   DateTime?
  valueSelections String[]                     @default([])
  outOfStandard   Boolean                      @default(false)
  createdAt       DateTime                     @default(now())

  @@unique([recordId, fieldKey])
  @@index([recordId])
}

/// Append-preserving correction — never silently overwrites prior values.
model OperationalEvidenceCorrection {
  id                           String                          @id @default(cuid())
  recordId                     String
  record                       OperationalEvidenceRecord       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  reason                       String
  previousValuesJson           Json
  previousStatus               OperationalEvidenceRecordStatus
  previousCorrectiveActionText String?
  correctedByUserId            String?
  correctedByUser              User?                           @relation("EvidenceCorrectedByUser", fields: [correctedByUserId], references: [id], onDelete: SetNull)
  correctedByEmployeeId        String?
  correctedByEmployee          Employee?                       @relation("EvidenceCorrectedByEmployee", fields: [correctedByEmployeeId], references: [id], onDelete: SetNull)
  correctedByLabel             String?
  /// Acting authority for this correction only. Does not replace the submission's acting context.
  actingAccessKind                    String?
  actingPartnerOrganizationId         String?
  actingFacilityPartnerOrganizationId String?
  actingEffectivePartnerRole          OrganizationPartnerRole?
  createdAt                    DateTime                        @default(now())

  @@index([recordId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 11A — Department Work Plans / Operational Work
// Wave-era Task + Operations Engine remain isolated. These models are authoritative
// for Dietary Work when DIETARY_WORK_PLANS_ENABLED is on.
// ---------------------------------------------------------------------------

enum DepartmentWorkPlanStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum DepartmentWorkItemPriority {
  ROUTINE
  TIME_SENSITIVE
  URGENT
}

enum DepartmentWorkCompletionMode {
  EXPLICIT_CONFIRMATION
  LINKED_EVIDENCE
}

enum DepartmentWorkResponsibilityMode {
  UNIT_SHARED
  EACH_ASSIGNED_EMPLOYEE
}

enum DepartmentWorkScheduleKind {
  OPERATIONAL_CYCLE
  FIXED_DAILY_WINDOW
  ONCE_PER_OPERATIONAL_DATE
}

enum DepartmentWorkDueOffsetKind {
  CYCLE_START
  CYCLE_END
  MINUTES_BEFORE_CYCLE_END
}

enum DepartmentWorkApplicabilityKind {
  DEPARTMENT_UNIT
  SPECIFIC_UNIT
  SPECIFIC_SPACE
  SPACE_TYPE
  SPECIFIC_ASSET
  ASSET_TYPE
  /// Department operational type — DepartmentRoomArchetype.key (not physical SpaceType).
  OPERATIONAL_TYPE
}

enum DepartmentWorkOccurrenceSourceKind {
  WORK_PLAN
  ONE_OFF
}

enum DepartmentWorkOccurrenceStatus {
  OPEN
  COMPLETED
  COMPLETED_WITH_EVIDENCE
  NOT_REQUIRED
  CANCELLED
  REOPENED
}

enum DepartmentWorkEventType {
  CREATED
  COMPLETED
  COMPLETED_WITH_EVIDENCE
  NOT_REQUIRED
  REOPENED
  REASSIGNED
  CANCELLED
  CORRECTED
  CONFLICT
  OFFLINE_SYNCED
}

/// Versioned Department Work Plan — publish creates immutable historical versions.
model DepartmentWorkPlan {
  id                  String                   @id @default(cuid())
  facilityId          String
  facility            Facility                 @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId        String
  department          Department               @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Stable identity across versions within a department.
  stableKey           String
  version             Int                      @default(1)
  name                String
  description         String?
  status              DepartmentWorkPlanStatus @default(DRAFT)
  /// Optional preset key for synthetic Dietary draft presets (never auto-published).
  presetKey           String?
  /// Facility-local dates (dates only). Null start = immediate when published.
  effectiveStartDate  DateTime?                @db.Date
  effectiveEndDate    DateTime?                @db.Date
  /// Weekday numbers: 0=Sunday … 6=Saturday (facility-local). Empty = all days.
  weekdays            Int[]                    @default([])
  createdByUserId     String?
  createdByUser       User?                    @relation("WorkPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedByUserId   String?
  publishedByUser     User?                    @relation("WorkPlanPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  retiredByUserId     String?
  retiredByUser       User?                    @relation("WorkPlanRetiredBy", fields: [retiredByUserId], references: [id], onDelete: SetNull)
  lastChangedByUserId String?
  lastChangedByUser   User?                    @relation("WorkPlanLastChangedBy", fields: [lastChangedByUserId], references: [id], onDelete: SetNull)
  publishedAt         DateTime?
  retiredAt           DateTime?
  items               DepartmentWorkItem[]
  applicabilities     DepartmentWorkPlanApplicability[]
  events              DepartmentWorkPlanEvent[]
  occurrences         DepartmentWorkOccurrence[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([departmentId, stableKey, version])
  @@index([facilityId, departmentId, status])
  @@index([departmentId, status, name])
}

model DepartmentWorkPlanApplicability {
  id         String                         @id @default(cuid())
  workPlanId String
  workPlan   DepartmentWorkPlan             @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  kind       DepartmentWorkApplicabilityKind
  unitId     String?
  spaceId    String?
  spaceType  SpaceType?
  assetId    String?
  assetType  String?
  /// When kind=OPERATIONAL_TYPE — DepartmentRoomArchetype.key (stable, not display name).
  operationalTypeKey String?
  createdAt  DateTime                       @default(now())

  @@index([workPlanId])
  @@index([unitId])
  @@index([assetId])
  @@index([operationalTypeKey])
}

model DepartmentWorkItem {
  id                      String                            @id @default(cuid())
  workPlanId              String
  workPlan                DepartmentWorkPlan                @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  /// Stable within a Work Plan lineage for mapping across versions.
  itemKey                 String
  label                   String
  instructions            String?
  displaySequence         Int
  priority                DepartmentWorkItemPriority        @default(ROUTINE)
  completionMode          DepartmentWorkCompletionMode      @default(EXPLICIT_CONFIRMATION)
  responsibilityMode      DepartmentWorkResponsibilityMode  @default(UNIT_SHARED)
  scheduleKind            DepartmentWorkScheduleKind        @default(OPERATIONAL_CYCLE)
  /// When scheduleKind=OPERATIONAL_CYCLE — cycle stableKey(s).
  cycleStableKeys         String[]                          @default([])
  windowStartLocal        String?
  windowEndLocal          String?
  dueOffsetKind           DepartmentWorkDueOffsetKind?
  dueOffsetMinutes        Int?
  /// Optional roleKey filter; empty = all roles eligible under responsibility mode.
  roleKeys                String[]                          @default([])
  /// Optional location/asset narrowing beyond plan applicability.
  unitId                  String?
  spaceId                 String?
  assetId                 String?
  knowledgeArticleId      String?
  knowledgeArticle        KnowledgeArticle?                 @relation(fields: [knowledgeArticleId], references: [id], onDelete: SetNull)
  /// Snapshot of Procedure title at link / publish time.
  procedureTitleSnapshot  String?
  /// Linked Operational Template stableKey when completionMode=LINKED_EVIDENCE.
  linkedTemplateStableKey String?
  linkedTemplateId        String?
  supervisorVisible       Boolean                           @default(true)
  occurrences             DepartmentWorkOccurrence[]
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  @@unique([workPlanId, itemKey])
  @@index([workPlanId, displaySequence])
  @@index([knowledgeArticleId])
  @@index([linkedTemplateStableKey])
}

model DepartmentWorkPlanEvent {
  id             String             @id @default(cuid())
  workPlanId     String
  workPlan       DepartmentWorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)
  facilityId     String
  departmentId   String
  eventType      String
  actorUserId    String?
  actorLabel     String?
  detailJson     Json?
  createdAt      DateTime           @default(now())

  @@index([workPlanId, createdAt])
  @@index([facilityId, departmentId, createdAt])
}

/// Sparse runtime state — created when Work is acted on (or one-off created). Not pre-generated.
model DepartmentWorkOccurrence {
  id                         String                             @id @default(cuid())
  facilityId                 String
  facility                   Facility                           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId               String
  department                 Department                         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// Deterministic identity for idempotency (plan version + item + date + location + window + employee when needed).
  occurrenceKey              String
  sourceKind                 DepartmentWorkOccurrenceSourceKind @default(WORK_PLAN)
  operationalDate            DateTime                           @db.Date
  workPlanId                 String?
  workPlan                   DepartmentWorkPlan?                @relation(fields: [workPlanId], references: [id], onDelete: SetNull)
  workPlanStableKey          String?
  workPlanVersion            Int?
  workItemId                 String?
  workItem                   DepartmentWorkItem?                @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  workItemKey                String?
  workItemLabelSnapshot      String
  instructionsSnapshot       String?
  priority                   DepartmentWorkItemPriority         @default(ROUTINE)
  completionMode             DepartmentWorkCompletionMode       @default(EXPLICIT_CONFIRMATION)
  responsibilityMode         DepartmentWorkResponsibilityMode  @default(UNIT_SHARED)
  unitId                     String?
  unit                       Unit?                              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  spaceId                    String?
  space                      UnitSpace?                         @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  assetId                    String?
  asset                      Asset?                             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  cycleStableKey             String?
  windowStartLocal           String?
  windowEndLocal             String?
  dueAt                      DateTime?
  status                     DepartmentWorkOccurrenceStatus     @default(OPEN)
  assignedEmployeeId         String?
  assignedEmployee           Employee?                          @relation("WorkOccurrenceAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  originalAssignedEmployeeId String?
  originalAssignedEmployee   Employee?                          @relation("WorkOccurrenceOriginalAssignedEmployee", fields: [originalAssignedEmployeeId], references: [id], onDelete: SetNull)
  completedAt                DateTime?
  completedByUserId          String?
  completedByUser            User?                              @relation("WorkOccurrenceCompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)
  completedByEmployeeId      String?
  completedByEmployee        Employee?                          @relation("WorkOccurrenceCompletedByEmployee", fields: [completedByEmployeeId], references: [id], onDelete: SetNull)
  completedByLabel           String?
  recordedAt                 DateTime?
  synchronizedAt             DateTime?
  recordedOnline             Boolean                            @default(true)
  clientCommandId            String?
  deviceBoundUnitId         String?
  authenticationMethod       String?
  completionNote             String?
  evidenceRecordId           String?
  knowledgeArticleId         String?
  procedureTitleSnapshot     String?
  notRequiredReason          String?
  notRequiredAt              DateTime?
  notRequiredByUserId        String?
  notRequiredByUser          User?                              @relation("WorkOccurrenceNotRequiredByUser", fields: [notRequiredByUserId], references: [id], onDelete: SetNull)
  reassignedAt               DateTime?
  reassignedByUserId         String?
  reassignedByUser           User?                              @relation("WorkOccurrenceReassignedByUser", fields: [reassignedByUserId], references: [id], onDelete: SetNull)
  createdByUserId            String?
  createdByUser              User?                              @relation("WorkOccurrenceCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cancelReason               String?
  events                     DepartmentWorkEvent[]
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt

  @@unique([facilityId, departmentId, occurrenceKey])
  @@unique([facilityId, departmentId, clientCommandId])
  @@index([facilityId, departmentId, operationalDate])
  @@index([facilityId, unitId, operationalDate])
  @@index([facilityId, departmentId, status, operationalDate])
  @@index([assignedEmployeeId])
  @@index([workPlanId])
  @@index([workItemId])
}

model DepartmentWorkEvent {
  id                    String                    @id @default(cuid())
  occurrenceId          String
  occurrence            DepartmentWorkOccurrence  @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  facilityId            String
  departmentId          String
  eventType             DepartmentWorkEventType
  actorUserId           String?
  actorUser             User?                     @relation("WorkEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmployeeId       String?
  actorEmployee         Employee?                 @relation("WorkEventActorEmployee", fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  actorLabel            String?
  detailJson            Json?
  previousStatus        DepartmentWorkOccurrenceStatus?
  createdAt             DateTime                  @default(now())

  @@index([occurrenceId, createdAt])
  @@index([facilityId, departmentId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — Canonical Logs: LTC Corp Catalog + Facility Log Attachment
// Platform-owned Catalog (no facilityId). Facility-owned Attachments.
// RUN submissions remain OperationalEvidenceRecord with optional Attachment link.
// ---------------------------------------------------------------------------

enum CatalogLogStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum CatalogLogPurposeType {
  LOG
  CHECKLIST
  INSPECTION
  PROCEDURE
}

enum CatalogLogCategory {
  TEMPERATURE
  SANITATION
  CLEANING
  EQUIPMENT
  FOOD_SAFETY
  OPENING_CLOSING
  COMPLIANCE
  OTHER
}

enum CatalogRecommendedCadence {
  ONCE_DAILY
  TWICE_DAILY
  THREE_TIMES_DAILY
  ONCE_PER_OPERATIONAL_CYCLE
  WEEKLY
  MONTHLY
  AD_HOC
}

enum LogAttachmentStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum LogAttachmentTargetKind {
  ASSET
  SPACE
  UNIT
  DEPARTMENT
  FACILITY
  /// Department-scoped Operational Type (DepartmentRoomArchetype.key).
  OPERATIONAL_TYPE
}

enum LogAttachmentTimingMode {
  DAILY_WINDOWS
  OPERATIONAL_CYCLE
  CALENDAR
  AD_HOC
}

enum LogAttachmentCalendarCadence {
  DAILY
  WEEKLY
  MONTHLY
}

/// Platform / LTC Corp Catalog Log definition. No facilityId.
/// Versioned via stableKey + version. Published versions are immutable in service logic.
model CatalogLogDefinition {
  id                          String                          @id @default(cuid())
  stableKey                   String
  version                     Int                             @default(1)
  status                      CatalogLogStatus                @default(DRAFT)
  name                        String
  description                 String?
  instructions                String?
  purposeType                 CatalogLogPurposeType
  category                    CatalogLogCategory              @default(OTHER)
  recommendedCadence          CatalogRecommendedCadence?
  /// Optional schedule kind hint for Attachment default resolution.
  recommendedScheduleKind     OperationalTemplateScheduleKind?
  recommendedDaypartLabels    String[]                        @default([])
  /// Optional fixed HH:mm pairs when Catalog requires clock precision.
  recommendedFixedWindowsJson Json?
  /// Discovery hints: { assetTypes, spaceTypes, departmentKeys, keywords }. Suggestion only.
  suggestionsJson             Json                            @default("{}")
  publishedAt                 DateTime?
  retiredAt                   DateTime?
  fields                      CatalogLogField[]
  attachments                 LogAttachment[]
  facilityTypeLogDefaults     DepartmentFacilityTypeLogDefault[]
  facilityInstalls            FacilityCatalogInstall[]
  evidenceRecords             OperationalEvidenceRecord[]
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt

  @@unique([stableKey, version])
  @@index([status])
  @@index([purposeType, category])
  @@index([stableKey, status])
}

model CatalogLogField {
  id                       String                       @id @default(cuid())
  definitionId             String
  definition               CatalogLogDefinition         @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  fieldKey                 String
  label                    String
  fieldType                OperationalEvidenceFieldType
  isRequired               Boolean                      @default(true)
  displaySequence          Int
  helpText                 String?
  unitLabel                String?
  minNumber                Float?
  maxNumber                Float?
  allowedSelections        String[]                     @default([])
  correctiveActionTrigger  Boolean                      @default(false)
  correctiveActionRequired Boolean                      @default(false)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@unique([definitionId, fieldKey])
  @@unique([definitionId, displaySequence])
  @@index([definitionId])
}

/// Facility adopted a published Harbor Catalog LOG/CHECKLIST. Place (attach) is local.
model FacilityCatalogInstall {
  id                  String               @id @default(cuid())
  facilityId          String
  facility            Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  catalogDefinitionId String
  catalogDefinition   CatalogLogDefinition @relation(fields: [catalogDefinitionId], references: [id], onDelete: Restrict)
  catalogStableKey    String
  catalogVersion      Int
  installedAt         DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([facilityId, catalogStableKey])
  @@index([catalogStableKey])
  @@index([catalogDefinitionId])
}

/// Facility-owned binding of a published Catalog Log to an operational target.
model LogAttachment {
  id                  String                        @id @default(cuid())
  stableKey           String
  facilityId          String
  facility            Facility                      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId        String
  department          Department                    @relation("LogAttachmentOwningDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  catalogDefinitionId String
  catalogDefinition   CatalogLogDefinition          @relation(fields: [catalogDefinitionId], references: [id], onDelete: Restrict)
  catalogStableKey    String
  catalogVersion      Int
  status              LogAttachmentStatus           @default(ACTIVE)
  effectiveFrom       DateTime                      @db.Date
  effectiveTo         DateTime?                     @db.Date
  retiredAt           DateTime?
  localDisplayLabel   String?
  localInstructions   String?
  targetKind          LogAttachmentTargetKind
  assetId             String?
  asset               Asset?                        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  spaceId             String?
  space               UnitSpace?                    @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  unitId              String?
  unit                Unit?                         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  targetDepartmentId  String?
  targetDepartment    Department?                   @relation("LogAttachmentTargetDepartment", fields: [targetDepartmentId], references: [id], onDelete: Restrict)
  /// Stable Operational Type identity (DepartmentRoomArchetype.key). Not a display name.
  operationalTypeKey  String?
  timingMode          LogAttachmentTimingMode
  calendarCadence     LogAttachmentCalendarCadence?
  calendarDaysOfWeek  Int[]                         @default([])
  calendarDayOfMonth  Int?
  calendarDueTimeLocal String?
  allowAdHoc          Boolean                       @default(false)
  /// Declaration only. Phase E does not write waiver rows.
  waiverAllowed       Boolean                       @default(false)
  dailyWindows        LogAttachmentDailyWindow[]
  cycleSelections     LogAttachmentCycleSelection[]
  evidenceRecords     OperationalEvidenceRecord[]
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  @@unique([facilityId, stableKey])
  @@index([facilityId, departmentId, status])
  @@index([facilityId, catalogStableKey])
  @@index([catalogDefinitionId])
  @@index([assetId])
  @@index([spaceId])
  @@index([unitId])
  @@index([targetDepartmentId])
  @@index([operationalTypeKey])
  @@index([effectiveFrom])
}

model LogAttachmentDailyWindow {
  id              String        @id @default(cuid())
  attachmentId    String
  attachment      LogAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  label           String
  startLocal      String
  endLocal        String
  displaySequence Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([attachmentId, displaySequence])
  @@index([attachmentId])
}

model LogAttachmentCycleSelection {
  id              String        @id @default(cuid())
  attachmentId    String
  attachment      LogAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  cycleStableKey  String
  displaySequence Int           @default(100)
  createdAt       DateTime      @default(now())

  @@unique([attachmentId, cycleStableKey])
  @@index([attachmentId])
  @@index([cycleStableKey])
}

/// LTC Corp staff — Harbor Console only. Never a facility User / RoleKey.
enum PlatformStaffRole {
  OWNER
  MEMBER
}

enum HarborAuditAction {
  LOGIN
  VIEW_CUSTOMER
  WORK_SESSION_START
  WORK_SESSION_END
  CATALOG_CREATE
  CATALOG_PUBLISH
  CATALOG_RETIRE
  CATALOG_DRAFT_SUCCESSOR
  TICKET_OPEN
  TICKET_REPLY
}

enum ConsoleTicketStatus {
  OPEN
  WAITING_ON_CUSTOMER
  RESOLVED
}

model PlatformStaff {
  id             String            @id @default(cuid())
  email          String            @unique
  displayName    String
  passwordHash   String
  role           PlatformStaffRole @default(MEMBER)
  isActive       Boolean           @default(true)
  sessionVersion Int               @default(0)
  lastLoginAt    DateTime?
  auditEvents    HarborAuditEvent[]
  openedConsoleTickets ConsoleTicket[] @relation("ConsoleTicketOpenedBy")
  consoleTicketMessages ConsoleTicketMessage[]
  assignedSupportTickets SupportTicket[]
  supportTicketMessages  SupportTicketMessage[]
  supportTicketEvents    SupportTicketEvent[]
  createdSupportSavedReplies SupportSavedReply[]
  addedSupportTicketTags SupportTicketTag[]
  createdSupportMacros SupportMacro[] @relation("SupportMacroCreatedBy")
  assignedSupportMacros SupportMacro[] @relation("SupportMacroAssignedStaff")
  supportMacroApplications SupportMacroApplication[]
  supportNotifications SupportStaffNotification[]
  createdSupportAutomations SupportAutomationRule[]
  organizationClaimsApproved OrganizationClaimInvitation[] @relation("OrganizationClaimApprovedBy")
  organizationClaimsRejected OrganizationClaimInvitation[] @relation("OrganizationClaimRejectedBy")
  organizationClaimsRevoked  OrganizationClaimInvitation[] @relation("OrganizationClaimRevokedBy")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model HarborAuditEvent {
  id         String            @id @default(cuid())
  staffId    String
  staff      PlatformStaff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  action     HarborAuditAction
  facilityId String?
  createdAt  DateTime          @default(now())

  @@index([staffId, createdAt])
  @@index([facilityId, createdAt])
}

/// Legacy (transitional). Rows were copied into SupportTicket by 20261001130000_support_ticket;
/// no runtime code reads or writes this table. Drop in a later forward-only migration.
model ConsoleTicket {
  id              String              @id @default(cuid())
  facilityId      String
  facility        Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  subject         String
  status          ConsoleTicketStatus @default(OPEN)
  requesterEmail  String
  requesterName   String?
  openedByStaffId String
  openedByStaff   PlatformStaff       @relation("ConsoleTicketOpenedBy", fields: [openedByStaffId], references: [id], onDelete: Restrict)
  messages        ConsoleTicketMessage[]
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([facilityId, status, updatedAt])
  @@index([status, updatedAt])
}

/// Legacy (transitional). Rows were copied into SupportTicketMessage; no runtime use.
model ConsoleTicketMessage {
  id            String        @id @default(cuid())
  ticketId      String
  ticket        ConsoleTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body          String
  authorStaffId String
  authorStaff   PlatformStaff @relation(fields: [authorStaffId], references: [id], onDelete: Restrict)
  emailedAt     DateTime?
  createdAt     DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ── Customer support (Vssyl Console) ───────────────────────────────────────────
// Customer support for Vssyl itself. Facility operations stay on OperationalRequest / Repair /
// AssetIssue / Task. See docs/architecture/SUPPORT_TICKETS.md.

enum SupportTicketStatus {
  NEW
  OPEN
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketType {
  SUPPORT
  BUG
  FEATURE_REQUEST
  IMPROVEMENT
  ACCOUNT_ACCESS
  BILLING
  OTHER
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketMessageKind {
  INBOUND
  OUTBOUND
  NOTE
}

enum SupportMessageDeliveryStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  BOUNCED
  SPAM_COMPLAINT
}

enum SupportMacroAssignmentMode {
  UNCHANGED
  ME
  STAFF
  UNASSIGN
}

enum SupportStaffNotificationType {
  NEW_TICKET
  ASSIGNED_TO_ME
  CUSTOMER_REPLIED
  HIGH_PRIORITY
  URGENT_PRIORITY
  DELIVERY_FAILED
  BOUNCED
  SPAM_COMPLAINT
  UNASSIGNED_ALERT
}

enum SupportStaffNotificationEmailStatus {
  NOT_REQUIRED
  PENDING
  SENT
  FAILED
}

enum SupportAutomationType {
  WAITING_REMINDER
  WAITING_RESOLVE
  RESOLVED_CLOSE
  UNASSIGNED_ALERT
}

enum SupportAutomationAction {
  SEND_REMINDER
  RESOLVE_AFTER_WAIT
  CLOSE_RESOLVED
  ALERT_UNASSIGNED
}

enum SupportAutomationRunOutcome {
  CLAIMED
  APPLIED
  SKIPPED
  FAILED
}

enum SupportTicketEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNMENT_CHANGED
  PRIORITY_CHANGED
  TYPE_CHANGED
  FACILITY_CHANGED
  CONTACT_CHANGED
  SUBJECT_CHANGED
  EMAIL_BOUNCED
  EMAIL_COMPLAINT
  AUTOMATION_APPLIED
}

enum SupportAttachmentScanStatus {
  PENDING
  CLEAN
  BLOCKED
  SCAN_FAILED
}

enum SupportAttachmentRejectionReason {
  OVERSIZE
  INVALID_BASE64
  BLOCKED_TYPE
  STORAGE_UNAVAILABLE
  STORAGE_FAILED
}

/// Who a support ticket is from. Needs no Vssyl login; a user/facility link is a label for staff
/// and never grants authorization.
model SupportContact {
  id          String                 @id @default(cuid())
  /// Lowercased and trimmed.
  email       String                 @unique
  displayName String?
  userId      String?
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  facilityId  String?
  facility    Facility?              @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  tickets     SupportTicket[]
  messages    SupportTicketMessage[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId])
  @@index([facilityId])
}

model SupportTicket {
  id              String                 @id @default(cuid())
  /// Displayed as VSS-{number}. Sequence starts at 1001; never reused.
  number          Int                    @unique @default(autoincrement())
  /// Lowercase hex, at most 40 chars so `support+{token}@…` fits a 64-octet email local part.
  /// Reserved for inbound reply routing; never shown in the UI.
  replyToken      String                 @unique
  subject         String
  status          SupportTicketStatus    @default(NEW)
  /// Null until staff classify the ticket.
  type            SupportTicketType?
  priority        SupportTicketPriority  @default(NORMAL)
  contactId       String
  contact         SupportContact         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  facilityId      String?
  facility        Facility?              @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  assignedStaffId String?
  assignedStaff   PlatformStaff?         @relation(fields: [assignedStaffId], references: [id], onDelete: Restrict)
  messages        SupportTicketMessage[]
  events          SupportTicketEvent[]
  ticketTags      SupportTicketTag[]
  macroApplications SupportMacroApplication[]
  staffNotifications SupportStaffNotification[]
  automationRuns  SupportAutomationRun[]
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([status, updatedAt])
  @@index([assignedStaffId, status])
  @@index([facilityId])
  @@index([contactId])
}

/// INBOUND (customer email), OUTBOUND (Vssyl reply), or NOTE (internal). Per-kind required and
/// forbidden fields are enforced by CHECK constraints in the migration.
model SupportTicketMessage {
  id                 String                        @id @default(cuid())
  ticketId           String
  ticket             SupportTicket                 @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  kind               SupportTicketMessageKind
  authorStaffId      String?
  authorStaff        PlatformStaff?                @relation(fields: [authorStaffId], references: [id], onDelete: Restrict)
  contactId          String?
  contact            SupportContact?               @relation(fields: [contactId], references: [id], onDelete: Restrict)
  bodyText           String
  bodyHtml           String?
  strippedReplyText  String?
  fromEmail          String?
  fromName           String?
  toEmails           String[]                      @default([])
  ccEmails           String[]                      @default([])
  replyTo            String?
  subject            String?
  /// RFC 5322 Message-ID without angle brackets. Not unique: external mailers reuse values.
  internetMessageId  String?
  inReplyTo          String?
  references         String[]                      @default([])
  /// Postmark MessageID.
  providerMessageId  String?                       @unique
  inboundHeaders     Json?
  /// Attachment name/type/size only; contents are never stored here.
  attachmentManifest Json?
  deliveryStatus     SupportMessageDeliveryStatus?
  deliveryError      String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  bouncedAt          DateTime?
  complainedAt       DateTime?
  lastDeliveryEventAt DateTime?
  /// Postmark bounce Type (HardBounce, SoftBounce, Transient, …).
  bounceType         String?
  bounceCode         String?
  bounceDescription  String?
  complaintType      String?
  clientSubmissionId String?                       @unique
  receivedAt         DateTime?
  attachments        SupportTicketAttachment[]
  causedEvents       SupportTicketEvent[]
  staffNotifications SupportStaffNotification[]
  createdAt          DateTime                      @default(now())

  @@index([ticketId, createdAt])
  @@index([internetMessageId])
}

/// Binary for one inbound email attachment. Never stored on SupportTicket or in Postgres.
model SupportTicketAttachment {
  id               String                            @id @default(cuid())
  messageId        String
  message          SupportTicketMessage              @relation(fields: [messageId], references: [id], onDelete: Restrict)
  /// 0-based index in the inbound payload. Unique per message so Postmark retries do not duplicate.
  position         Int
  filename         String
  contentType      String
  sizeBytes        Int
  /// Opaque private object key. Never shown in Console or returned to customers.
  storageKey       String?
  checksumSha256   String?
  contentId        String?
  scanStatus       SupportAttachmentScanStatus
  rejectionReason  SupportAttachmentRejectionReason?
  createdAt        DateTime                          @default(now())

  @@unique([messageId, position])
  @@index([messageId])
}

/// Shared Harbor canned response. Insertion copies text into the draft; sent mail does not
/// reference this row. Not a macro: no automatic send, status, assignment, or tags.
model SupportSavedReply {
  id               String        @id @default(cuid())
  name             String
  body             String
  isActive         Boolean       @default(true)
  createdByStaffId String
  createdByStaff   PlatformStaff @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  macros           SupportMacro[]
  automations      SupportAutomationRule[]

  @@index([isActive, name])
}

/// Topic label for a support ticket. Distinct from Type (kind of request).
model SupportTag {
  id             String            @id @default(cuid())
  name           String
  /// Lowercased trimmed name; uniqueness is case-insensitive.
  normalizedName String            @unique
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tickets        SupportTicketTag[]
  macros         SupportMacroTag[]

  @@index([isActive, name])
}

model SupportTicketTag {
  ticketId       String
  ticket         SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId          String
  tag            SupportTag     @relation(fields: [tagId], references: [id], onDelete: Restrict)
  addedByStaffId String
  addedByStaff   PlatformStaff  @relation(fields: [addedByStaffId], references: [id], onDelete: Restrict)
  addedAt        DateTime       @default(now())

  @@id([ticketId, tagId])
  @@index([tagId, ticketId])
}

/// Harbor operator action bundle. Never auto-sends. Reply text comes from an optional Saved Reply.
model SupportMacro {
  id               String                      @id @default(cuid())
  name             String
  description      String?
  isActive         Boolean                     @default(true)
  savedReplyId     String?
  savedReply       SupportSavedReply?          @relation(fields: [savedReplyId], references: [id], onDelete: SetNull)
  /// Immediate status. WAITING_ON_CUSTOMER is not stored here when a Saved Reply is attached.
  status           SupportTicketStatus?
  /// Applied by sendSupportReply after the operator sends, not when the Macro is applied.
  statusAfterReply SupportTicketStatus?
  type             SupportTicketType?
  priority         SupportTicketPriority?
  assignmentMode   SupportMacroAssignmentMode  @default(UNCHANGED)
  assignedStaffId  String?
  assignedStaff    PlatformStaff?              @relation("SupportMacroAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: Restrict)
  createdByStaffId String
  createdByStaff   PlatformStaff               @relation("SupportMacroCreatedBy", fields: [createdByStaffId], references: [id], onDelete: Restrict)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  tags             SupportMacroTag[]
  applications     SupportMacroApplication[]

  @@index([isActive, name])
  @@index([savedReplyId])
}

model SupportMacroTag {
  macroId String
  macro   SupportMacro @relation(fields: [macroId], references: [id], onDelete: Cascade)
  tagId   String
  tag     SupportTag   @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([macroId, tagId])
  @@index([tagId])
}

/// One Harbor apply. Does not send mail. Macro name is snapshotted.
model SupportMacroApplication {
  id               String        @id @default(cuid())
  macroId          String
  macro            SupportMacro  @relation(fields: [macroId], references: [id], onDelete: Restrict)
  ticketId         String
  ticket           SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  appliedByStaffId String
  appliedByStaff   PlatformStaff @relation(fields: [appliedByStaffId], references: [id], onDelete: Restrict)
  appliedAt        DateTime      @default(now())
  macroName        String

  @@index([ticketId, appliedAt])
  @@index([macroId, appliedAt])
}

/// Harbor-only support inbox row. Not a generic platform notification.
model SupportStaffNotification {
  id          String                               @id @default(cuid())
  staffId     String
  staff       PlatformStaff                        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  type        SupportStaffNotificationType
  ticketId    String
  ticket      SupportTicket                        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId   String?
  message     SupportTicketMessage?                @relation(fields: [messageId], references: [id], onDelete: SetNull)
  /// Stable retry key: type + staff + source (ticket/message/transition). Not a timestamp.
  dedupeKey   String                               @unique
  title       String
  body        String
  isRead      Boolean                              @default(false)
  readAt      DateTime?
  emailStatus SupportStaffNotificationEmailStatus  @default(NOT_REQUIRED)
  emailSentAt DateTime?
  emailError  String?
  createdAt   DateTime                             @default(now())

  @@index([staffId, isRead, createdAt])
  @@index([staffId, createdAt])
  @@index([ticketId])
}

/// Harbor-configured time-based support action. Not a generic workflow engine.
model SupportAutomationRule {
  id               String                 @id @default(cuid())
  name             String
  type             SupportAutomationType
  /// New rules start inactive. Harbor must enable them explicitly.
  isActive         Boolean                @default(false)
  /// Elapsed real time in UTC minutes. Days are stored as days * 1440.
  delayMinutes     Int
  savedReplyId     String?
  savedReply       SupportSavedReply?     @relation(fields: [savedReplyId], references: [id], onDelete: Restrict)
  createdByStaffId String
  createdByStaff   PlatformStaff          @relation(fields: [createdByStaffId], references: [id], onDelete: Restrict)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  runs             SupportAutomationRun[]

  @@index([isActive, type])
  @@index([savedReplyId])
}

/// One claimed/attempted automation action. Unique dedupeKey prevents double-sends.
model SupportAutomationRun {
  id         String                       @id @default(cuid())
  ruleId     String
  rule       SupportAutomationRule        @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  ticketId   String
  ticket     SupportTicket                @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  action     SupportAutomationAction
  outcome    SupportAutomationRunOutcome
  dedupeKey  String                       @unique
  reason     String?
  messageId  String?
  eventId    String?
  metadata   Json?
  occurredAt DateTime                     @default(now())

  @@index([ruleId, occurredAt])
  @@index([ticketId, occurredAt])
}

/// Append-only ticket history. Application code only inserts rows.
model SupportTicketEvent {
  id                String                 @id @default(cuid())
  ticketId          String
  ticket            SupportTicket          @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  type              SupportTicketEventType
  actorStaffId      String?
  actorStaff        PlatformStaff?         @relation(fields: [actorStaffId], references: [id], onDelete: Restrict)
  causedByMessageId String?
  causedByMessage   SupportTicketMessage?  @relation(fields: [causedByMessageId], references: [id], onDelete: Restrict)
  fromValue         String?
  toValue           String?
  metadata          Json?
  createdAt         DateTime               @default(now())

  @@index([ticketId, createdAt])
}

/// Sparse waiver for one expected Record slot. Not a placeholder for every slot.
model OperationalRecordWaiver {
  id                   String    @id @default(cuid())
  facilityId           String
  departmentId         String
  /// buildLogRequirementKey for the expected slot.
  requirementKey       String
  operationalDate      DateTime  @db.Date
  logAttachmentId      String?
  reason               String
  recordedByUserId     String?
  recordedByEmployeeId String?
  recordedByLabel      String?
  recordedAt           DateTime  @default(now())

  @@unique([facilityId, requirementKey])
  @@index([facilityId, departmentId, operationalDate])
}

/// Forward place-name history. Dates before the first row are not claimed as known.
model PlaceNameChange {
  id               String   @id @default(cuid())
  facilityId       String
  /// SPACE or UNIT.
  placeKind        String
  unitSpaceId      String?
  unitId           String?
  previousLabel    String
  newLabel         String
  effectiveFrom    DateTime @db.Date
  recordedAt       DateTime @default(now())
  recordedByUserId String?

  @@index([facilityId, unitSpaceId, effectiveFrom])
  @@index([facilityId, unitId, effectiveFrom])
}

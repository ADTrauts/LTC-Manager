model Unit {
  id                         String                               @id @default(cuid())
  facilityId                 String
  facility                   Facility                             @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  name                       String
  unitType                   UnitType
  /// Explicit Facility Builder role. Null for legacy records (compatibility fallback applies).
  hierarchyRole              UnitHierarchyRole?
  parentUnitId               String?
  parentUnit                 Unit?                                @relation("UnitHierarchy", fields: [parentUnitId], references: [id], onDelete: SetNull)
  childUnits                 Unit[]                               @relation("UnitHierarchy")
  isActive                   Boolean                              @default(true)
  displayOrder               Int                                  @default(100)
  description                String?
  primaryForEmployees        Employee[]                           @relation("EmployeePrimaryUnit")
  employeeUnitAccess         EmployeeUnitAccess[]
  mealTimes                  UnitMealTime[]
  childSpaces                UnitSpace[]
  departmentResponsibilities UnitDepartmentResponsibility[]
  logAssignments             LogAssignment[]
  logSubmissions             LogSubmission[]
  defaultAssignments         DefaultAssignment[]
  scheduleEntries            ScheduleEntry[]
  overrideOldUnit            AssignmentOverride[]                 @relation("OverrideOldUnit")
  overrideNewUnit            AssignmentOverride[]                 @relation("OverrideNewUnit")
  assets                     Asset[]
  repairs                    Repair[]
  roomAreaStatuses           RoomAreaStatus[]
  serveryMealServiceEvents   ServeryMealServiceEvent[]
  kioskUnitPinLoginEvents    KioskUnitPinLoginEvent[]
  tasks                      Task[]
  inspectionDefinitions      InspectionDefinition[]
  inspectionSubmissions      InspectionSubmission[]
  inspectionOccurrences      InspectionOccurrence[]
  knowledgeArticleUnits      KnowledgeArticleUnit[]
  operationalAssignments     OperationalAssignment[]
  assignmentTemplateItems    OperationalAssignmentTemplateItem[]
  operationalCycleLocations       DepartmentOperationalCycleLocation[]
  operationalCycleMilestoneTimes  DepartmentOperationalCycleMilestoneTime[]
  cycleDayExpectations            OperationalCycleDayExpectation[]
  operationalEvidenceRecords      OperationalEvidenceRecord[]
  logAttachments                  LogAttachment[]
  assetIssues                AssetIssue[]
  operationalRequests        OperationalRequest[]
  departmentWorkOccurrences  DepartmentWorkOccurrence[]
  createdAt                  DateTime                             @default(now())
  updatedAt                  DateTime                             @updatedAt

  /// Sibling-scoped uniqueness is enforced by partial unique indexes in
  /// prisma/migrations/20260916120000_optional_facility_buildings:
  /// Unit_facility_root_name_key (parentUnitId IS NULL)
  /// Unit_facility_parent_name_key (parentUnitId IS NOT NULL)
  @@index([parentUnitId])
  @@index([isActive, displayOrder])
  @@index([facilityId])
  @@index([hierarchyRole])
}

/// Which department(s) are responsible for a unit (primary/backup/support).
/// `capabilities` describes what the department does here (empty = legacy full access).
model UnitDepartmentResponsibility {
  id                  String             @id @default(cuid())
  unitId              String
  unit                Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  departmentId        String
  department          Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  kind                UnitDepartmentKind @default(PRIMARY)
  capabilities        String[]           @default([])
  riskLevel           String?
  cleaningFrequency   String?
  inspectionFrequency String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([unitId, departmentId])
  @@index([unitId])
  @@index([departmentId])
}

/// Facility-owned reusable Room Type (local vocabulary).
/// Base type is a system catalog key (e.g. kitchen); displayName is facility-visible.
/// Rooms and Build config reference this row by id — rename is identity-safe.
model FacilityRoomType {
  id           String      @id @default(cuid())
  facilityId   String
  facility     Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  /// Generic system base type key from the Facility Base Type catalog.
  baseTypeKey  String
  displayName  String
  description  String?
  displayOrder Int         @default(100)
  isActive     Boolean     @default(true)
  archivedAt              DateTime?
  spaces                  UnitSpace[]
  departmentLogDefaults   DepartmentFacilityTypeLogDefault[]
  createdAt               DateTime                           @default(now())
  updatedAt               DateTime                           @updatedAt

  @@unique([facilityId, displayName])
  @@index([facilityId, isActive, displayOrder])
  @@index([facilityId, baseTypeKey])
}

/// Physical sub-location within a Unit (room, service area, storage, etc.).
/// unitId null = Facility Builder undesignated staging (not operational).
model UnitSpace {
  id                                 String                              @id @default(cuid())
  unitId                             String?
  unit                               Unit?                               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  facilityId                         String
  facility                           Facility                            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name                               String
  spaceType                          SpaceType
  /// User-facing type label when it differs from the canonical SpaceType label (presets / Custom).
  /// Compatibility debt — FacilityRoomType is the Build-facing canonical source.
  customTypeLabel                    String?
  /// Canonical Facility Room Type. Nullable until backfill / for undesignated staging.
  facilityRoomTypeId                 String?
  facilityRoomType                   FacilityRoomType?                   @relation(fields: [facilityRoomTypeId], references: [id], onDelete: Restrict)
  /// Optional containing room (e.g. bathroom inside a resident room). Same unitId as parent.
  parentSpaceId                      String?
  parentSpace                        UnitSpace?                          @relation("SpaceHierarchy", fields: [parentSpaceId], references: [id], onDelete: SetNull)
  childSpaces                        UnitSpace[]                         @relation("SpaceHierarchy")
  roomNumber                         String?
  code                               String?
  isActive                           Boolean                             @default(true)
  sortOrder                          Int                                 @default(100)
  description                        String?
  responsibilities                   UnitSpaceResponsibility[]
  archetypeBindings                  DepartmentRoomArchetypeBinding[]
  experienceExceptions               DepartmentRoomExperienceException[]
  operationalTemplateApplicabilities OperationalTemplateApplicability[]
  operationalEvidenceRecords         OperationalEvidenceRecord[]
  logAttachments                     LogAttachment[]
  assets                             Asset[]
  assetIssues                        AssetIssue[]
  operationalRequests                OperationalRequest[]
  repairs                            Repair[]
  departmentWorkOccurrences          DepartmentWorkOccurrence[]
  zoneMemberships                    DepartmentOperationalZoneLocation[]
  teamMemberships                    DepartmentTeamRoomMembership[]
  logSuppressions                    DepartmentLocationLogSuppression[]
  assignmentLocations                OperationalAssignmentLocation[]
  operationalCycleLocations          DepartmentOperationalCycleLocation[]
  keyTimeGroupRooms                  DepartmentOperationalCycleKeyTimeGroupRoom[]
  keyTimeDayExpectations             OperationalCycleKeyTimeDayExpectation[]
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt

  @@index([facilityId])
  @@index([unitId, isActive, sortOrder])
  @@index([facilityRoomTypeId])
  @@index([parentSpaceId])
}

/// Lifecycle for an enduring Department Team (organizational subgroup).
/// Teams persist immediately as Build configuration — not Draft/Publish versioned.
enum DepartmentTeamStatus {
  ACTIVE
  ARCHIVED
}

/// Optional enduring organizational subgroup inside one Department.
/// Facility-named. Not a permission, Job Role, Zone, Cycle, or daily assignment.
model DepartmentTeam {
  id                String                        @id @default(cuid())
  facilityId        String
  facility          Facility                      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department                    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  displayName       String
  description       String?
  displayOrder      Int                           @default(100)
  status            DepartmentTeamStatus          @default(ACTIVE)
  archivedAt        DateTime?
  /// Explicit accountable manager. Does not grant RoleKey authority.
  managerEmployeeId String?
  managerEmployee   Employee?                     @relation("DepartmentTeamManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  /// Stable DepartmentRoomArchetype.key values. Not display names. Department-scoped via departmentId.
  applicableOperationalTypeKeys String[]          @default([])
  roomMemberships   DepartmentTeamRoomMembership[]
  employeeMemberships EmployeeTeamMembership[]
  cycleNeeds        DepartmentTeamCycle[]
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([facilityId, departmentId, status, displayOrder])
  @@index([departmentId, status])
  @@index([managerEmployeeId])
}

enum DepartmentTeamCycleNeedGrain {
  TOTAL
  PER_ROOM
}

/// Team × department cycle. The cycle is department-owned (Breakfast is one Dietary cycle).
/// Need is this team's staffing for that cycle — not a Coverage document.
model DepartmentTeamCycle {
  id             String                       @id @default(cuid())
  teamId         String
  team           DepartmentTeam               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  facilityId     String
  facility       Facility                     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department                   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  /// DepartmentOperationalCycle.stableKey — identity across draft/published versions.
  cycleStableKey String
  /// Null = no staffing need (valid for Plant).
  requiredCount  Int?
  grain          DepartmentTeamCycleNeedGrain @default(TOTAL)
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  @@unique([teamId, cycleStableKey])
  @@index([departmentId, cycleStableKey])
  @@index([facilityId, departmentId])
}

/// Department-scoped log default on a Facility Room Type (Dietary Servery, not Role).
/// Rooms of that type inherit the log; one room can suppress it.
model DepartmentFacilityTypeLogDefault {
  id                  String              @id @default(cuid())
  facilityId          String
  facility            Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId        String
  department          Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  facilityRoomTypeId  String
  facilityRoomType    FacilityRoomType    @relation(fields: [facilityRoomTypeId], references: [id], onDelete: Cascade)
  catalogDefinitionId String
  catalogDefinition   CatalogLogDefinition @relation(fields: [catalogDefinitionId], references: [id], onDelete: Restrict)
  catalogStableKey    String
  catalogVersion      Int
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  suppressions        DepartmentLocationLogSuppression[]

  @@unique([departmentId, facilityRoomTypeId, catalogStableKey])
  @@index([facilityId, departmentId])
  @@index([facilityRoomTypeId])
}

/// One room opts out of a Facility type log default. Does not delete the type default.
model DepartmentLocationLogSuppression {
  id           String                           @id @default(cuid())
  departmentId String
  spaceId      String
  space        UnitSpace                        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  defaultId    String
  default      DepartmentFacilityTypeLogDefault @relation(fields: [defaultId], references: [id], onDelete: Cascade)
  createdAt    DateTime                         @default(now())

  @@unique([spaceId, defaultId])
  @@index([departmentId])
}

/// Team explicit normal operating Rooms. Identity is UnitSpace.id — never Room Type / Floor / Neighborhood.
/// Overlapping membership across Teams in the same Department is allowed.
/// Operational Type applicability is stored on DepartmentTeam.applicableOperationalTypeKeys
/// and is not copied onto these rows.
model DepartmentTeamRoomMembership {
  id        String         @id @default(cuid())
  teamId    String
  team      DepartmentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  spaceId   String
  space     UnitSpace      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([teamId, spaceId])
  @@index([spaceId])
}

/// Employee organizational home on a Department Team.
/// Not authority, Job Title, WorkStation, Unit access, or daily assignment.
/// At most one Primary Team per Department is enforced in the write transaction.
model EmployeeTeamMembership {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  teamId     String
  team       DepartmentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isPrimary  Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([employeeId, teamId])
  @@index([employeeId])
  @@index([teamId])
}

/// Generic operational responsibility tier for Department-owned Job Roles.
/// Stable platform semantics — not user-facing labels (Departments rename via displayName).
/// Not RoleKey / platform authority. Facility Administrator is not a Department Job Role tier.
enum DepartmentJobRoleTier {
  TEAM_MEMBER
  LEAD
  SUPERVISOR
  MANAGER
}

enum DepartmentJobRoleStatus {
  ACTIVE
  ARCHIVED
}

/// Department-owned operational Job Role (capability package + relative tier).
/// Distinct from JobTitle (what job you perform) and RoleKey (platform authority).
/// Capabilities are validated against the product catalog; not route permissions.
model DepartmentJobRole {
  id           String                   @id @default(cuid())
  facilityId   String
  facility     Facility                 @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department               @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  displayName  String
  tier         DepartmentJobRoleTier
  description  String?
  displayOrder Int                      @default(100)
  status       DepartmentJobRoleStatus  @default(ACTIVE)
  archivedAt   DateTime?
  /// Explicit operational capability keys (see lib/department-job-roles/capabilities).
  capabilities String[]                 @default([])
  assignments  EmployeeDepartmentJobRole[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([facilityId, departmentId, status, displayOrder])
  @@index([departmentId, status])
}

/// One active Job Role assignment per Employee per Department (V1).
/// Requires Department membership. Removing membership reconciles this row.
model EmployeeDepartmentJobRole {
  id           String            @id @default(cuid())
  employeeId   String
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  jobRoleId    String
  jobRole      DepartmentJobRole @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([employeeId, departmentId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([jobRoleId])
}

/// Department responsibility assigned directly at the room/space level.
/// Rooms do not inherit department responsibility from floors or neighborhoods.
model UnitSpaceResponsibility {
  id           String     @id @default(cuid())
  spaceId      String
  space        UnitSpace  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  capabilities String[]   @default([])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([spaceId, departmentId])
  @@index([spaceId])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Department Operational Profiles (Wave 14B)
// Department Administration owns the operational model. The database stores a
// facility's selected/versioned profile — never the platform Experience catalog
// (that lives in src/lib/experiences). Projection consumes ACTIVE profiles later.
// ---------------------------------------------------------------------------

/// Lifecycle for a Department Operational Profile version.
/// DRAFT → CERTIFIED → ACTIVE → RETIRED. ACTIVE/CERTIFIED are immutable.
enum OperationalProfileStatus {
  DRAFT
  CERTIFIED
  ACTIVE
  RETIRED
}

/// Sparse per-room Experience override mode.
enum RoomExperienceExceptionMode {
  ENABLE
  DISABLE
  OVERRIDE
}

/// One authored/versioned operational profile for one facility department.
/// At most one ACTIVE per (facilityId, departmentId) — enforced by a partial
/// unique index in the migration SQL.
model DepartmentOperationalProfile {
  id                String                              @id @default(cuid())
  facilityId        String
  facility          Facility                            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department                          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name              String
  version           Int
  status            OperationalProfileStatus            @default(DRAFT)
  /// Baseline the draft was materialized from (e.g. DIETARY); null for from-scratch drafts.
  baselineKey       String?
  /// Actor IDs recorded as scalars (audit only; no FK so User remains untouched).
  createdByUserId   String?
  certifiedByUserId String?
  certifiedAt       DateTime?
  activatedAt       DateTime?
  retiredAt         DateTime?
  areas             DepartmentOperationalArea[]
  archetypes        DepartmentRoomArchetype[]
  roomBindings      DepartmentRoomArchetypeBinding[]
  roomExceptions    DepartmentRoomExperienceException[]
  createdAt         DateTime                            @default(now())
  updatedAt         DateTime                            @updatedAt

  @@unique([departmentId, version])
  @@index([facilityId, departmentId, status])
  @@index([departmentId, status])
}

/// Profile-specific ordered grouping of Experiences (the manager's mental model).
model DepartmentOperationalArea {
  id          String                       @id @default(cuid())
  profileId   String
  profile     DepartmentOperationalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  sortOrder   Int                          @default(100)
  isActive    Boolean                      @default(true)
  experiences DepartmentAreaExperience[]
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@unique([profileId, key])
  @@index([profileId, sortOrder])
}

/// Places one catalog Experience (by registry key) into one Operational Area.
/// experienceKey must exist in the Wave 14A Experience Registry.
model DepartmentAreaExperience {
  id                   String                              @id @default(cuid())
  areaId               String
  area                 DepartmentOperationalArea           @relation(fields: [areaId], references: [id], onDelete: Cascade)
  experienceKey        String
  sortOrder            Int                                 @default(100)
  isActive             Boolean                             @default(true)
  /// Bounded Experience tuning only — never live operational data.
  configurationJson    Json?
  archetypeExperiences DepartmentArchetypeExperience[]
  roomExceptions       DepartmentRoomExperienceException[]
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt

  @@unique([areaId, experienceKey])
  @@index([areaId, sortOrder])
}

/// How the department operates in a category of room (operational template).
model DepartmentRoomArchetype {
  id          String                           @id @default(cuid())
  profileId   String
  profile     DepartmentOperationalProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  isActive    Boolean                          @default(true)
  sortOrder   Int                              @default(100)
  experiences DepartmentArchetypeExperience[]
  bindings    DepartmentRoomArchetypeBinding[]
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt

  @@unique([profileId, key])
  @@index([profileId, sortOrder])
}

/// Declares which profile Experiences are active for an archetype.
model DepartmentArchetypeExperience {
  id                String                   @id @default(cuid())
  archetypeId       String
  archetype         DepartmentRoomArchetype  @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  areaExperienceId  String
  areaExperience    DepartmentAreaExperience @relation(fields: [areaExperienceId], references: [id], onDelete: Cascade)
  isActive          Boolean                  @default(true)
  configurationJson Json?

  operationalEvidenceRecords     OperationalEvidenceRecord[]     @relation("EvidenceRecordedByEmployee")
  operationalEvidenceCorrections OperationalEvidenceCorrection[] @relation("EvidenceCorrectedByEmployee")
  assignedRepairs                Repair[]                        @relation("RepairAssignedEmployee")
  defaultPmPlanVersions          PreventiveMaintenancePlanVersion[] @relation("PmPlanVersionDefaultAssignee")
  repairLaborEntries             RepairLaborEntry[]
  roomAreaStatusUpdates          RoomAreaStatus[]
  assignedTasks                  Task[]                          @relation("TaskAssignedEmployee")
  attachmentsCreated             Attachment[]                    @relation("AttachmentCreatedByEmployee")
  inspectionSubmissions          InspectionSubmission[]          @relation("InspectionSubmittedByEmployee")
  assetIssuesReported            AssetIssue[]                    @relation("AssetIssueReportedByEmployee")
  assetIssueUpdates              AssetIssueUpdate[]              @relation("AssetIssueUpdateByEmployee")
  operationalRequestsReported    OperationalRequest[]            @relation("OperationalRequestReportedByEmployee")
  operationalRequestUpdates      OperationalRequestUpdate[]     @relation("OperationalRequestUpdateByEmployee")
  workOccurrencesCompleted       DepartmentWorkOccurrence[]      @relation("WorkOccurrenceCompletedByEmployee")
  workOccurrencesAssigned        DepartmentWorkOccurrence[]      @relation("WorkOccurrenceAssignedEmployee")
  workOccurrencesOriginalAssigned DepartmentWorkOccurrence[]     @relation("WorkOccurrenceOriginalAssignedEmployee")
  workEventsAsActor              DepartmentWorkEvent[]           @relation("WorkEventActorEmployee")
  cycleDayExpectationAdjustments OperationalCycleDayExpectation[] @relation("CycleDayExpectationAdjustedByEmployee")
  keyTimeDayExpectationAdjustments OperationalCycleKeyTimeDayExpectation[] @relation("KeyTimeDayExpectationAdjustedByEmployee")

/// RUN: Canonical Shift / employee presence record.
///
/// Canonical fields (Shift semantics):
///   employeeId, date, plannedStart, plannedEnd, departmentId, workShiftId
///
/// Demoted / compatibility fields:
///   unitId     - legacy placement; optional on new canonical Shifts
///   shift      - meal-slot label (BREAKFAST/LUNCH/DINNER/FULL_DAY); compatibility only
///   roleType   - platform authority leakage; demoted; nullable on new canonical Shifts
///
/// See: src/lib/scheduling/SCHEDULING_ARCHITECTURE_CONTRACT.md
model ScheduleEntry {
  id           String               @id @default(cuid())
  employeeId   String
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date         DateTime
  shift        ShiftType
  /// Nullable on new canonical Shifts. Platform RoleKey is not Shift identity.
  roleType     RoleKey?
  /// Nullable on new canonical Shifts. Unit placement is legacy assignment fact.
  unitId       String?
  unit         Unit?                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// Explicit Department ownership — canonical Shift fact (added migration 81).
  /// NULL on legacy rows created before this migration.
  departmentId String?
  department   Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workShiftId  String?
  workShift    WorkShift?           @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  plannedStart String?
  plannedEnd   String?
  createdById  String?
  createdBy    User?                @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  overrides    AssignmentOverride[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([date, unitId])
  @@index([employeeId, date])
  @@index([workShiftId])
  @@index([departmentId, date])
}


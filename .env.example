# App + Prisma (use Supabase "Transaction" pooler URL on Vercel: port 6543, add ?pgbouncer=true)
DATABASE_URL="postgresql://ltc_admin:ltc_password@127.0.0.1:5432/ltc_manager?schema=public"
# Migrations / introspection: direct DB (local: same as DATABASE_URL; Supabase: "Direct connection" in project settings)
DIRECT_URL="postgresql://ltc_admin:ltc_password@127.0.0.1:5432/ltc_manager?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
# Harbor Console owner bootstrap (unlisted /console/login). Never commit the password.
# HARBOR_OWNER_EMAIL=andrew.trautman@vssyl.com
# HARBOR_OWNER_BOOTSTRAP_PASSWORD=""
# HARBOR_OWNER_DISPLAY_NAME="Andrew Trautman"
# Production defaults to disabled unless abuse controls and email verification are approved.
PUBLIC_SIGNUP_ENABLED=false
# Department capabilities (cycles, job flow, evidence, work plans, assets, assignments)
# come with the installed Department. There is no deployment switch for them.
# Canonical Logs (CatalogLogDefinition → FacilityCatalogInstall → LogAttachment
# → derived requirement → OperationalEvidenceRecord).
# The code default stays off so an unset production environment keeps the previous engine.
# Shared test environments turn it on (LEG-01). LEG-03 removes the switch.
# ON: a Department with no rollout row uses the forward engine. Plant stays on the previous engine until LEG-02.
CANONICAL_LOGS_ENABLED=true
# Billing entitlements (ADL-013). Default off — stores licenses without gating Dietary/EVS/Plant.
BILLING_ENTITLEMENTS_ENABLED=false
# Contracted Department Authority (CDA-D12). Code default off. The production project sets this true.
CONTRACTED_DEPARTMENT_AUTHORITY_ENABLED=false
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Outbound email (Postmark). Empty token = outbound email off.
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_EMAIL="noreply@vssyl.com"
# POSTMARK_MESSAGE_STREAM=outbound

# Support email (Vssyl Console tickets). See docs/architecture/SUPPORT_TICKETS.md.
# Sender for support replies; empty = POSTMARK_FROM_EMAIL. Must be a Postmark-verified sender.
SUPPORT_FROM_EMAIL=""
# Base address on the Postmark inbound domain, e.g. support@<inbound subdomain>. Replies go out with
# Reply-To support+<ticket token>@<inbound subdomain>. Empty = no Reply-To (customer replies won't route).
SUPPORT_REPLY_ADDRESS=""
# HTTP Basic Auth that Postmark must send to /api/support/inbound-email. Both empty = webhook returns 503.
POSTMARK_INBOUND_WEBHOOK_USERNAME=""
POSTMARK_INBOUND_WEBHOOK_PASSWORD=""
# HTTP Basic Auth for outbound Delivery / Bounce / Spam Complaint at /api/support/email-events.
# Separate from inbound. Both empty = webhook returns 503.
POSTMARK_OUTBOUND_WEBHOOK_USERNAME=""
POSTMARK_OUTBOUND_WEBHOOK_PASSWORD=""

# Stripe Price IDs for the commercial catalog (test-mode IDs belong in local .env, not here).
# Lookup keys on the LTC Manager sandbox: ltc_facility_monthly, ltc_facility_annual,
# ltc_additional_dept_monthly, ltc_additional_dept_annual, ltc_whole_facility_monthly,
# ltc_whole_facility_annual, ltc_setup_first, ltc_setup_additional.
STRIPE_PRICE_FACILITY_MONTHLY=""
STRIPE_PRICE_FACILITY_ANNUAL=""
STRIPE_PRICE_ADDITIONAL_DEPT_MONTHLY=""
STRIPE_PRICE_ADDITIONAL_DEPT_ANNUAL=""
STRIPE_PRICE_WHOLE_FACILITY_MONTHLY=""
STRIPE_PRICE_WHOLE_FACILITY_ANNUAL=""
STRIPE_PRICE_SETUP_FIRST_DEPT=""
STRIPE_PRICE_SETUP_ADDITIONAL_DEPT=""
# Wave 10 Operational AI — Morning Brief. Default off.
AI_BRIEF_ENABLED=false
# AI_PROVIDER=mock
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_REQUEST_TIMEOUT_MS=8000
# AI_DAILY_REQUEST_LIMIT=24
# AI_MIN_REFRESH_INTERVAL_MS=300000
# Wave 10 Shift Transition Summary. Default off.
AI_SHIFT_SUMMARY_ENABLED=false
# AI_SHIFT_LOOKBACK_MS=21600000

# Wave 10 Recovery Assistant. Default off.
AI_RECOVERY_ASSISTANT_ENABLED=false

# Pilot bootstrap (operator-only; never commit real values):
# BOOTSTRAP_DATABASE_URL=
# FACILITY_DISPLAY_NAME=
# FA_EMAIL=
# FA_PASSWORD=
# FA_DISPLAY_NAME=
# BOOTSTRAP_MARK_ONBOARDING_COMPLETE=1

# Pilot environment acceptance:
# PILOT_BASE_URL=https://pilot.example.com
# PILOT_EXPECT_DEPLOYED_SHA=

# Private object storage for support tickets and Operational Evidence media.
# Production and Preview: Vercel Blob via BLOB_READ_WRITE_TOKEN, or VERCEL_OIDC_TOKEN on Vercel.
# Do not commit a token. Local disk is not the production store.
# Set EVIDENCE_MEDIA_DEV_STORE=filesystem only for explicit local development without Blob.
# BLOB_READ_WRITE_TOKEN=
# EVIDENCE_MEDIA_DEV_STORE=
# Private support ClamAV worker (ONB-05). Production host/TLS/token/schedule need separate authorization.
# No customer-controlled target; exact host:port must be explicitly allowlisted. HTTPS only.
SUPPORT_SCANNER_URL=
SUPPORT_SCANNER_ALLOWED_HOSTS=
SUPPORT_SCANNER_BEARER_TOKEN=
# Optional private CA PEM. TLS verification is always enabled; never set NODE_TLS_REJECT_UNAUTHORIZED=0.
SUPPORT_SCANNER_CA_PEM=

# Canonical Space offline recovery: dedicated server-only AES-256 keyring.
# JSON key IDs -> base64 32-byte keys; <=4. No production fallback.
# Retain prior key IDs while any pending encrypted intent needs recovery.
# OFFLINE_RECOVERY_KEYS={"2026-10":"<base64-32-bytes>"}
# OFFLINE_RECOVERY_ACTIVE_KEY=2026-10

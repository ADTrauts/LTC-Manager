# App + Prisma (use Supabase "Transaction" pooler URL on Vercel: port 6543, add ?pgbouncer=true)
DATABASE_URL="postgresql://ltc_admin:ltc_password@127.0.0.1:5432/ltc_manager?schema=public"
# Migrations / introspection: direct DB (local: same as DATABASE_URL; Supabase: "Direct connection" in project settings)
DIRECT_URL="postgresql://ltc_admin:ltc_password@127.0.0.1:5432/ltc_manager?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
# Harbor Console owner bootstrap (unlisted /console/login). Never commit the password.
# HARBOR_OWNER_EMAIL=andrew.trautman@vssyl.com
# HARBOR_OWNER_BOOTSTRAP_PASSWORD=""
# HARBOR_OWNER_DISPLAY_NAME="Andrew Trautman"
# Production defaults to disabled unless abuse controls and email verification are approved.
PUBLIC_SIGNUP_ENABLED=false
# Dietary V1 controlled pilot — Assignments on; Operations Engine remains off.
OPERATIONAL_ASSIGNMENTS_ENABLED=false
OPERATION_ENGINE_ENABLED=false
# Phase 9A Dietary Operational Cycles (Department Builder + runtime day context). Default off.
# Does not activate OPERATION_ENGINE_ENABLED — leave Operations Engine off.
DIETARY_OPERATIONAL_CYCLES_ENABLED=false
# Phase 9B Dietary Employee Job Flow & Supervisor Operations Board. Default off.
DIETARY_JOB_FLOW_ENABLED=false
# Phase 9C Dietary Operational Evidence (unified Templates, Job Flow requirements, Log Book). Default off.
# Typical local activation:
#   DIETARY_OPERATIONAL_CYCLES_ENABLED=true
#   DIETARY_JOB_FLOW_ENABLED=true
#   DIETARY_OPERATIONAL_EVIDENCE_ENABLED=true
#   OPERATION_ENGINE_ENABLED=false
DIETARY_OPERATIONAL_EVIDENCE_ENABLED=false
# Phase 10A Dietary Asset Operations (Assets / Issues / Work Orders). Default off.
# Typical local activation:
#   DIETARY_OPERATIONAL_CYCLES_ENABLED=true
#   DIETARY_JOB_FLOW_ENABLED=true
#   DIETARY_OPERATIONAL_EVIDENCE_ENABLED=true
#   DIETARY_ASSET_OPERATIONS_ENABLED=true
#   OPERATION_ENGINE_ENABLED=false
# Does not activate OPERATION_ENGINE_ENABLED — leave Operations Engine off.
DIETARY_ASSET_OPERATIONS_ENABLED=false
# Phase 11A Dietary Department Work Plans. Default off.
# Typical local activation:
#   DIETARY_OPERATIONAL_CYCLES_ENABLED=true
#   DIETARY_JOB_FLOW_ENABLED=true
#   DIETARY_OPERATIONAL_EVIDENCE_ENABLED=true
#   DIETARY_ASSET_OPERATIONS_ENABLED=true
#   DIETARY_WORK_PLANS_ENABLED=true
#   OPERATION_ENGINE_ENABLED=false
#   TASK_SYNC_ENABLED=false
# Does not activate OPERATION_ENGINE_ENABLED or TASK_SYNC_ENABLED.
DIETARY_WORK_PLANS_ENABLED=false
# Phase 11B EVS Operations (Cycles / Job Flow / Evidence / Work / thin Assets). Default off.
# Typical local activation:
#   EVS_OPERATIONS_ENABLED=true
#   OPERATION_ENGINE_ENABLED=false
#   TASK_SYNC_ENABLED=false
# Does not activate OPERATION_ENGINE_ENABLED or TASK_SYNC_ENABLED.
# Dietary remains gated by DIETARY_* flags independently.
EVS_OPERATIONS_ENABLED=false
# Canonical Logs (BUILD Catalog/Attachments + RUN staffing/logs). Default off.
# Enable only in local/dev or a named test facility. Do not default-on.
# Enable for local Phase 4 Catalog / Attachment / RUN work.
CANONICAL_LOGS_ENABLED=false
# Billing entitlements (ADL-013). Default off — stores licenses without gating Dietary/EVS/Plant.
BILLING_ENTITLEMENTS_ENABLED=false
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Stripe Price IDs for the commercial catalog (test-mode IDs belong in local .env, not here).
# Lookup keys on the LTC Manager sandbox: ltc_facility_monthly, ltc_facility_annual,
# ltc_additional_dept_monthly, ltc_additional_dept_annual, ltc_whole_facility_monthly,
# ltc_whole_facility_annual, ltc_setup_first, ltc_setup_additional.
STRIPE_PRICE_FACILITY_MONTHLY=""
STRIPE_PRICE_FACILITY_ANNUAL=""
STRIPE_PRICE_ADDITIONAL_DEPT_MONTHLY=""
STRIPE_PRICE_ADDITIONAL_DEPT_ANNUAL=""
STRIPE_PRICE_WHOLE_FACILITY_MONTHLY=""
STRIPE_PRICE_WHOLE_FACILITY_ANNUAL=""
STRIPE_PRICE_SETUP_FIRST_DEPT=""
STRIPE_PRICE_SETUP_ADDITIONAL_DEPT=""
# Wave 7a Work Engine — dual-write LogSubmission/Repair → Task. Default off.
TASK_SYNC_ENABLED=false
# Wave 10 Operational AI — Morning Brief. Default off.
AI_BRIEF_ENABLED=false
# AI_PROVIDER=mock
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_REQUEST_TIMEOUT_MS=8000
# AI_DAILY_REQUEST_LIMIT=24
# AI_MIN_REFRESH_INTERVAL_MS=300000
# Wave 10 Shift Transition Summary. Default off.
AI_SHIFT_SUMMARY_ENABLED=false
# AI_SHIFT_LOOKBACK_MS=21600000

# Wave 10 Recovery Assistant. Default off.
AI_RECOVERY_ASSISTANT_ENABLED=false

# Pilot bootstrap (operator-only; never commit real values):
# BOOTSTRAP_DATABASE_URL=
# FACILITY_DISPLAY_NAME=
# FA_EMAIL=
# FA_PASSWORD=
# FA_DISPLAY_NAME=
# BOOTSTRAP_MARK_ONBOARDING_COMPLETE=1

# Pilot environment acceptance:
# PILOT_BASE_URL=https://pilot.example.com
# PILOT_EXPECT_DEPLOYED_SHA=